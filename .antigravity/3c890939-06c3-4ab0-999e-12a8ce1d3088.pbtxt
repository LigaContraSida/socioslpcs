      thinking_signature: "\022\310\v\n\305\v\001i\024}\023\2166n\005O\260\335~\304W\353\355\254\236Fy\026\365s\r\225&\230=6\352\305v\223Y\3315\371`\327\365\225?I\027\252\234\246\n\264-\376\307\220\223\021\307\203\335\275Ly5f\351\205\240\372U\274\367\2544\354\371\371\321o7\034G\021\017O\335\232\302\354\344\332\317FnN\001\'\017\247\212\200\v\fWQ\313\037I\350\300;\272\315\253h3\266\200F6\0273\353\036$U\211\213N \t\021^\377\324R\374\242d\313\374\376\342\224\217H7\233\234\327:\271\326AJ\266\020\361\023s\204G\231\362G7N\177\351.A\372<\370\234\252\364\224]$\363\340\026\354w\310\033D\23034\375K\254\327\031u\021:\261\235}\207\322\234#>`(\033H4\202J\310\250\211\262F\211\243\n\333\t6\377\377f\024S\252\303Gd\255\215\212\340R\300\336\364\031\320\234\254\026\226\000L\370\024\210\261\024\030\337\200\330\246d\234\306\271\342~OI\274\373>\230t\311\021C\255\334\301\342\0278\321\235\252k\360q\366u\274y:B\r\330\215\371\270\003\205T\026mF\264\352wK\023\220u\2666\377M\226\272K\375\204N\306\302\333b\213Y\342\306\237\324\025\307:\372\332=\274\250\b\342\222O\250\225O\356\317\201/A\271\341\241iF\372:\244{\303\277a\364\373ob\2127\004\002\374\314\242\276\226=\203\214\035?\345Q`\276\251\326\264\321s\021\233Z\233\357*\317<\207\334l\030x3QdA\263|\222\377\255B\377\254;(+\350\">\000Mk~=\314\245\257\322t\341\272\374 \322\227\023\243\253\'\225\r\313\027\266F\313\376\322\241]\252)\265H,7\222x\275\235\315\035\222_\345g\3461\234\356l\\\246\301\201\f\263I\346\232\2349\302\266o\343\263\331\034\030S\210\231\217dC\351\305sok\v\265hh\274\027\264\267\250\243\232\325\225\005\002\002\235\227i\277\030\r\310\211\203HLQc\277\017\250\326\016*\376\311 \341\b)YqEV\254<;\362q\221\n\022\323@\2350\263\3318\232?:\250#\202\262(M\355\303Ul\aT\242\275\036\255\245\314\254\243\345\306\323C\234\346U\2020;\005\255\210]\334<\'\226\223\302`veqP\325\264Fl#l\251Z\333\332.\2119\265uc\215\006\227\241#U\221.\v\374\034\325\312\257\033+0\000\303e\244\305\200{g\2259H\325\2344\201\005\224%z\377\022\363\246+L\370\334Yyg\305z\255\225\231ca:P\212\340\303\346!\327x\005\214\216\241\211K\354\004\354\371Q\246\250\363\001\030\245\223i\322\346\bq\350Q\223\235\211\2332\023T.N2\202\301\255\035\206\325\f\"W\224;\356&\301\022\001\236\364\312\257\331D\216\v\251\304;\030<\376\377\220-\367\315\352\372H\206\320\335\037\262\377.\335\265\2629\364\027\037>\377{\004\002M1\274\031F{\002=x\242\301\310\200\032b`o\346@\257;\310sk\200$\367\303\005h\017Ech\325\274\217t4\276N\212W\316\3370c7\265b\335\001vZ\201\272\264\365\275\350\235f\326\231\247x\362\356\350J\0160fwW\006\222\212/\337\276\004\033\033\262\202UL\207P\323TK\022\205\315c|\215I\220&\232E[\373\311_\224\377Z\365\252\345\221\224\357O\'\346^\251\375\203\210k@g\226\263\341;\202\212\326\230W{fo>\256?\\\225\271\250\036Du\312q\303\220\303\356\313\277\005\233E/t\n\346\217Y_5\r\347\"4\211k\372\364\371\260Q\224DR\263\237\304\200\273\212\234\203\274\370e5\3163.\254\217\363Gq:\365\022_\000\001g\332\220x\235j}\237\356\240\373w}\024\"jW1\201M\352E_C\256\246w\221<\374\260\260@I(\221E\236\274<\360\244\377\3167\350\273W\257\242\023\320\b\374\237\333EYc\244\257}Xa\324e!\ty:\"p\345t\025 \340\206\020\357\226\265b!\036H\257i\331\301\035l\236\023\324\274\227\202.\336\326iZ}\3200&\201\021z\341\307\177\215],\214\233]X\230\322\241?vb\212\251)\352\211\n\276\360\034\017\246\223\346T\016\255\bm\035\202=\017W\177\\ \aS\017e\367!7\316u\346!\021\177\340\277\201\224\310z(\366\213\342L\330u\223$\223/\231\237.\203\375P\340\005O:\337q\213\205r\322\246F!8\337\253$\346\362\020\310\224\332R\3322\252\277\312\264x\344\024#(\235\267\022\"\332\016AV\v\"3\311q\313\323\231\261\332\321u\274{D\257\335\313\254\274X\021\215\323q\327\2567w\367\304\205^\261\261>\223\223}\300\205y\234\322\234K\266\'W\352\231&-\\\213\356h\027{~b\2510+\323&\332\212\300\325q\t\222\233\210X\375\241\314\340\256~HT\267HM2\002[\337\251\345\376_-\214K\261.~\262~\217\243\v\035%\270\227N\002\213\341\va>\214\f\202\003\\\201K\346z\243\350\345\300\314s\264\241\t\273S\267\266\356\001\035\027\303yk\203\276\256\037\220\303\031\v#\214\321\2204\233\b\243qr\261)\324m-\267\264Y\023e\303i\326\024D67:\337\322\247\320\327\366\266#O\000\373p\263\030\315\245K\2528\203o\370\353l\326\210\305\371!\006v\341(\314\\>\370\363\363\265\315\2536\206\236!\252\177A\362E\257\v\003\231\324\332z\354\024])\255\314\203\373v\030\203\315z\357\t"
