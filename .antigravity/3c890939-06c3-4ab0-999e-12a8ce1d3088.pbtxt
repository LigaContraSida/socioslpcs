      command {
        instruction: "Add POST /partners/inquiry and admin inquiry management endpoints to src/server/api.ts"
        is_edit: true
        file {
          absolute_uri: "file:///src/server/api.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  db.prepare(\'DELETE FROM partners WHERE id = ?\').run(partnerId);\n\n  logAudit(admin.id, \'admin_remocao_parceiro\', `Parceiro ${partner.name} removido`, req.ip, req.headers[\'user-agent\']);\n\n  return res.json({ success: true, message: \'Parceiro removido com sucesso.\' });\n});\n\nexport default router;"
          replacement_content: "  db.prepare(\'DELETE FROM partners WHERE id = ?\').run(partnerId);\n\n  logAudit(admin.id, \'admin_remocao_parceiro\', `Parceiro ${partner.name} removido`, req.ip, req.headers[\'user-agent\']);\n\n  return res.json({ success: true, message: \'Parceiro removido com sucesso.\' });\n});\n\n// ==========================================\n// 8. CORPORATE PARTNERSHIP INQUIRIES (\"Quero fazer parceria\")\n// ==========================================\n\nrouter.post(\'/partners/inquiry\', (req: Request, res: Response) => {\n  const {\n    company_name,\n    nif,\n    contact_name,\n    email,\n    phone,\n    area,\n    district,\n    city,\n    benefit_type,\n    proposed_benefit,\n    website,\n    notes,\n  } = req.body;\n\n  if (!company_name || company_name.trim().length < 2) {\n    return res.status(400).json({ error: \'Indique o nome da empresa ou institui\303\247\303\243o.\' });\n  }\n  if (!contact_name || contact_name.trim().length < 2) {\n    return res.status(400).json({ error: \'Indique o nome da pessoa de contacto.\' });\n  }\n  if (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim())) {\n    return res.status(400).json({ error: \'Indique um endere\303\247o de e-mail empresarial v\303\241lido.\' });\n  }\n  if (!phone || phone.trim().length < 9) {\n    return res.status(400).json({ error: \'Indique um n\303\272mero de telefone ou telem\303\263vel de contacto.\' });\n  }\n  if (nif && nif.trim() !== \'\' && !validateNif(nif.trim())) {\n    return res.status(400).json({ error: \'O NIPC/NIF indicado n\303\243o passou a verifica\303\247\303\243o (M\303\263dulo 11).\' });\n  }\n  if (!proposed_benefit || proposed_benefit.trim().length < 5) {\n    return res.status(400).json({ error: \'Descreva brevemente o desconto ou benef\303\255cio proposto para os s\303\263cios.\' });\n  }\n\n  const result = db.prepare(`\n    INSERT INTO partner_inquiries (\n      company_name, nif, contact_name, email, phone, area, district, city,\n      benefit_type, proposed_benefit, website, notes\n    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `).run(\n    company_name.trim(),\n    nif ? nif.trim() : null,\n    contact_name.trim(),\n    email.trim().toLowerCase(),\n    phone.trim(),\n    area || \'Servi\303\247os\',\n    district || \'Nacional\',\n    city ? city.trim() : \'Nacional\',\n    benefit_type || \'codigo\',\n    proposed_benefit.trim(),\n    website ? website.trim() : null,\n    notes ? notes.trim() : null\n  );\n\n  logAudit(\n    null,\n    \'proposta_parceria_empresa\',\n    `Nova proposta de parceria submetida por ${company_name.trim()} (${email.trim()})`,\n    req.ip,\n    req.headers[\'user-agent\']\n  );\n\n  return res.json({\n    success: true,\n    inquiryId: Number(result.lastInsertRowid),\n    message: \'Proposta de parceria recebida com sucesso! A equipa de parcerias da LPCS entrar\303\241 em contacto brevemente.\',\n  });\n});\n\nrouter.get(\'/admin/inquiries\', requireAdmin, (_req: Request, res: Response) => {\n  const inquiries = db.prepare(`\n    SELECT * FROM partner_inquiries ORDER BY created_at DESC\n  `).all();\n\n  return res.json({ inquiries });\n});\n\nrouter.post(\'/admin/inquiries/:id/status\', requireAdmin, (req: Request, res: Response) => {\n  const admin = getSessionUser(req)!;\n  const inquiryId = Number(req.params.id);\n  const { status } = req.body;\n\n  if (![\'pendente\', \'em_analise\', \'aprovada\', \'recusada\'].includes(status)) {\n    return res.status(400).json({ error: \'Estado inv\303\241lido.\' });\n  }\n\n  const inquiry = db.prepare(\'SELECT * FROM partner_inquiries WHERE id = ?\').get(inquiryId) as any;\n  if (!inquiry) {\n    return res.status(404).json({ error: \'Proposta n\303\243o encontrada.\' });\n  }\n\n  db.prepare(\'UPDATE partner_inquiries SET status = ? WHERE id = ?\').run(status, inquiryId);\n\n  logAudit(\n    admin.id,\n    \'admin_estado_parceria\',\n    `Proposta da empresa ${inquiry.company_name} atualizada para \"${status}\"`,\n    req.ip,\n    req.headers[\'user-agent\']\n  );\n\n  return res.json({ success: true, status });\n});\n\nexport default router;\n"
          start_line: 1244
          end_line: 1252
        }
      }
    }
