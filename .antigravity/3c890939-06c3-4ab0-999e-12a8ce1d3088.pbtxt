  view_file {
    absolute_path_uri: "file:///src/pages/AdminPage.tsx"
    end_line: 1064
    content: "import React, { useState, useEffect } from \'react\';\nimport { User, AuditLog } from \'../types.ts\';\nimport { \n  ShieldAlert, \n  Users, \n  Store, \n  CreditCard, \n  FileText, \n  TrendingUp, \n  Plus, \n  Trash2, \n  Edit, \n  Power, \n  Search, \n  CheckCircle2, \n  XCircle, \n  AlertTriangle,\n  RefreshCw,\n  Lock,\n  Calendar,\n  X,\n  Building2\n} from \'lucide-react\';\n\ninterface AdminPageProps {\n  user: User | null;\n  isAdmin: boolean;\n  onNavigate: (path: string) => void;\n}\n\nexport const AdminPage: React.FC<AdminPageProps> = ({ user, isAdmin, onNavigate }) => {\n  // If not admin, redirect or block\n  if (!user || !isAdmin) {\n    return (\n      <div className=\"max-w-md mx-auto px-4 py-20 text-center space-y-4\">\n        <div className=\"w-16 h-16 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto\">\n          <Lock className=\"w-8 h-8\" />\n        </div>\n        <h2 className=\"text-2xl font-black text-slate-900\">Acesso Restrito</h2>\n        <p className=\"text-xs text-slate-500\">\n          Esta \303\241rea \303\251 de acesso reservado exclusivamente ao administrador oficial da Liga Portuguesa Contra a SIDA ({process.env.ADMIN_EMAIL || \'admin@lpcs.pt\'}).\n        </p>\n        <button\n          onClick={() => onNavigate(\'/\')}\n          className=\"px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold\"\n        >\n          Voltar \303\240 P\303\241gina Principal\n        </button>\n      </div>\n    );\n  }\n\n  const [activeTab, setActiveTab] = useState<\'summary\' | \'users\' | \'partners\' | \'inquiries\' | \'audit\'>(\'summary\');\n  const [summaryData, setSummaryData] = useState<any | null>(null);\n  const [usersList, setUsersList] = useState<any[]>([]);\n  const [partnersList, setPartnersList] = useState<any[]>([]);\n  const [inquiriesList, setInquiriesList] = useState<any[]>([]);\n  const [auditLogs, setAuditLogs] = useState<AuditLog[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  // Users tab state\n  const [userFilter, setUserFilter] = useState<\'todos\' | \'ativos\' | \'inativos\' | \'suspensos\'>(\'todos\');\n  const [userSearch, setUserSearch] = useState(\'\');\n  const [manualQuotaModalUser, setManualQuotaModalUser] = useState<any | null>(null);\n  const [manualQuotaPlan, setManualQuotaPlan] = useState<\'semestral\' | \'anual\'>(\'anual\');\n  const [manualQuotaNotes, setManualQuotaNotes] = useState(\'Pagamento por transfer\303\252ncia banc\303\241ria\');\n\n  // Partners tab state\n  const [partnerFilter, setPartnerFilter] = useState<\'all\' | \'active\' | \'inactive\'>(\'all\');\n  const [partnerModalOpen, setPartnerModalOpen] = useState(false);\n  const [editingPartner, setEditingPartner] = useState<any | null>(null);\n  const [partnerFormData, setPartnerFormData] = useState({\n    name: \'\',\n    category: \'\',\n    description: \'\',\n    area: \'Sa\303\272de e Bem-estar\',\n    district: \'Lisboa\',\n    city: \'Lisboa\',\n    benefit_type: \'codigo\',\n    benefit_value: \'\',\n    discount_highlight: \'\',\n    usage_limit: \'Utiliza\303\247\303\243o cont\303\255nua\',\n    estimated_annual_savings: \'50.0\',\n    valid_until: \'2027-12-31\',\n    terms: \'V\303\241lido mediante apresenta\303\247\303\243o do cart\303\243o ou c\303\263digo de s\303\263cio.\',\n    website: \'\',\n    is_active: true,\n    secret_code: \'\',\n  });\n\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3500);\n  };\n\n  const loadSummary = () => {\n    fetch(\'/api/admin/summary\')\n      .then((r) => r.json())\n      .then((data) => {\n        setSummaryData(data);\n        if (data.recentLogs) setAuditLogs(data.recentLogs);\n      });\n  };\n\n  const loadUsers = () => {\n    const params = new URLSearchParams();\n    if (userFilter !== \'todos\') params.set(\'filter\', userFilter);\n    if (userSearch.trim()) params.set(\'search\', userSearch.trim());\n\n    fetch(`/api/admin/users?${params.toString()}`)\n      .then((r) => r.json())\n      .then((data) => setUsersList(data.users || []));\n  };\n\n  const loadPartners = () => {\n    fetch(\'/api/partners\')\n      .then((r) => r.json())\n      .then((data) => setPartnersList(data.partners || []));\n  };\n\n  const loadInquiries = () => {\n    fetch(\'/api/admin/inquiries\')\n      .then((r) => r.json())\n      .then((data) => setInquiriesList(data.inquiries || []));\n  };\n\n  useEffect(() => {\n    setLoading(true);\n    Promise.all([\n      fetch(\'/api/admin/summary\').then((r) => r.json()),\n      fetch(\'/api/admin/users\').then((r) => r.json()),\n      fetch(\'/api/partners\').then((r) => r.json()),\n      fetch(\'/api/admin/inquiries\').then((r) => r.json()),\n    ])\n      .then(([summary, users, partners, inquiries]) => {\n        setSummaryData(summary);\n        if (summary.recentLogs) setAuditLogs(summary.recentLogs);\n        setUsersList(users.users || []);\n        setPartnersList(partners.partners || []);\n        setInquiriesList(inquiries.inquiries || []);\n        setLoading(false);\n      })\n      .catch((err) => {\n        console.error(\'Error fetching admin data:\', err);\n        setLoading(false);\n      });\n  }, []);\n\n  useEffect(() => {\n    if (activeTab === \'users\') {\n      loadUsers();\n    }\n  }, [userFilter, userSearch, activeTab]);\n\n  // Suspend/Reactivate user\n  const handleToggleSuspend = async (userId: number) => {\n    try {\n      const res = await fetch(`/api/admin/users/${userId}/suspend`, { method: \'POST\' });\n      const data = await res.json();\n      if (res.ok) {\n        showToast(data.message);\n        loadUsers();\n        loadSummary();\n      } else {\n        alert(data.error);\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Delete user\n  const handleDeleteUser = async (userId: number, name: string) => {\n    if (!window.confirm(`Tem a certeza que deseja eliminar a conta de ${name} e todos os dados associados? Esta a\303\247\303\243o \303\251 irrevers\303\255vel.`)) return;\n\n    try {\n      const res = await fetch(`/api/admin/users/${userId}`, { method: \'DELETE\' });\n      const data = await res.json();\n      if (res.ok) {\n        showToast(data.message);\n        loadUsers();\n        loadSummary();\n      } else {\n        alert(data.error);\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Grant manual quota\n  const handleGrantManualQuota = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!manualQuotaModalUser) return;\n\n    try {\n      const res = await fetch(`/api/admin/users/${manualQuotaModalUser.id}/quota`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          plan_type: manualQuotaPlan,\n          notes: manualQuotaNotes,\n        }),\n      });\n\n      const data = await res.json();\n      if (res.ok) {\n        showToast(data.message);\n        setManualQuotaModalUser(null);\n        loadUsers();\n        loadSummary();\n      } else {\n        alert(data.error);\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Partner Save\n  const handleSavePartner = async (e: React.FormEvent) => {\n    e.preventDefault();\n    const isEdit = !!editingPartner;\n    const url = isEdit ? `/api/admin/partners/${editingPartner.id}` : \'/api/admin/partners\';\n    const method = isEdit ? \'PUT\' : \'POST\';\n\n    try {\n      const res = await fetch(url, {\n        method,\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(partnerFormData),\n      });\n\n      const data = await res.json();\n      if (res.ok) {\n        showToast(isEdit ? \'Parceiro atualizado com sucesso!\' : \'Novo parceiro adicionado com sucesso!\');\n        setPartnerModalOpen(false);\n        setEditingPartner(null);\n        loadPartners();\n        loadSummary();\n      } else {\n        alert(data.error);\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Toggle partner active/inactive\n  const handleTogglePartner = async (partnerId: number) => {\n    try {\n      const res = await fetch(`/api/admin/partners/${partnerId}/toggle`, { method: \'POST\' });\n      if (res.ok) {\n        showToast(\'Estado do parceiro alterado.\');\n        loadPartners();\n        loadSummary();\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Delete partner\n  const handleDeletePartner = async (partnerId: number, name: string) => {\n    if (!window.confirm(`Tem a certeza que deseja remover o parceiro \"${name}\"?`)) return;\n\n    try {\n      const res = await fetch(`/api/admin/partners/${partnerId}`, { method: \'DELETE\' });\n      if (res.ok) {\n        showToast(\'Parceiro removido com sucesso.\');\n        loadPartners();\n        loadSummary();\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  const openNewPartnerModal = () => {\n    setEditingPartner(null);\n    setPartnerFormData({\n      name: \'\',\n      category: \'Geral\',\n      description: \'\',\n      area: \'Sa\303\272de e Bem-estar\',\n      district: \'Lisboa\',\n      city: \'Lisboa\',\n      benefit_type: \'codigo\',\n      benefit_value: \'20% de desconto\',\n      discount_highlight: \'20% em servi\303\247os\',\n      usage_limit: \'Utiliza\303\247\303\243o cont\303\255nua\',\n      estimated_annual_savings: \'50.0\',\n      valid_until: \'2027-12-31\',\n      terms: \'V\303\241lido mediante apresenta\303\247\303\243o do cart\303\243o ou c\303\263digo de s\303\263cio.\',\n      website: \'\',\n      is_active: true,\n      secret_code: \'PARCEIRO20\',\n    });\n    setPartnerModalOpen(true);\n  };\n\n  const openEditPartnerModal = (p: any) => {\n    setEditingPartner(p);\n    setPartnerFormData({\n      name: p.name,\n      category: p.category,\n      description: p.description,\n      area: p.area,\n      district: p.district,\n      city: p.city,\n      benefit_type: p.benefit_type,\n      benefit_value: p.benefit_value,\n      discount_highlight: p.discount_highlight,\n      usage_limit: p.usage_limit,\n      estimated_annual_savings: String(p.estimated_annual_savings),\n      valid_until: p.valid_until,\n      terms: p.terms,\n      website: p.website || \'\',\n      is_active: p.is_active !== 0,\n      secret_code: p.secret_code || \'CODE10\',\n    });\n    setPartnerModalOpen(true);\n  };\n\n  const metrics = summaryData?.metrics || {\n    totalAssociados: 0,\n    associadosQuotaAtiva: 0,\n    associadosInativos: 0,\n    associadosSuspensos: 0,\n    parceirosAtivos: 0,\n    parceirosInativos: 0,\n    receitaTotalEuros: 0,\n    descontosResgatados: 0,\n    descontosEmitidosTotal: 0,\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\">\n      \n      {/* Toast message */}\n      {toastMessage && (\n        <div className=\"fixed bottom-6 right-6 z-50 p-4 bg-slate-900 text-white rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 text-xs font-semibold animate-bounce\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Top Admin Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-6\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 px-2.5 py-0.5 rounded-full border border-purple-200\">\n              Acesso Restrito: Administrador\n            </span>\n          </div>\n          <h1 className=\"text-3xl font-black text-slate-900 tracking-tight mt-1\">\n            Backoffice LPCS\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            Gest\303\243o global de associados, lan\303\247amento de quotas, controlo de parceiros e auditoria de seguran\303\247a.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => {\n              loadSummary();\n              loadUsers();\n              loadPartners();\n              loadInquiries();\n              showToast(\'Dados sincronizados.\');\n            }}\n            className=\"p-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-bold flex items-center gap-1.5\"\n            title=\"Atualizar dados\"\n          >\n            <RefreshCw className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline\">Sincronizar</span>\n          </button>\n          <div className=\"text-right\">\n            <span className=\"text-[10px] text-slate-400 uppercase font-bold block\">Sess\303\243o Admin</span>\n            <span className=\"text-xs font-mono font-bold text-slate-800\">{user.email}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Tabs */}\n      <div className=\"flex border-b border-slate-200 gap-2 sm:gap-4 overflow-x-auto\">\n        {[\n          { id: \'summary\', name: \'Resumo Geral\', icon: TrendingUp },\n          { id: \'users\', name: \'Associados\', icon: Users, badge: metrics.totalAssociados },\n          { id: \'partners\', name: \'Parceiros & Descontos\', icon: Store, badge: metrics.parceirosAtivos },\n          { id: \'inquiries\', name: \'Propostas de Parceria\', icon: Building2, badge: inquiriesList.length },\n          { id: \'audit\', name: \'Registo de Auditoria\', icon: ShieldAlert },\n        ].map((tab) => {\n          const Icon = tab.icon;\n          const active = activeTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => setActiveTab(tab.id as any)}\n              className={`py-3 px-3 sm:px-4 text-xs font-bold border-b-2 transition-colors flex items-center gap-2 shrink-0 ${\n                active\n                  ? \'border-red-600 text-red-600\'\n                  : \'border-transparent text-slate-500 hover:text-slate-800\'\n              }`}\n            >\n              <Icon className=\"w-4 h-4\" />\n              <span>{tab.name}</span>\n              {tab.badge !== undefined && (\n                <span className={`text-[10px] px-1.5 py-0.2 rounded-full ${\n                  active ? \'bg-red-100 text-red-700\' : \'bg-slate-100 text-slate-600\'\n                }`}>\n                  {tab.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* TAB 1: SUMMARY METRICS */}\n      {activeTab === \'summary\' && (\n        <div className=\"space-y-8\">\n          <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6\">\n            \n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n              <span className=\"text-[11px] font-bold uppercase text-slate-400\">Associados Registados</span>\n              <div className=\"text-2xl sm:text-3xl font-black font-mono text-slate-900 mt-1\">{metrics.totalAssociados}</div>\n              <span className=\"text-[11px] text-emerald-600 font-semibold\">{metrics.associadosQuotaAtiva} com quota ativa</span>\n            </div>\n\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n              <span className=\"text-[11px] font-bold uppercase text-slate-400\">Receita Total de Quotas</span>\n              <div className=\"text-2xl sm:text-3xl font-black font-mono text-emerald-600 mt-1\">\n                {metrics.receitaTotalEuros.toFixed(2)} \342\202\254\n              </div>\n              <span className=\"text-[11px] text-slate-500\">Fundos dedicados \303\240 miss\303\243o LPCS</span>\n            </div>\n\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n              <span className=\"text-[11px] font-bold uppercase text-slate-400\">Parceiros Ativos</span>\n              <div className=\"text-2xl sm:text-3xl font-black font-mono text-slate-900 mt-1\">{metrics.parceirosAtivos}</div>\n              <span className=\"text-[11px] text-slate-500\">{metrics.parceirosInativos} desativados</span>\n            </div>\n\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs\">\n              <span className=\"text-[11px] font-bold uppercase text-slate-400\">Descontos Validados</span>\n              <div className=\"text-2xl sm:text-3xl font-black font-mono text-red-600 mt-1\">{metrics.descontosResgatados}</div>\n              <span className=\"text-[11px] text-slate-500\">De {metrics.descontosEmitidosTotal} c\303\263digos emitidos</span>\n            </div>\n\n          </div>\n\n          {/* Quick activity logs snapshot */}\n          <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4\">\n            <h3 className=\"text-base font-bold text-slate-900\">Atividade Recente no Sistema</h3>\n            <div className=\"divide-y divide-slate-100 text-xs\">\n              {auditLogs.slice(0, 8).map((log) => (\n                <div key={log.id} className=\"py-3 flex items-start justify-between gap-4\">\n                  <div>\n                    <span className=\"font-semibold text-slate-900 block\">{log.action}</span>\n                    <span className=\"text-slate-500\">{log.details}</span>\n                    {log.user_name && (\n                      <span className=\"text-slate-400 block mt-0.5 font-mono text-[11px]\">\n                        Por: {log.user_name} ({log.member_number})\n                      </span>\n                    )}\n                  </div>\n                  <span className=\"text-[11px] font-mono text-slate-400 shrink-0\">\n                    {new Date(log.created_at).toLocaleTimeString(\'pt-PT\')}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: ASSOCIATES MANAGEMENT */}\n      {activeTab === \'users\' && (\n        <div className=\"space-y-6\">\n          \n          {/* Controls: Search and Filters */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200\">\n            <div className=\"relative flex-1 max-w-md\">\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder=\"Pesquisar por nome, email, NIF ou n\302\272 s\303\263cio...\"\n                value={userSearch}\n                onChange={(e) => setUserSearch(e.target.value)}\n                className=\"w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1.5 overflow-x-auto\">\n              {[\n                { id: \'todos\', label: \'Todos\' },\n                { id: \'ativos\', label: \'Quota Ativa\' },\n                { id: \'inativos\', label: \'Inativos\' },\n                { id: \'suspensos\', label: \'Suspensos\' },\n              ].map((f) => (\n                <button\n                  key={f.id}\n                  onClick={() => setUserFilter(f.id as any)}\n                  className={`px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap ${\n                    userFilter === f.id\n                      ? \'bg-slate-900 text-white\'\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                  }`}\n                >\n                  {f.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Users Table */}\n          <div className=\"bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs text-slate-600\">\n                <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400 border-b border-slate-200\">\n                  <tr>\n                    <th className=\"py-3 px-4\">S\303\263cio</th>\n                    <th className=\"py-3 px-4\">N\302\272 S\303\263cio / NIF</th>\n                    <th className=\"py-3 px-4\">Localidade</th>\n                    <th className=\"py-3 px-4\">Estado Quota</th>\n                    <th className=\"py-3 px-4\">Estado Conta</th>\n                    <th className=\"py-3 px-4 text-right\">A\303\247\303\265es</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100 font-medium\">\n                  {usersList.map((u) => {\n                    const isSelf = u.id === user.id;\n                    const hasActiveQuota = u.quota_status?.has_active_quota;\n\n                    return (\n                      <tr key={u.id} className=\"hover:bg-slate-50/60 transition-colors\">\n                        <td className=\"py-3 px-4\">\n                          <strong className=\"text-slate-900 block\">{u.name}</strong>\n                          <span className=\"text-[11px] text-slate-500\">{u.email}</span>\n                        </td>\n                        <td className=\"py-3 px-4 font-mono\">\n                          <span className=\"font-bold text-slate-800 block\">{u.member_number}</span>\n                          <span className=\"text-[11px] text-slate-500\">NIF: {u.nif}</span>\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-700\">{u.city}</td>\n                        <td className=\"py-3 px-4\">\n                          {hasActiveQuota ? (\n                            <span className=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800\">\n                              V\303\241lida at\303\251 {u.quota_status.valid_until}\n                            </span>\n                          ) : (\n                            <span className=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800\">\n                              Expirada / Inativa\n                            </span>\n                          )}\n                        </td>\n                        <td className=\"py-3 px-4\">\n                          {u.is_suspended === 1 ? (\n                            <span className=\"inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-50 text-red-700 border border-red-200\">\n                              Suspensa\n                            </span>\n                          ) : (\n                            <span className=\"inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700\">\n                              Normal\n                            </span>\n                          )}\n                        </td>\n                        <td className=\"py-3 px-4 text-right space-x-1.5\">\n                          {/* Manual quota grant */}\n                          <button\n                            onClick={() => setManualQuotaModalUser(u)}\n                            className=\"px-2.5 py-1 rounded-lg bg-red-50 hover:bg-red-100 text-red-700 font-bold text-[11px]\"\n                            title=\"Lan\303\247ar quota manual\"\n                          >\n                            + Quota\n                          </button>\n\n                          {/* Suspend / Unsuspend (disabled for self) */}\n                          <button\n                            onClick={() => handleToggleSuspend(u.id)}\n                            disabled={isSelf}\n                            className={`p-1.5 rounded-lg text-xs font-semibold ${\n                              isSelf\n                                ? \'opacity-30 cursor-not-allowed\'\n                                : u.is_suspended === 1\n                                ? \'bg-emerald-50 text-emerald-700 hover:bg-emerald-100\'\n                                : \'bg-amber-50 text-amber-700 hover:bg-amber-100\'\n                            }`}\n                            title={isSelf ? \'N\303\243o se pode suspender a si pr\303\263prio\' : u.is_suspended === 1 ? \'Reativar conta\' : \'Suspender conta\'}\n                          >\n                            <Power className=\"w-3.5 h-3.5\" />\n                          </button>\n\n                          {/* Delete account */}\n                          <button\n                            onClick={() => handleDeleteUser(u.id, u.name)}\n                            disabled={isSelf}\n                            className={`p-1.5 rounded-lg text-xs font-semibold ${\n                              isSelf\n                                ? \'opacity-30 cursor-not-allowed\'\n                                : \'text-slate-400 hover:text-red-600 hover:bg-red-50\'\n                            }`}\n                            title={isSelf ? \'N\303\243o pode eliminar a sua pr\303\263pria conta de admin\' : \'Eliminar conta\'}\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3: PARTNERS MANAGEMENT */}\n      {activeTab === \'partners\' && (\n        <div className=\"space-y-6\">\n          \n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-base font-bold text-slate-900\">Cat\303\241logo de Parceiros LPCS</h3>\n            <button\n              onClick={openNewPartnerModal}\n              className=\"px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-xs flex items-center gap-1.5\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Adicionar Parceiro</span>\n            </button>\n          </div>\n\n          <div className=\"bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs text-slate-600\">\n                <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400 border-b border-slate-200\">\n                  <tr>\n                    <th className=\"py-3 px-4\">Parceiro</th>\n                    <th className=\"py-3 px-4\">\303\201rea / Local</th>\n                    <th className=\"py-3 px-4\">Tipo & Desconto</th>\n                    <th className=\"py-3 px-4\">C\303\263digo \303\232nico</th>\n                    <th className=\"py-3 px-4\">Poupan\303\247a Est.</th>\n                    <th className=\"py-3 px-4\">Estado</th>\n                    <th className=\"py-3 px-4 text-right\">A\303\247\303\265es</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100 font-medium\">\n                  {partnersList.map((p) => (\n                    <tr key={p.id} className=\"hover:bg-slate-50/60 transition-colors\">\n                      <td className=\"py-3 px-4\">\n                        <strong className=\"text-slate-900 block\">{p.name}</strong>\n                        <span className=\"text-[11px] text-slate-500\">{p.category}</span>\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <span className=\"text-slate-800 block\">{p.area}</span>\n                        <span className=\"text-[11px] text-slate-500\">{p.city} ({p.district})</span>\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <span className=\"font-bold text-red-600 block\">{p.discount_highlight}</span>\n                        <span className=\"text-[11px] uppercase text-slate-400 font-semibold\">{p.benefit_type}</span>\n                      </td>\n                      <td className=\"py-3 px-4 font-mono font-bold text-slate-800\">\n                        {p.secret_code || \'\342\200\224\'}\n                      </td>\n                      <td className=\"py-3 px-4 font-mono font-bold text-slate-900\">\n                        {p.estimated_annual_savings} \342\202\254/ano\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        {p.is_active !== 0 ? (\n                          <span className=\"inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800\">\n                            Ativo\n                          </span>\n                        ) : (\n                          <span className=\"inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600\">\n                            Inativo\n                          </span>\n                        )}\n                      </td>\n                      <td className=\"py-3 px-4 text-right space-x-1.5\">\n                        <button\n                          onClick={() => openEditPartnerModal(p)}\n                          className=\"p-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100\"\n                          title=\"Editar parceiro\"\n                        >\n                          <Edit className=\"w-3.5 h-3.5\" />\n                        </button>\n                        <button\n                          onClick={() => handleTogglePartner(p.id)}\n                          className=\"p-1.5 rounded-lg text-slate-600 hover:text-amber-600 hover:bg-amber-50\"\n                          title=\"Ativar/Desativar\"\n                        >\n                          <Power className=\"w-3.5 h-3.5\" />\n                        </button>\n                        <button\n                          onClick={() => handleDeletePartner(p.id, p.name)}\n                          className=\"p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50\"\n                          title=\"Remover parceiro\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3.5: PARTNER INQUIRIES */}\n      {activeTab === \'inquiries\' && (\n        <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">Propostas de Parceria Empresarial</h3>\n              <p className=\"text-xs text-slate-500\">Empresas interessadas em colaborar com a LPCS atrav\303\251s do formul\303\241rio \"Quero fazer parceria\".</p>\n            </div>\n            <span className=\"text-xs text-slate-400\">Total: {inquiriesList.length}</span>\n          </div>\n\n          {inquiriesList.length === 0 ? (\n            <p className=\"text-xs text-slate-500 py-6 text-center\">Ainda n\303\243o foram submetidas propostas de parceria.</p>\n          ) : (\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs text-slate-600\">\n                <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400 border-b border-slate-200\">\n                  <tr>\n                    <th className=\"py-3 px-3\">Empresa / Contacto</th>\n                    <th className=\"py-3 px-3\">\303\201rea / Local</th>\n                    <th className=\"py-3 px-3\">Desconto Proposto</th>\n                    <th className=\"py-3 px-3\">Estado</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100 font-medium\">\n                  {inquiriesList.map((inq) => (\n                    <tr key={inq.id} className=\"hover:bg-slate-50/60\">\n                      <td className=\"py-3 px-3\">\n                        <strong className=\"text-slate-900 block\">{inq.company_name}</strong>\n                        <span className=\"text-[11px] text-slate-500 block\">{inq.contact_name} \302\267 {inq.email} \302\267 {inq.phone}</span>\n                        {inq.nif && <span className=\"text-[10px] font-mono text-slate-400\">NIPC: {inq.nif}</span>}\n                      </td>\n                      <td className=\"py-3 px-3\">\n                        <span className=\"text-slate-800 block\">{inq.area}</span>\n                        <span className=\"text-[11px] text-slate-500\">{inq.city} ({inq.district})</span>\n                      </td>\n                      <td className=\"py-3 px-3\">\n                        <span className=\"font-bold text-red-600 block\">{inq.proposed_benefit}</span>\n                        <span className=\"text-[10px] uppercase text-slate-400\">{inq.benefit_type}</span>\n                        {inq.notes && <p className=\"text-[11px] text-slate-500 mt-1 max-w-xs\">{inq.notes}</p>}\n                      </td>\n                      <td className=\"py-3 px-3\">\n                        <select\n                          value={inq.status}\n                          onChange={async (e) => {\n                            const status = e.target.value;\n                            const res = await fetch(`/api/admin/inquiries/${inq.id}/status`, {\n                              method: \'POST\',\n                              headers: { \'Content-Type\': \'application/json\' },\n                              body: JSON.stringify({ status }),\n                            });\n                            if (res.ok) {\n                              showToast(\'Estado da proposta atualizado.\');\n                              loadInquiries();\n                            }\n                          }}\n                          className=\"py-1.5 px-2.5 rounded-lg border border-slate-200 text-xs font-semibold bg-white\"\n                        >\n                          <option value=\"pendente\">Pendente</option>\n                          <option value=\"em_analise\">Em An\303\241lise</option>\n                          <option value=\"aprovada\">Aprovada</option>\n                          <option value=\"recusada\">Recusada</option>\n                        </select>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* TAB 4: AUDIT LOGS */}\n      {activeTab === \'audit\' && (\n        <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-base font-bold text-slate-900\">Registo Completo de Auditoria</h3>\n            <span className=\"text-xs text-slate-400\">Total: {auditLogs.length} eventos</span>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs text-slate-600\">\n              <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400 border-b border-slate-200\">\n                <tr>\n                  <th className=\"py-2.5 px-3\">Data / Hora</th>\n                  <th className=\"py-2.5 px-3\">A\303\247\303\243o</th>\n                  <th className=\"py-2.5 px-3\">Detalhes</th>\n                  <th className=\"py-2.5 px-3\">S\303\263cio</th>\n                  <th className=\"py-2.5 px-3\">IP / Dispositivo</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 font-medium\">\n                {auditLogs.map((log) => (\n                  <tr key={log.id} className=\"hover:bg-slate-50/60\">\n                    <td className=\"py-3 px-3 font-mono text-[11px] text-slate-500 whitespace-nowrap\">\n                      {new Date(log.created_at).toLocaleString(\'pt-PT\')}\n                    </td>\n                    <td className=\"py-3 px-3 font-bold text-slate-900\">{log.action}</td>\n                    <td className=\"py-3 px-3 text-slate-700 max-w-sm truncate\">{log.details}</td>\n                    <td className=\"py-3 px-3 text-slate-600\">\n                      {log.user_name ? `${log.user_name} (${log.member_number})` : \'\342\200\224\'}\n                    </td>\n                    <td className=\"py-3 px-3 font-mono text-[11px] text-slate-400 whitespace-nowrap\">\n                      {log.ip_address || \'127.0.0.1\'}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL: MANUAL QUOTA GRANT */}\n      {manualQuotaModalUser && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl space-y-5\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-slate-900\">Lan\303\247ar Quota Manualmente</h3>\n              <button onClick={() => setManualQuotaModalUser(null)} className=\"text-slate-400 hover:text-slate-600\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-500\">\n              Atribuir quota a <strong className=\"text-slate-800\">{manualQuotaModalUser.name}</strong> ({manualQuotaModalUser.member_number}) ap\303\263s confirma\303\247\303\243o de pagamento por transfer\303\252ncia banc\303\241ria ou numer\303\241rio.\n            </p>\n\n            <form onSubmit={handleGrantManualQuota} className=\"space-y-4\">\n              <div>\n                <label className=\"text-xs font-bold uppercase text-slate-700 block mb-1\">Plano de Quota</label>\n                <select\n                  value={manualQuotaPlan}\n                  onChange={(e) => setManualQuotaPlan(e.target.value as any)}\n                  className=\"w-full p-2.5 rounded-xl border border-slate-300 text-xs font-semibold\"\n                >\n                  <option value=\"anual\">Anual (35,00 \342\202\254 \302\267 12 Meses)</option>\n                  <option value=\"semestral\">Semestral (17,50 \342\202\254 \302\267 6 Meses)</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold uppercase text-slate-700 block mb-1\">Nota Interna</label>\n                <input\n                  type=\"text\"\n                  value={manualQuotaNotes}\n                  onChange={(e) => setManualQuotaNotes(e.target.value)}\n                  className=\"w-full p-2.5 rounded-xl border border-slate-300 text-xs\"\n                  placeholder=\"Ex: Transfer\303\252ncia banc\303\241ria Millennium comprovativo n\302\272 849\"\n                />\n              </div>\n\n              <div className=\"flex gap-2 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setManualQuotaModalUser(null)}\n                  className=\"flex-1 py-2.5 rounded-xl border border-slate-300 text-xs font-bold text-slate-700\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold\"\n                >\n                  Confirmar Lan\303\247amento\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL: ADD / EDIT PARTNER */}\n      {partnerModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\">\n          <div className=\"bg-white rounded-3xl p-6 sm:p-8 max-w-2xl w-full shadow-2xl space-y-5 my-8\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-lg font-bold text-slate-900\">\n                {editingPartner ? `Editar Parceiro: ${editingPartner.name}` : \'Adicionar Novo Parceiro\'}\n              </h3>\n              <button onClick={() => setPartnerModalOpen(false)} className=\"text-slate-400 hover:text-slate-600\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleSavePartner} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                \n                <div className=\"sm:col-span-2\">\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Nome do Parceiro *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.name}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, name: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: Farm\303\241cia Sa\303\272de+\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Categoria *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.category}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, category: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: Farm\303\241cias & Parafarm\303\241cia\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">\303\201rea de Atividade *</label>\n                  <select\n                    value={partnerFormData.area}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, area: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                  >\n                    <option value=\"Sa\303\272de e Bem-estar\">Sa\303\272de e Bem-estar</option>\n                    <option value=\"Desporto\">Desporto</option>\n                    <option value=\"Lazer e Cultura\">Lazer e Cultura</option>\n                    <option value=\"Restaura\303\247\303\243o e Alimenta\303\247\303\243o\">Restaura\303\247\303\243o e Alimenta\303\247\303\243o</option>\n                    <option value=\"Forma\303\247\303\243o e Educa\303\247\303\243o\">Forma\303\247\303\243o e Educa\303\247\303\243o</option>\n                    <option value=\"Servi\303\247os\">Servi\303\247os</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Distrito *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.district}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, district: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: Lisboa, Porto, Coimbra ou Nacional\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Localidade *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.city}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, city: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: Lisboa, Online ou Matosinhos\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Tipo de Benef\303\255cio *</label>\n                  <select\n                    value={partnerFormData.benefit_type}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, benefit_type: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                  >\n                    <option value=\"cupao\">Cup\303\243o Promocional (valor fixo \342\202\254)</option>\n                    <option value=\"codigo\">C\303\263digo de Desconto (% cont\303\255nuo)</option>\n                    <option value=\"voucher\">Voucher Nominal (uso \303\272nico)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Desconto em Destaque *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.discount_highlight}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, discount_highlight: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: 35% em an\303\241lises ou 50\342\202\254 em tratamentos\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Poupan\303\247a Anual Estimada (\342\202\254) *</label>\n                  <input\n                    type=\"number\"\n                    step=\"0.5\"\n                    required\n                    value={partnerFormData.estimated_annual_savings}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, estimated_annual_savings: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"50.0\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">C\303\263digo \303\232nico (Mascarado para n\303\243o s\303\263cios) *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={partnerFormData.secret_code}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, secret_code: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs font-mono uppercase\"\n                    placeholder=\"Ex: FARMA5\"\n                  />\n                </div>\n\n                <div className=\"sm:col-span-2\">\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Descri\303\247\303\243o</label>\n                  <textarea\n                    rows={2}\n                    value={partnerFormData.description}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, description: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Breve descri\303\247\303\243o dos servi\303\247os e produtos oferecidos.\"\n                  />\n                </div>\n\n                <div className=\"sm:col-span-2\">\n                  <label className=\"text-xs font-bold text-slate-700 block mb-1\">Condi\303\247\303\265es & Termos</label>\n                  <input\n                    type=\"text\"\n                    value={partnerFormData.terms}\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, terms: e.target.value })}\n                    className=\"w-full p-2 rounded-xl border border-slate-300 text-xs\"\n                    placeholder=\"Ex: N\303\243o acumul\303\241vel com outras promo\357\277\275"
    num_lines: 1065
    num_bytes: 46878
    line_range_bytes: 46878
  }
}
