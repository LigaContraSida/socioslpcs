    content: "<!doctype html>\n<html lang=\"pt-PT\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Liga Portuguesa Contra a SIDA - Portal de Associados</title>\n    <meta name=\"description\" content=\"Plataforma de associados da Liga Portuguesa Contra a SIDA (LPCS): pagamento e gest\303\243o de quotas, benef\303\255cios e descontos exclusivos em parceiros, e backoffice administrativo.\" />\n    <meta property=\"og:title\" content=\"Liga Portuguesa Contra a SIDA - Portal de Associados\" />\n    <meta property=\"og:description\" content=\"Plataforma de associados da Liga Portuguesa Contra a SIDA (LPCS): pagamento e gest\303\243o de quotas, benef\303\255cios e descontos exclusivos em parceiros, e backoffice administrativo.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23dc2626\'%3E%3Cpath d=\'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\'/%3E%3C/svg%3E\" />\n  </head>\n  <body class=\"bg-slate-50 text-slate-800 antialiased selection:bg-red-500 selection:text-white min-h-screen\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n"
