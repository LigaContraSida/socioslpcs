  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 216
    content: "import React, { useState, useEffect } from \'react\';\nimport { User } from \'./types.ts\';\nimport { Header } from \'./components/Header.tsx\';\nimport { Footer } from \'./components/Footer.tsx\';\nimport { HomePage } from \'./pages/HomePage.tsx\';\nimport { PartnersPage } from \'./pages/PartnersPage.tsx\';\nimport { DashboardPage } from \'./pages/DashboardPage.tsx\';\nimport { PaymentsPage } from \'./pages/PaymentsPage.tsx\';\nimport { ProfilePage } from \'./pages/ProfilePage.tsx\';\nimport { LoginPage } from \'./pages/LoginPage.tsx\';\nimport { RegisterPage } from \'./pages/RegisterPage.tsx\';\nimport { MerchantValidatePage } from \'./pages/MerchantValidatePage.tsx\';\nimport { AdminPage } from \'./pages/AdminPage.tsx\';\nimport { PartnershipPage } from \'./pages/PartnershipPage.tsx\';\n\nexport default function App() {\n  const [user, setUser] = useState<User | null>(null);\n  const [isAdmin, setIsAdmin] = useState<boolean>(false);\n  const [loadingUser, setLoadingUser] = useState(true);\n  const [currentPath, setCurrentPath] = useState<string>(window.location.pathname || \'/\');\n  const [routeQuery, setRouteQuery] = useState<Record<string, string>>({});\n\n  const fetchCurrentUser = async (): Promise<User | null> => {\n    try {\n      const res = await fetch(\'/api/auth/me\', { credentials: \'same-origin\' });\n      const data = await res.json();\n      if (data.user) {\n        setUser(data.user);\n        setIsAdmin(!!data.isAdmin);\n        return data.user;\n      } else {\n        setUser(null);\n        setIsAdmin(false);\n        return null;\n      }\n    } catch (err) {\n      console.error(\'Failed to fetch user:\', err);\n      setUser(null);\n      setIsAdmin(false);\n      return null;\n    } finally {\n      setLoadingUser(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchCurrentUser();\n\n    const handlePopState = () => {\n      setCurrentPath(window.location.pathname);\n      const searchParams = new URLSearchParams(window.location.search);\n      const queryObj: Record<string, string> = {};\n      searchParams.forEach((val, key) => {\n        queryObj[key] = val;\n      });\n      setRouteQuery(queryObj);\n    };\n\n    window.addEventListener(\'popstate\', handlePopState);\n    return () => window.removeEventListener(\'popstate\', handlePopState);\n  }, []);\n\n  const navigate = (path: string, query?: Record<string, string>) => {\n    let url = path;\n    if (query && Object.keys(query).length > 0) {\n      const sp = new URLSearchParams(query);\n      url += `?${sp.toString()}`;\n    }\n    window.history.pushState({}, \'\', url);\n    setCurrentPath(path);\n    setRouteQuery(query || {});\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  const handleLogout = async () => {\n    try {\n      await fetch(\'/api/auth/logout\', { method: \'POST\' });\n    } catch (err) {\n      console.error(\'Logout error:\', err);\n    }\n    setUser(null);\n    setIsAdmin(false);\n    navigate(\'/\');\n  };\n\n  // Render current view\n  const renderPage = () => {\n    if (loadingUser) {\n      return (\n        <div className=\"py-32 flex flex-col items-center justify-center space-y-3\">\n          <div className=\"w-10 h-10 border-4 border-red-600 border-t-transparent rounded-full animate-spin\" />\n          <p className=\"text-xs text-slate-500 font-medium\">A carregar Portal LPCS...</p>\n        </div>\n      );\n    }\n\n    if (currentPath === \'/parceiros\') {\n      return (\n        <PartnersPage\n          user={user}\n          initialQuery={routeQuery}\n          onNavigate={navigate}\n        />\n      );\n    }\n\n    if (currentPath === \'/validar\') {\n      return <MerchantValidatePage />;\n    }\n\n    if (currentPath === \'/entrar\') {\n      return (\n        <LoginPage\n          onNavigate={navigate}\n          onRefreshUser={fetchCurrentUser}\n        />\n      );\n    }\n\n    if (currentPath === \'/registar\') {\n      return (\n        <RegisterPage\n          onNavigate={navigate}\n          onRefreshUser={fetchCurrentUser}\n        />\n      );\n    }\n\n    if (currentPath === \'/dashboard\') {\n      if (!user) {\n        return (\n          <LoginPage\n            onNavigate={navigate}\n            onRefreshUser={fetchCurrentUser}\n          />\n        );\n      }\n      return (\n        <DashboardPage\n          user={user}\n          onNavigate={navigate}\n          onRefreshUser={fetchCurrentUser}\n        />\n      );\n    }\n\n    if (currentPath === \'/pagamentos\') {\n      if (!user) {\n        return (\n          <LoginPage\n            onNavigate={navigate}\n            onRefreshUser={fetchCurrentUser}\n          />\n        );\n      }\n      return (\n        <PaymentsPage\n          user={user}\n          onRefreshUser={fetchCurrentUser}\n        />\n      );\n    }\n\n    if (currentPath === \'/perfil\') {\n      if (!user) {\n        return (\n          <LoginPage\n            onNavigate={navigate}\n            onRefreshUser={fetchCurrentUser}\n          />\n        );\n      }\n      return (\n        <ProfilePage\n          user={user}\n          onRefreshUser={fetchCurrentUser}\n        />\n      );\n    }\n\n    if (currentPath === \'/parceria\') {\n      return <PartnershipPage onNavigate={navigate} />;\n    }\n\n    if (currentPath === \'/admin\') {\n      return (\n        <AdminPage\n          user={user}\n          isAdmin={isAdmin}\n          onNavigate={navigate}\n        />\n      );\n    }\n\n    // Default: Home\n    return <HomePage user={user} onNavigate={navigate} onRefreshUser={fetchCurrentUser} />;\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-slate-50 text-slate-800\">\n      <Header\n        user={user}\n        isAdmin={isAdmin}\n        currentPath={currentPath}\n        onNavigate={navigate}\n        onLogout={handleLogout}\n      />\n      \n      <main className=\"flex-1\">\n        {renderPage()}\n      </main>\n\n      <Footer onNavigate={navigate} />\n    </div>\n  );\n}\n"
    num_lines: 217
    num_bytes: 5723
    line_range_bytes: 5723
  }
}
