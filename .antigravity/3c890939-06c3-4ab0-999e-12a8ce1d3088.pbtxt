  view_file {
    absolute_path_uri: "file:///src/pages/HomePage.tsx"
    end_line: 488
    content: "import React, { useState, useEffect } from \'react\';\nimport { HeroStats, User } from \'../types.ts\';\nimport { \n  Check, \n  ArrowRight, \n  Sparkles, \n  TrendingUp, \n  ShieldCheck, \n  Heart, \n  Calendar, \n  Percent, \n  Ticket, \n  Tag, \n  Award,\n  ChevronRight,\n  Info\n} from \'lucide-react\';\n\ninterface HomePageProps {\n  user: User | null;\n  onNavigate: (path: string, query?: Record<string, string>) => void;\n}\n\nexport const HomePage: React.FC<HomePageProps> = ({ user, onNavigate }) => {\n  const [stats, setStats] = useState<HeroStats | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetch(\'/api/partners/hero-stats\')\n      .then((res) => res.json())\n      .then((data: HeroStats) => {\n        setStats(data);\n        setLoading(false);\n      })\n      .catch((err) => {\n        console.error(\'Failed to load hero stats:\', err);\n        setLoading(false);\n      });\n  }, []);\n\n  const totalSavings = stats ? Math.floor(stats.totalSavings) : 1580;\n  const multiplier = stats ? stats.savingsMultiplier : 45.1;\n  const partnersCount = stats ? stats.partnersCount : 28;\n\n  const categories = [\n    { name: \'Sa\303\272de e Bem-estar\', icon: Heart, count: 12, desc: \'Farm\303\241cias, an\303\241lises cl\303\255nicas, medicina dent\303\241ria, psicologia e fisioterapia\' },\n    { name: \'Desporto\', icon: TrendingUp, count: 3, desc: \'Gin\303\241sios, campos de padel e nata\303\247\303\243o com descontos na mensalidade\' },\n    { name: \'Lazer e Cultura\', icon: Ticket, count: 5, desc: \'Livrarias, bilhetes de teatro, estadias e viagens sustent\303\241veis\' },\n    { name: \'Restaura\303\247\303\243o e Alimenta\303\247\303\243o\', icon: Tag, count: 3, desc: \'Restaurantes saud\303\241veis, cafetarias e cabazes biol\303\263gicos locais\' },\n    { name: \'Forma\303\247\303\243o e Educa\303\247\303\243o\', icon: Award, count: 1, desc: \'Cursos certificados e academias tecnol\303\263gicas online\' },\n    { name: \'Servi\303\247os\', icon: ShieldCheck, count: 4, desc: \'Media\303\247\303\243o de seguros, aluguer de ve\303\255culos e consultoria jur\303\255dica\' },\n  ];\n\n  return (\n    <div className=\"space-y-20 pb-16\">\n      \n      {/* HERO SECTION */}\n      <section className=\"relative overflow-hidden pt-8 pb-16 sm:pt-14 sm:pb-24\">\n        {/* Background glow effects */}\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-red-500/10 rounded-full blur-3xl pointer-events-none -z-10\" />\n\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center max-w-3xl mx-auto space-y-6\">\n            \n            {/* Mission ribbon badge */}\n            <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200/80 text-red-700 text-xs sm:text-sm font-semibold shadow-xs\">\n              <span className=\"w-2 h-2 rounded-full bg-red-600 animate-pulse\" />\n              <span>Liga Portuguesa Contra a SIDA \302\267 Programa de Associados</span>\n            </div>\n\n            {/* Dynamic Calculated Main Title */}\n            <h1 className=\"text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.15]\">\n              Pague <span className=\"text-red-600 underline decoration-red-300 underline-offset-4\">35\342\202\254 por ano</span> e tenha acesso a mais de{\' \'}\n              <span className=\"text-slate-900 bg-red-50 px-2 py-0.5 rounded-xl border border-red-100\">\n                {loading ? \'...\' : `${totalSavings}\342\202\254`}\n              </span>{\' \'}\n              em descontos.\n            </h1>\n\n            <p className=\"text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto\">\n              Apoie uma das causas humanit\303\241rias mais nobres de Portugal e recupere o valor da sua quota logo na primeira ou segunda utiliza\303\247\303\243o em {partnersCount} parceiros certificados de sa\303\272de, desporto, bem-estar e cultura.\n            </p>\n\n            {/* Action Buttons */}\n            <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-center gap-3\">\n              {user ? (\n                <button\n                  onClick={() => onNavigate(\'/parceiros\')}\n                  className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl bg-red-600 text-white font-bold text-sm sm:text-base hover:bg-red-700 shadow-md shadow-red-200 transition-all flex items-center justify-center gap-2\"\n                >\n                  <span>Explorar Todos os Parceiros</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              ) : (\n                <>\n                  <button\n                    onClick={() => onNavigate(\'/registar\')}\n                    className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl bg-red-600 text-white font-bold text-sm sm:text-base hover:bg-red-700 shadow-md shadow-red-200 transition-all flex items-center justify-center gap-2\"\n                  >\n                    <span>Fazer-se S\303\263cio (35\342\202\254/ano)</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'/parceiros\')}\n                    className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white border border-slate-300 text-slate-700 font-semibold text-sm sm:text-base hover:bg-slate-50 transition-colors\"\n                  >\n                    Ver Cat\303\241logo P\303\272blico\n                  </button>\n                </>\n              )}\n            </div>\n\n            {/* Honest usage note */}\n            <p className=\"text-xs text-slate-400 flex items-center justify-center gap-1.5 pt-1\">\n              <Info className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>* Valores calculados com base numa utiliza\303\247\303\243o t\303\255pica anual em parceiros ativos.</span>\n            </p>\n          </div>\n\n          {/* THREE CENTRAL METRICS CARDS */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6 mt-14\">\n            \n            {/* Metric 1 */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs hover:border-red-200 transition-colors\">\n              <div className=\"w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-4\">\n                <Sparkles className=\"w-5 h-5\" />\n              </div>\n              <div className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono tracking-tight\">\n                {loading ? \'...\' : `+${totalSavings}\342\202\254`}\n              </div>\n              <h3 className=\"text-sm font-bold text-slate-800 mt-1\">Total em Descontos Anuais</h3>\n              <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n                Poupan\303\247a acumulada potencial somando os 28 acordos em farm\303\241cias, cl\303\255nicas, desporto e servi\303\247os.\n              </p>\n            </div>\n\n            {/* Metric 2 */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs hover:border-red-200 transition-colors\">\n              <div className=\"w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4\">\n                <TrendingUp className=\"w-5 h-5\" />\n              </div>\n              <div className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono tracking-tight\">\n                {loading ? \'...\' : `${multiplier}x`}\n              </div>\n              <h3 className=\"text-sm font-bold text-slate-800 mt-1\">Multiplicador da Quota</h3>\n              <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n                Por cada 1\342\202\254 investido na quota de 35\342\202\254, acede em m\303\251dia a mais de 45\342\202\254 de valor em vantagens reais.\n              </p>\n            </div>\n\n            {/* Metric 3 */}\n            <div className=\"bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs hover:border-red-200 transition-colors\">\n              <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4\">\n                <Award className=\"w-5 h-5\" />\n              </div>\n              <div className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono tracking-tight\">\n                Basta 1\n              </div>\n              <h3 className=\"text-sm font-bold text-slate-800 mt-1\">Parceiro para Recuperar</h3>\n              <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n                Um \303\272nico exame, pack de fisioterapia, consulta ou desconto no gin\303\241sio j\303\241 ultrapassa os 35\342\202\254 da quota.\n              </p>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* SIDE-BY-SIDE COMPARISON: 35\342\202\254 VS TOTAL SAVINGS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden\">\n          <div className=\"absolute top-0 right-0 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none\" />\n\n          <div className=\"max-w-3xl mb-10\">\n            <span className=\"text-xs font-bold uppercase tracking-widest text-red-400\">Transpar\303\252ncia & Custo Real</span>\n            <h2 className=\"text-2xl sm:text-4xl font-black tracking-tight mt-1\">\n              35\342\202\254 por ano s\303\243o apenas 2,92\342\202\254 por m\303\252s.\n            </h2>\n            <p className=\"text-slate-300 text-sm sm:text-base mt-2\">\n              Menos de um caf\303\251 por semana para pertencer a uma causa solid\303\241ria vital e usufruir de centenas de euros em vantagens diretas.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 items-center\">\n            \n            {/* Left Box: O que investe */}\n            <div className=\"bg-slate-800/80 rounded-2xl p-6 sm:p-8 border border-slate-700/80\">\n              <div className=\"text-xs font-bold uppercase text-slate-400 mb-1\">O seu investimento solid\303\241rio</div>\n              <div className=\"text-4xl sm:text-5xl font-black font-mono text-white\">35,00 \342\202\254<span className=\"text-base text-slate-400 font-normal\"> /ano</span></div>\n              <p className=\"text-xs text-slate-400 mt-2\">\342\211\210 2,92 \342\202\254 / m\303\252s (Quota anual dedut\303\255vel)</p>\n              \n              <ul className=\"mt-6 space-y-3 text-sm text-slate-300\">\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                  <span>Apoio direto aos testes r\303\241pidos de VIH e apoio psicol\303\263gico</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                  <span>Acesso irrestrito a todos os 28 parceiros nacionais</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                  <span>Cart\303\243o de s\303\263cio digital com n\303\272mero oficial LPCS</span>\n                </li>\n              </ul>\n            </div>\n\n            {/* Right Box: O que recebe */}\n            <div className=\"bg-gradient-to-br from-red-950/80 to-slate-800/90 rounded-2xl p-6 sm:p-8 border border-red-500/40 shadow-inner\">\n              <div className=\"text-xs font-bold uppercase text-red-300 mb-1\">O que poupa em m\303\251dia</div>\n              <div className=\"text-4xl sm:text-5xl font-black font-mono text-red-400\">\n                {loading ? \'...\' : `+${totalSavings},00 \342\202\254`}\n              </div>\n              <p className=\"text-xs text-red-200/80 mt-2\">Reparti\303\247\303\243o de poupan\303\247a m\303\251dia por tipo de benef\303\255cio:</p>\n\n              <div className=\"mt-6 space-y-3\">\n                <div className=\"flex items-center justify-between text-xs bg-black/30 p-2.5 rounded-lg border border-red-500/20\">\n                  <span className=\"flex items-center gap-2 text-slate-200\">\n                    <Ticket className=\"w-3.5 h-3.5 text-red-400\" />\n                    <span>Cup\303\265es promocionais (valor fixo \342\202\254)</span>\n                  </span>\n                  <span className=\"font-bold font-mono text-white\">\n                    {stats ? `${Math.round(stats.breakdown.couponSavings)}\342\202\254` : \'418\342\202\254\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-xs bg-black/30 p-2.5 rounded-lg border border-red-500/20\">\n                  <span className=\"flex items-center gap-2 text-slate-200\">\n                    <Award className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>Vouchers nominais (exames/consultas gr\303\241tis)</span>\n                  </span>\n                  <span className=\"font-bold font-mono text-white\">\n                    {stats ? `${Math.round(stats.breakdown.voucherSavings)}\342\202\254` : \'388\342\202\254\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-xs bg-black/30 p-2.5 rounded-lg border border-red-500/20\">\n                  <span className=\"flex items-center gap-2 text-slate-200\">\n                    <Percent className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span>C\303\263digos de desconto percentual cont\303\255nuo</span>\n                  </span>\n                  <span className=\"font-bold font-mono text-white\">\n                    {stats ? `${Math.round(stats.breakdown.codeSavings)}\342\202\254` : \'774\342\202\254\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* TOP BENEFITS SECTION WITH \"PAGA A QUOTA\" BADGE */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between mb-8\">\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Destaques Exclusivos</span>\n            <h2 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n              Benef\303\255cios que sozinhos pagam a quota\n            </h2>\n            <p className=\"text-sm text-slate-500 mt-1\">\n              Conhe\303\247a os parceiros cuja poupan\303\247a anual ultrapassa o valor total da anuidade de 35,00\342\202\254.\n            </p>\n          </div>\n          <button\n            onClick={() => onNavigate(\'/parceiros\')}\n            className=\"mt-4 sm:mt-0 text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1 group\"\n          >\n            <span>Ver todos os 28 parceiros</span>\n            <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {stats?.topBenefits?.map((item) => (\n            <div\n              key={item.id}\n              onClick={() => onNavigate(\'/parceiros\', { search: item.name })}\n              className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-xs hover:border-red-300 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <span className=\"text-[11px] font-semibold px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-600\">\n                    {item.area}\n                  </span>\n                  {item.pays_quota && (\n                    <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1\">\n                      <Sparkles className=\"w-3 h-3 text-emerald-600\" />\n                      <span>Paga a Quota</span>\n                    </span>\n                  )}\n                </div>\n                <h3 className=\"text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors\">\n                  {item.name}\n                </h3>\n                <p className=\"text-xs font-bold text-red-600 mt-1\">\n                  {item.discount_highlight}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-slate-100 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[10px] text-slate-400 uppercase font-semibold block\">Poupan\303\247a Est.</span>\n                  <span className=\"text-base font-mono font-black text-slate-900\">\n                    {item.estimated_annual_savings} \342\202\254/ano\n                  </span>\n                </div>\n                <div className=\"w-8 h-8 rounded-full bg-red-50 text-red-600 flex items-center justify-center\">\n                  <ArrowRight className=\"w-4 h-4\" />\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* ACTIVITY AREAS GRID WITH DIRECT FILTER LINKS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-10\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Cobertura Nacional</span>\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">\n            Vantagens em 6 \303\241reas essenciais do seu dia a dia\n          </h2>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Clique numa das categorias para consultar os parceiros dispon\303\255veis na sua regi\303\243o.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {categories.map((cat) => {\n            const Icon = cat.icon;\n            return (\n              <div\n                key={cat.name}\n                onClick={() => onNavigate(\'/parceiros\', { area: cat.name })}\n                className=\"bg-white rounded-2xl p-6 border border-slate-200 hover:border-red-400 hover:shadow-lg transition-all cursor-pointer group flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition-colors\">\n                      <Icon className=\"w-6 h-6\" />\n                    </div>\n                    <span className=\"text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700\">\n                      {cat.count} parceiros\n                    </span>\n                  </div>\n                  <h3 className=\"text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors\">\n                    {cat.name}\n                  </h3>\n                  <p className=\"text-xs text-slate-500 mt-2 leading-relaxed\">\n                    {cat.desc}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-3 border-t border-slate-100 flex items-center gap-1 text-xs font-bold text-red-600 group-hover:translate-x-1 transition-transform\">\n                  <span>Ver parceiros desta \303\241rea</span>\n                  <ChevronRight className=\"w-3.5 h-3.5\" />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* PLAN COMPARISON SECTION */}\n      <section className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-xl mx-auto mb-10\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Planos de Quota</span>\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">\n            Escolha como prefere apoiar a LPCS\n          </h2>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Ambos os planos conferem estatuto de associado e acesso total aos descontos de todos os parceiros.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          \n          {/* Plan 1: Semestral */}\n          <div className=\"bg-white rounded-3xl p-8 border border-slate-200 shadow-xs flex flex-col justify-between\">\n            <div>\n              <div className=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Plano Semestral</div>\n              <div className=\"text-3xl sm:text-4xl font-black font-mono text-slate-900 mt-2\">\n                17,50 \342\202\254 <span className=\"text-sm text-slate-500 font-normal\">/ 6 meses</span>\n              </div>\n              <p className=\"text-xs text-slate-500 mt-1\">Flexibilidade com renova\303\247\303\243o semestral.</p>\n\n              <ul className=\"mt-6 space-y-3 text-xs sm:text-sm text-slate-600\">\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Acesso a todos os 28 parceiros e descontos</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Emiss\303\243o de c\303\263digos rotativos e vouchers</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Recibos oficiais autom\303\241ticos no portal</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"mt-8\">\n              <button\n                onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n                className=\"w-full py-3 px-4 rounded-xl border border-slate-300 font-bold text-sm text-slate-700 hover:bg-slate-50 transition-colors\"\n              >\n                Aderir ao Plano Semestral\n              </button>\n            </div>\n          </div>\n\n          {/* Plan 2: Anual (Mais Vantajosa) */}\n          <div className=\"bg-gradient-to-b from-red-50/70 to-white rounded-3xl p-8 border-2 border-red-500 shadow-lg relative flex flex-col justify-between\">\n            <div className=\"absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-red-600 text-white text-xs font-extrabold uppercase tracking-wider shadow-sm\">\n              Mais Vantajosa\n            </div>\n\n            <div>\n              <div className=\"text-xs font-bold uppercase tracking-wider text-red-700\">Plano Anual Completo</div>\n              <div className=\"text-3xl sm:text-4xl font-black font-mono text-slate-900 mt-2\">\n                35,00 \342\202\254 <span className=\"text-sm text-slate-500 font-normal\">/ 12 meses</span>\n              </div>\n              <p className=\"text-xs text-red-600 font-medium mt-1\">Equivale a apenas 2,92 \342\202\254 por m\303\252s.</p>\n\n              <ul className=\"mt-6 space-y-3 text-xs sm:text-sm text-slate-700\">\n                <li className=\"flex items-center gap-2 font-medium\">\n                  <Check className=\"w-4 h-4 text-red-600 shrink-0\" />\n                  <span>12 meses de acesso cont\303\255nuo aos descontos</span>\n                </li>\n                <li className=\"flex items-center gap-2 font-medium\">\n                  <Check className=\"w-4 h-4 text-red-600 shrink-0\" />\n                  <span>Acesso ilimitado \303\240 totalidade da poupan\303\247a (+{totalSavings}\342\202\254)</span>\n                </li>\n                <li className=\"flex items-center gap-2 font-medium\">\n                  <Check className=\"w-4 h-4 text-red-600 shrink-0\" />\n                  <span>M\303\241ximo impacto de apoio cont\303\255nuo \303\240 causa LPCS</span>\n                </li>\n                <li className=\"flex items-center gap-2 font-medium\">\n                  <Check className=\"w-4 h-4 text-red-600 shrink-0\" />\n                  <span>Renova\303\247\303\243o acumula validade sobre a data existente</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"mt-8\">\n              <button\n                onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n                className=\"w-full py-3 px-4 rounded-xl bg-red-600 text-white font-bold text-sm hover:bg-red-700 shadow-md shadow-red-200 transition-colors\"\n              >\n                Aderir ao Plano Anual (35\342\202\254)\n              </button>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      {/* FINAL SOLIDARITY + SAVINGS CTA */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-gradient-to-r from-red-600 to-rose-700 rounded-3xl p-8 sm:p-14 text-white text-center space-y-6 shadow-xl relative overflow-hidden\">\n          <div className=\"max-w-2xl mx-auto space-y-4\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 text-white text-xs font-bold\">\n              <Heart className=\"w-3.5 h-3.5 fill-white\" />\n              <span>Juntos na Preven\303\247\303\243o e Solidariedade</span>\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-black tracking-tight leading-snug\">\n              Uma quota que ajuda quem mais precisa e ainda protege a sua carteira.\n            </h2>\n            <p className=\"text-sm sm:text-base text-red-100 leading-relaxed\">\n              Registe-se em menos de 2 minutos. Receba de imediato o seu n\303\272mero de associado e comece hoje mesmo a usufruir dos descontos exclusivos.\n            </p>\n          </div>\n\n          <div className=\"pt-2\">\n            <button\n              onClick={() => onNavigate(user ? \'/dashboard\' : \'/registar\')}\n              className=\"px-8 py-3.5 rounded-xl bg-white text-red-600 font-extrabold text-sm sm:text-base hover:bg-red-50 shadow-lg shadow-black/10 transition-transform active:scale-95\"\n            >\n              {user ? \'Ir para a Minha \303\201rea Pessoal\' : \'Quero Ser Associado LPCS\'}\n            </button>\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n};\n"
    num_lines: 489
    num_bytes: 25381
    line_range_bytes: 25381
  }
}
