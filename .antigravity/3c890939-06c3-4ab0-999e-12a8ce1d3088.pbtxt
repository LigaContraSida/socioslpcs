  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { \n  ShieldCheck, \n  CheckCircle2, \n  XCircle, \n  AlertTriangle, \n  Store, \n  QrCode, \n  Clock, \n  User as UserIcon,\n  HelpCircle\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\nexport const MerchantValidatePage: React.FC = () => {\n  const [referenceCode, setReferenceCode] = useState(\'\');\n  const [sixDigitCode, setSixDigitCode] = useState(\'\');\n  const [merchantName, setMerchantName] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n  const [result, setResult] = useState<any | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setResult(null);\n\n    if (!referenceCode.trim() || !sixDigitCode.trim()) {\n      setError(\'Por favor preencha tanto a refer\303\252ncia de resgate como o c\303\263digo de 6 d\303\255gitos.\');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const res = await fetch(\'/api/benefits/verify-code\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          reference_code: referenceCode.trim(),\n          code: sixDigitCode.trim(),\n          merchant_name: merchantName.trim() || \'Comerciante Parceiro LPCS\',\n        }),\n      });\n\n      const data = await res.json();\n\n      if (!res.ok) {\n        setError(data.error || \'C\303\263digo inv\303\241lido ou n\303\243o foi poss\303\255vel validar.\');\n        setLoading(false);\n        return;\n      }\n\n      setResult(data);\n      setLoading(false);\n      confetti({\n        particleCount: 80,\n        spread: 60,\n        origin: { y: 0.6 },\n      });\n    } catch (err) {\n      console.error(\'Validation error:\', err);\n      setError(\'Erro de liga\303\247\303\243o ao servidor. Verifique a sua liga\303\247\303\243o \303\240 internet.\');\n      setLoading(false);\n    }\n  };\n\n  const handleReset = () => {\n    setReferenceCode(\'\');\n    setSixDigitCode(\'\');\n    setResult(null);\n    setError(null);\n  };\n\n  return (\n    <div className=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n      \n      {/* Top Banner */}\n      <div className=\"text-center space-y-3 mb-8\">\n        <div className=\"w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center mx-auto shadow-md\">\n          <QrCode className=\"w-6 h-6 text-red-500\" />\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n          Validador de Descontos para Comerciantes\n        </h1>\n        <p className=\"text-xs sm:text-sm text-slate-500 max-w-xl mx-auto\">\n          \303\201rea destinada aos colaboradores e caixas dos parceiros comerciais da Liga Portuguesa Contra a SIDA para confer\303\252ncia e consumo de c\303\263digos promocionais.\n        </p>\n      </div>\n\n      {/* Main Validation Card */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl\">\n        \n        {result ? (\n          /* SUCCESS STATE - CODE CONSUMED */\n          <div className=\"space-y-6 text-center\">\n            <div className=\"w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto border-4 border-emerald-50\">\n              <CheckCircle2 className=\"w-9 h-9\" />\n            </div>\n\n            <div>\n              <span className=\"text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n                Desconto Validado & Consumido\n              </span>\n              <h2 className=\"text-2xl font-black text-slate-900 mt-3\">\n                {result.discount_highlight}\n              </h2>\n              <p className=\"text-sm font-bold text-red-600 mt-1\">{result.partner_name}</p>\n              <p className=\"text-xs text-slate-500\">{result.benefit_value}</p>\n            </div>\n\n            {/* Associate identification box */}\n            <div className=\"bg-slate-50 rounded-2xl p-5 border border-slate-200 text-left space-y-2\">\n              <div className=\"text-xs font-bold uppercase text-slate-400\">Dados do Titular da Quota</div>\n              <div className=\"flex items-center justify-between text-sm\">\n                <span className=\"text-slate-500\">Nome do Associado:</span>\n                <span className=\"font-bold text-slate-900\">{result.member_name}</span>\n              </div>\n              <div className=\"flex items-center justify-between text-sm\">\n                <span className=\"text-slate-500\">N\302\272 de S\303\263cio LPCS:</span>\n                <span className=\"font-mono font-bold text-slate-800\">{result.member_number}</span>\n              </div>\n              <div className=\"flex items-center justify-between text-sm\">\n                <span className=\"text-slate-500\">Refer\303\252ncia \303\232nica:</span>\n                <span className=\"font-mono text-xs text-slate-600\">{result.reference_code}</span>\n              </div>\n              <div className=\"flex items-center justify-between text-sm pt-2 border-t border-slate-200\">\n                <span className=\"text-slate-500\">Hora de Consumo:</span>\n                <span className=\"text-xs font-medium text-slate-700\">\n                  {new Date(result.validated_at).toLocaleString(\'pt-PT\')}\n                </span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-800 text-left\">\n              <strong>Aten\303\247\303\243o:</strong> Este c\303\263digo acabou de ser registado no sistema como consumido e n\303\243o poder\303\241 voltar a ser apresentado nem reutilizado.\n            </div>\n\n            <button\n              onClick={handleReset}\n              className=\"w-full py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm transition-colors\"\n            >\n              Validar Outro C\303\263digo\n            </button>\n          </div>\n        ) : (\n          /* FORM TO INPUT CODE */\n          <form onSubmit={handleSubmit} className=\"space-y-6\">\n            \n            {error && (\n              <div className=\"p-4 bg-red-50 border border-red-200 rounded-2xl flex items-start gap-3 text-xs sm:text-sm text-red-700\">\n                <XCircle className=\"w-5 h-5 text-red-600 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"block font-bold\">Valida\303\247\303\243o Recusada:</strong>\n                  <span>{error}</span>\n                </div>\n              </div>\n            )}\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Refer\303\252ncia do Resgate (fornecida pelo s\303\263cio) *\n              </label>\n              <div className=\"relative\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Ex: LPCS-FAR-849102\"\n                  value={referenceCode}\n                  onChange={(e) => setReferenceCode(e.target.value)}\n                  className=\"w-full px-4 py-3 rounded-xl border border-slate-300 font-mono text-base font-semibold tracking-wider text-slate-900 focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500 uppercase\"\n                  required\n                />\n              </div>\n              <span className=\"text-[11px] text-slate-400 mt-1 block\">\n                Encontra-se vis\303\255vel no topo do ecr\303\243 do associado (formato LPCS-XXX-XXXXXX).\n              </span>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                C\303\263digo Rotativo de 6 D\303\255gitos *\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"123456\"\n                maxLength={6}\n                value={sixDigitCode}\n                onChange={(e) => setSixDigitCode(e.target.value.replace(/\\D/g, \'\'))}\n                className=\"w-full px-4 py-3 rounded-xl border border-slate-300 font-mono text-2xl font-black tracking-widest text-center text-slate-900 focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n                required\n              />\n              <span className=\"text-[11px] text-slate-400 mt-1 block text-center\">\n                C\303\263digo din\303\242mico que muda a cada 30 segundos no telem\303\263vel do associado.\n              </span>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Identifica\303\247\303\243o do Estabelecimento / Caixa (Opcional)\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex: Farm\303\241cia Sa\303\272de+ Loja Chiado (Caixa 2)\"\n                value={merchantName}\n                onChange={(e) => setMerchantName(e.target.value)}\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm shadow-md shadow-red-200 transition-all flex items-center justify-center gap-2\"\n            >\n              {loading ? (\n                <>\n                  <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                  <span>A validar no sistema...</span>\n                </>\n              ) : (\n                <>\n                  <ShieldCheck className=\"w-4 h-4\" />\n                  <span>Conferir e Consumir Desconto</span>\n                </>\n              )}\n            </button>\n\n          </form>\n        )}\n\n        {/* Informative Security Tips for merchants */}\n        <div className=\"mt-8 pt-6 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-500\">\n          <div className=\"flex items-start gap-2\">\n            <Clock className=\"w-4 h-4 text-slate-400 shrink-0 mt-0.5\" />\n            <p>\n              <strong>Janela de 30s:</strong> O sistema aceita a janela atual e a anterior para toler\303\242ncia de rel\303\263gio. Se expirar, pe\303\247a ao associado para ler o novo n\303\272mero.\n            </p>\n          </div>\n          <div className=\"flex items-start gap-2\">\n            <Store className=\"w-4 h-4 text-slate-400 shrink-0 mt-0.5\" />\n            <p>\n              <strong>Uso \303\232nico:</strong> Cada c\303\263digo \303\251 consumido instantaneamente e impede que capturas de ecr\303\243 sejam reutilizadas.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/MerchantValidatePage.tsx"
        }
        overwrite: true
      }
    }
