  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Helvetica Neue\", Helvetica, \"Nimbus Sans\", Arial, sans-serif;\n  --font-display: \"Helvetica Neue\", Helvetica, \"Nimbus Sans\", Arial, sans-serif;\n  --font-mono: \"Helvetica Neue\", Helvetica, ui-monospace, SFMono-Regular, Menlo, monospace;\n\n  --color-paper: #FAF8F5;\n  --color-paper-warm: #F3EFE8;\n  --color-ink: #141619;\n  --color-crimson: #E31E24;\n  --color-crimson-dark: #B91C1C;\n}\n\n@layer base {\n  html {\n    font-family: \"Helvetica Neue\", Helvetica, \"Nimbus Sans\", Arial, sans-serif;\n    scroll-behavior: smooth;\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: \"Helvetica Neue\", Helvetica, \"Nimbus Sans\", Arial, sans-serif;\n  }\n}\n\n.font-helvetica-light {\n  font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  font-weight: 300;\n}\n\n.font-helvetica-condensed {\n  font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  font-stretch: condensed;\n  letter-spacing: -0.02em;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n.text-balance {\n  text-wrap: balance;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n"
