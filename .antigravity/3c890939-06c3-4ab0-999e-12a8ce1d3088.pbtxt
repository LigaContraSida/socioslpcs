      thinking_signature: "\022\257\t\n\254\t\001i\024}\023\360b{\370\324\25799\221\374\265\361\333\264\240\016\032\352]\275\210\023>1\231gTz\361s\342\332@\214]e\235\277[\326\0242pO13$\266\236\373\276I8\257\353\271\341;\371\251\365.U,\016\3760J\vC\371\203\322\375\301\353\0342\215\021+\352\257Y2\335\006$N\242P\\\'\034\302\321\000\240\233q\212,\362F|\034\374\226\324\242~R\332Sv\271\236Q\240(\326\364\207\207b*\31199u\300\026+i\313\326\000\306\346\307\202\346\252g\371\361\236;\0271\350\256\251rI\002\361\366\252&\345#\3245\237e\376*\236\232\310\002\307I\301l\352\322>\374-\250\232\a\002\254\3729K\226e\202\313!}\f\335\t\247\001\317X\302J33\003FglO/_\304\252BCm\331|c\004j^\317\307\231\361)\307\243t\'s\3646\356\245C\203[}\270to\353\367\373\252\212\236\304=\241\330}~\225ss\346-\335\327\307\032g\022\273\243 \356P\346\247\220\035\365\274\270\023\351\362\300\206\364\275\364\"\032\3421\n\376\365\331\343\305\340\264\257aq\376\302\327D0\271]\256\036\376\244\324\vz\"P\246\373\211G\354\371xE\0211\233x\272\350r\031\332xw7\270kW\340\374u~\312\274{p\304\347\371\244\262\310\320\267t[\276u|\320\340\221\371h\242\275\327\034\306@\271X(\001\257a\023\244c\021#\264XGE0\326\3309Z\02577\241!4uYy\233\006T*\021\001|\320\351\356\310\230\340\231|\263\240\214y\305\245V_\370!\322\272\022\307\000\201\021\361W\263ZY\236\037\214\373#\355\323\212\253$\370\244\311\236\214(\201\317I(\331\036g\341Oux\261e\311\n\253\230K\345\316\02562\332ar\213\230\371o\022%lh&j\240\225-\b`9\356\t\332\241\267\250s\333\023\227\275\340\203\307\006\232R(\364\276\272}\251\276\363\227\363\353\307\302M\312\207o\360\365\301(sWB\276\207z!\031\324\327\313$oa[\202kq1\326\256\267\263M\372Ts\307\ay\333\220\250\300?G\235\352x\310\263\377\247sg@\006\215\311\006\231\201\225\\\325e\324\234\323)3\244\026\024(\257\217\237\022\027\226P\255=\317\216\242ZL\312-h\254\217% \032\324\377\317\337\342\236\037\371\270\231\310\323\262\307[k{\206\2353\212\325\211\220\2011\251\235H\006_\341\036b\204\246\367?QyV0\002\217\321$\344\022\363+}Q\323\030\353\0357T#\346{fc\006\024\027E\20541\001\247}\256X\220\303\3620\246\322P\342\341\375\363\006m\032\255\344\323\316\310\331\361TF\343{3\315l\251\271\n0\221\204H\2601\207)1\224\361\216\333a\2773\\KIn\377\036/Q\022\022\326\374-BW\323h<I8\314\252\356\214\3253\020y\343V\017Q\031\361_\3058aq\317\344\377\006>\230\"\313/\274\351\r\236\276\016\326F\213\3513C\240@f\217\367\2024\330Zu\375\006\'\242XH\037\330\354\333\235M\'\2572\001v\303\374\030*|a\225 Z\247<\370\337\020\307\335\tyG6A\303:35I%uVv\356Y\035\327\005\375]\267\202H\200(\372=\373[\366\317\353\341\367\220\370\310\342\017\203\373E\227\3173\310!*C\274\347\273\205\336\277\'\2467TJ\267\001\242!H\256\307\r\274hBE\231I\247\036\266\371\366JQM75\215\272QD\374\322\304\276}\237\351\335B\330\006\276\372\330@\305F\2146\245\263w\241\307\0052\242\004\261*\tRym\3151Og\223nD\304\2015\302\347\260\225\310\v\340\351\352e\030\276Xv\224Q\321<\017_`\207\a\256\302\246\246\370\270E\315;\205\377\322o\367=\264]\276e\216Q\3500\0200\2232|\373\031B\207\233\214\331\314\3541Q\201\027im\365\314\324:q\027\313,\020\016vB\305\235\227\352\r\006\323@\333^0\267o\324c\347JY6\326\034}7w\vcM\250P\027\375P\255\306\236\016B\210\245\320Y2/\300\211\244?\023\2158\317M\b\255\365\310wX\366\275\376Uf\373\227@\032MFY\367\371\342\360\033\321\355\035\317zU\0371\343i\377\027\265\003\361\263\002zo[\353\253\221^\355\354B;\202\365\201\322)\212:\304\'\213\375=\2008\351\200<i\352g\275h\323\337\355\024I\263\227"
