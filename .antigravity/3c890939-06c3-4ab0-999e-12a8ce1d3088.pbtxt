      arguments_json: "{\"CodeContent\":\"export interface QuotaStatus {\\n  has_active_quota: boolean;\\n  status: \'valida\' | \'expirar\' | \'expirada\' | \'sem_quota\';\\n  valid_until: string | null;\\n  days_remaining: number;\\n  days_expired: number;\\n  progress_percentage: number;\\n  total_paid_count: number;\\n  total_paid_euros: number;\\n}\\n\\nexport interface User {\\n  id: number;\\n  email: string;\\n  name: string;\\n  member_number: string;\\n  is_admin: number;\\n  is_suspended: number;\\n  birth_date: string;\\n  address: string;\\n  postal_code: string;\\n  city: string;\\n  nif: string;\\n  phone: string;\\n  google_id?: string | null;\\n  quota_status: QuotaStatus;\\n}\\n\\nexport interface Partner {\\n  id: number;\\n  name: string;\\n  category: string;\\n  description: string;\\n  area: string;\\n  district: string;\\n  city: string;\\n  benefit_type: \'cupao\' | \'codigo\' | \'voucher\';\\n  benefit_value: string;\\n  discount_highlight: string;\\n  usage_limit: string;\\n  estimated_annual_savings: number;\\n  valid_until: string;\\n  terms: string;\\n  website?: string;\\n  secret_code?: string | null;\\n  can_access_code: boolean;\\n}\\n\\nexport interface Quota {\\n  id: number;\\n  user_id: number;\\n  plan_type: \'semestral\' | \'anual\';\\n  amount_cents: number;\\n  payment_method: string;\\n  reference: string;\\n  status: string;\\n  valid_from: string;\\n  valid_until: string;\\n  created_at: string;\\n}\\n\\nexport interface Receipt {\\n  id: number;\\n  quota_id?: number | null;\\n  original_name: string;\\n  mime_type: string;\\n  file_size: number;\\n  notes?: string;\\n  created_at: string;\\n}\\n\\nexport interface HeroStats {\\n  totalSavings: number;\\n  annualQuotaCost: number;\\n  savingsMultiplier: number;\\n  partnersCount: number;\\n  partnersPayingQuotaCount: number;\\n  breakdown: {\\n    couponSavings: number;\\n    voucherSavings: number;\\n    codeSavings: number;\\n  };\\n  topBenefits: Array<{\\n    id: number;\\n    name: string;\\n    area: string;\\n    benefit_type: string;\\n    estimated_annual_savings: number;\\n    discount_highlight: string;\\n    pays_quota: boolean;\\n  }>;\\n}\\n\\nexport interface AuditLog {\\n  id: number;\\n  user_id?: number;\\n  user_name?: string;\\n  member_number?: string;\\n  action: string;\\n  details: string;\\n  ip_address?: string;\\n  user_agent?: string;\\n  created_at: string;\\n}\\n\", \"Description\":\"TypeScript interface definitions for LPCS portal\", \"Overwrite\":true, \"TargetFile\":\"/src/types.ts\", \"toolAction\":\"Creating types definition\", \"toolSummary\":\"Create types.ts for data models\"}"
