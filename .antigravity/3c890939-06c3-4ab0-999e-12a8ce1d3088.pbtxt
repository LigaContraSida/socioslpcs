      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add partner_inquiries table to SQLite schema\", \"EndLine\":117, \"Instruction\":\"Add partner_inquiries table creation inside initDb in src/server/db.ts\", \"ReplacementContent\":\"    CREATE TABLE IF NOT EXISTS audit_logs (\\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\\n      user_id INTEGER REFERENCES users(id) ON DELETE SET NULL,\\n      action TEXT NOT NULL, -- \'emissao_codigo\' | \'visualizacao_codigo\' | \'validacao_sucesso\' | \'validacao_falha\' | \'quota_paga\' | \'perfil_atualizado\'\\n      details TEXT NOT NULL,\\n      ip_address TEXT,\\n      user_agent TEXT,\\n      created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS partner_inquiries (\\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\\n      company_name TEXT NOT NULL,\\n      nif TEXT,\\n      contact_name TEXT NOT NULL,\\n      email TEXT NOT NULL,\\n      phone TEXT NOT NULL,\\n      area TEXT NOT NULL,\\n      district TEXT NOT NULL,\\n      city TEXT NOT NULL,\\n      benefit_type TEXT NOT NULL,\\n      proposed_benefit TEXT NOT NULL,\\n      website TEXT,\\n      notes TEXT,\\n      status TEXT NOT NULL DEFAULT \'pendente\', -- \'pendente\' | \'em_analise\' | \'aprovada\' | \'recusada\'\\n      created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))\\n    );\\n\\n    CREATE INDEX IF NOT EXISTS idx_sessions_token ON sessions(token);\\n    CREATE INDEX IF NOT EXISTS idx_quotas_user ON quotas(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_receipts_user ON receipts(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_redemptions_ref ON redemptions(reference_code);\\n    CREATE INDEX IF NOT EXISTS idx_redemptions_user ON redemptions(user_id, partner_id);\\n  `);\", \"StartLine\":101, \"TargetContent\":\"    CREATE TABLE IF NOT EXISTS audit_logs (\\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\\n      user_id INTEGER REFERENCES users(id) ON DELETE SET NULL,\\n      action TEXT NOT NULL, -- \'emissao_codigo\' | \'visualizacao_codigo\' | \'validacao_sucesso\' | \'validacao_falha\' | \'quota_paga\' | \'perfil_atualizado\'\\n      details TEXT NOT NULL,\\n      ip_address TEXT,\\n      user_agent TEXT,\\n      created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))\\n    );\\n\\n    CREATE INDEX IF NOT EXISTS idx_sessions_token ON sessions(token);\\n    CREATE INDEX IF NOT EXISTS idx_quotas_user ON quotas(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_receipts_user ON receipts(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_redemptions_ref ON redemptions(reference_code);\\n    CREATE INDEX IF NOT EXISTS idx_redemptions_user ON redemptions(user_id, partner_id);\\n  `);\", \"TargetFile\":\"/src/server/db.ts\", \"toolAction\":\"Adding partner_inquiries table\", \"toolSummary\":\"Add partner_inquiries table to db.ts\"}"
