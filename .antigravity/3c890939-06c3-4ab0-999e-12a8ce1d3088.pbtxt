  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 256
    content: "import React, { useState } from \'react\';\nimport { User } from \'../types.ts\';\nimport { \n  ShieldCheck, \n  User as UserIcon, \n  CreditCard, \n  Tag, \n  LogOut, \n  Menu, \n  X, \n  Lock, \n  CheckCircle2, \n  AlertTriangle, \n  XCircle,\n  QrCode,\n  Building2\n} from \'lucide-react\';\n\ninterface HeaderProps {\n  user: User | null;\n  isAdmin: boolean;\n  currentPath: string;\n  onNavigate: (path: string) => void;\n  onLogout: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  user,\n  isAdmin,\n  currentPath,\n  onNavigate,\n  onLogout,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const getStatusBadge = () => {\n    if (!user) return null;\n    const status = user.quota_status.status;\n    if (status === \'valida\') {\n      return (\n        <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n          <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n          <span>Quota Ativa ({user.quota_status.days_remaining}d)</span>\n        </span>\n      );\n    }\n    if (status === \'expirar\') {\n      return (\n        <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-300\">\n          <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600 animate-pulse\" />\n          <span>A Expirar ({user.quota_status.days_remaining}d)</span>\n        </span>\n      );\n    }\n    if (status === \'expirada\') {\n      return (\n        <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200\">\n          <XCircle className=\"w-3.5 h-3.5 text-red-600\" />\n          <span>Quota Expirada ({user.quota_status.days_expired}d)</span>\n        </span>\n      );\n    }\n    return (\n      <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200\">\n        <span>Sem Quota</span>\n      </span>\n    );\n  };\n\n  const navLinks = [\n    { name: \'In\303\255cio\', path: \'/\' },\n    { name: \'Parceiros\', path: \'/parceiros\', icon: Tag },\n    { name: \'Quero Fazer Parceria\', path: \'/parceria\', icon: Building2 },\n    ...(user ? [\n      { name: \'\303\201rea Pessoal\', path: \'/dashboard\', icon: UserIcon },\n      { name: \'Pagamentos\', path: \'/pagamentos\', icon: CreditCard },\n      { name: \'Perfil\', path: \'/perfil\' },\n    ] : []),\n    { name: \'Validar C\303\263digo\', path: \'/validar\', icon: QrCode },\n    ...(isAdmin ? [{ name: \'Backoffice\', path: \'/admin\', icon: ShieldCheck, highlight: true }] : []),\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-20\">\n          \n          {/* Logo & Identity */}\n          <div \n            onClick={() => onNavigate(\'/\')}\n            className=\"flex items-center gap-3.5 cursor-pointer group\"\n          >\n            {/* Red Ribbon Symbol */}\n            <div className=\"w-11 h-11 rounded-xl bg-red-600 flex items-center justify-center text-white shadow-md shadow-red-200 group-hover:scale-105 transition-transform duration-200\">\n              <svg className=\"w-7 h-7 fill-white\" viewBox=\"0 0 24 24\">\n                <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n              </svg>\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-extrabold text-slate-900 tracking-tight text-lg sm:text-xl\">LPCS</span>\n                <span className=\"hidden sm:inline-block text-xs uppercase tracking-widest font-semibold px-2 py-0.5 rounded bg-red-100 text-red-800\">\n                  Associados\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 font-medium\">Liga Portuguesa Contra a SIDA</p>\n            </div>\n          </div>\n\n          {/* Desktop Navigation Links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2\">\n            {navLinks.map((link) => {\n              const active = currentPath === link.path;\n              return (\n                <button\n                  key={link.path}\n                  onClick={() => onNavigate(link.path)}\n                  className={`px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 ${\n                    active\n                      ? \'bg-red-50 text-red-700 font-semibold\'\n                      : link.highlight\n                      ? \'text-purple-700 hover:bg-purple-50 font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100\'\n                  }`}\n                >\n                  {link.icon && <link.icon className=\"w-4 h-4\" />}\n                  <span>{link.name}</span>\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* User Status / Login Buttons */}\n          <div className=\"hidden md:flex items-center gap-3\">\n            {user ? (\n              <div className=\"flex items-center gap-3\">\n                <div className=\"text-right\">\n                  <div className=\"flex items-center justify-end gap-2\">\n                    <span className=\"text-sm font-bold text-slate-800\">{user.name.split(\' \')[0]}</span>\n                    {getStatusBadge()}\n                  </div>\n                  <div className=\"text-xs text-slate-500 font-mono\">{user.member_number}</div>\n                </div>\n\n                <button\n                  onClick={onLogout}\n                  title=\"Terminar Sess\303\243o\"\n                  className=\"p-2 rounded-lg text-slate-500 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                >\n                  <LogOut className=\"w-5 h-5\" />\n                </button>\n              </div>\n            ) : (\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => onNavigate(\'/entrar\')}\n                  className=\"px-4 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors\"\n                >\n                  Entrar\n                </button>\n                <button\n                  onClick={() => onNavigate(\'/registar\')}\n                  className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-red-600 text-white hover:bg-red-700 shadow-xs shadow-red-200 transition-all hover:shadow-md\"\n                >\n                  Fazer-se S\303\263cio\n                </button>\n              </div>\n            )}\n          </div>\n\n          {/* Mobile menu button */}\n          <div className=\"flex lg:hidden items-center gap-2\">\n            {user && getStatusBadge()}\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-hidden\"\n              aria-label=\"Abrir menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Mobile Menu Dropdown */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 space-y-2 shadow-lg\">\n          {user && (\n            <div className=\"p-3 bg-slate-50 rounded-xl mb-3 border border-slate-200 flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-bold text-slate-900\">{user.name}</p>\n                <p className=\"text-xs text-slate-500 font-mono\">{user.member_number}</p>\n              </div>\n              <div>{getStatusBadge()}</div>\n            </div>\n          )}\n\n          {navLinks.map((link) => (\n            <button\n              key={link.path}\n              onClick={() => {\n                onNavigate(link.path);\n                setMobileMenuOpen(false);\n              }}\n              className={`w-full text-left px-3 py-2.5 rounded-lg text-sm font-medium flex items-center gap-2.5 ${\n                currentPath === link.path\n                  ? \'bg-red-50 text-red-700 font-semibold\'\n                  : \'text-slate-700 hover:bg-slate-50\'\n              }`}\n            >\n              {link.icon && <link.icon className=\"w-4 h-4\" />}\n              <span>{link.name}</span>\n            </button>\n          ))}\n\n          <div className=\"pt-3 border-t border-slate-100\">\n            {user ? (\n              <button\n                onClick={() => {\n                  onLogout();\n                  setMobileMenuOpen(false);\n                }}\n                className=\"w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold text-red-600 hover:bg-red-50 flex items-center gap-2\"\n              >\n                <LogOut className=\"w-4 h-4\" />\n                <span>Terminar Sess\303\243o</span>\n              </button>\n            ) : (\n              <div className=\"grid grid-cols-2 gap-2 pt-1\">\n                <button\n                  onClick={() => {\n                    onNavigate(\'/entrar\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"w-full text-center py-2 px-3 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700\"\n                >\n                  Entrar\n                </button>\n                <button\n                  onClick={() => {\n                    onNavigate(\'/registar\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"w-full text-center py-2 px-3 rounded-lg bg-red-600 text-white text-sm font-semibold\"\n                >\n                  Fazer-se S\303\263cio\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    num_lines: 257
    num_bytes: 10027
    line_range_bytes: 10027
  }
}
