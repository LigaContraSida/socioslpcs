  view_file {
    absolute_path_uri: "file:///src/pages/PaymentsPage.tsx"
    end_line: 385
    content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { User, Quota, Receipt } from \'../types.ts\';\nimport { \n  CreditCard, \n  Upload, \n  FileText, \n  Download, \n  Trash2, \n  CheckCircle2, \n  XCircle, \n  AlertCircle,\n  Clock,\n  Euro,\n  FileCheck,\n  ShieldCheck,\n  Plus\n} from \'lucide-react\';\n\ninterface PaymentsPageProps {\n  user: User;\n  onRefreshUser: () => void;\n}\n\nexport const PaymentsPage: React.FC<PaymentsPageProps> = ({ user, onRefreshUser }) => {\n  const [quotas, setQuotas] = useState<Quota[]>([]);\n  const [receipts, setReceipts] = useState<Receipt[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  // Upload Form state\n  const [selectedFile, setSelectedFile] = useState<File | null>(null);\n  const [selectedQuotaId, setSelectedQuotaId] = useState<string>(\'\');\n  const [receiptNotes, setReceiptNotes] = useState<string>(\'\');\n  const [uploading, setUploading] = useState(false);\n  const [uploadSuccess, setUploadSuccess] = useState<string | null>(null);\n  const [uploadError, setUploadError] = useState<string | null>(null);\n\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const loadData = () => {\n    setLoading(true);\n    fetch(\'/api/quotas/history\')\n      .then((res) => res.json())\n      .then((data) => {\n        setQuotas(data.quotas || []);\n        setReceipts(data.receipts || []);\n        setLoading(false);\n      })\n      .catch((err) => {\n        console.error(\'Error loading payments:\', err);\n        setLoading(false);\n      });\n  };\n\n  useEffect(() => {\n    loadData();\n  }, []);\n\n  const handleUploadSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedFile) {\n      setUploadError(\'Por favor selecione um ficheiro para enviar.\');\n      return;\n    }\n\n    setUploading(true);\n    setUploadSuccess(null);\n    setUploadError(null);\n\n    const formData = new FormData();\n    formData.append(\'receipt_file\', selectedFile);\n    if (selectedQuotaId) {\n      formData.append(\'quota_id\', selectedQuotaId);\n    }\n    if (receiptNotes.trim()) {\n      formData.append(\'notes\', receiptNotes.trim());\n    }\n\n    try {\n      const res = await fetch(\'/api/receipts/upload\', {\n        method: \'POST\',\n        body: formData,\n      });\n      const data = await res.json();\n\n      if (!res.ok) {\n        setUploadError(data.error || \'Erro no envio do recibo.\');\n        setUploading(false);\n        return;\n      }\n\n      setUploadSuccess(\'Recibo arquivado com sucesso no portal!\');\n      setSelectedFile(null);\n      setReceiptNotes(\'\');\n      setSelectedQuotaId(\'\');\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\n      setUploading(false);\n      loadData();\n    } catch (err) {\n      console.error(\'Upload error:\', err);\n      setUploadError(\'Falha ao comunicar com o servidor.\');\n      setUploading(false);\n    }\n  };\n\n  const handleDeleteReceipt = async (receiptId: number) => {\n    if (!window.confirm(\'Tem a certeza que deseja remover este recibo do seu arquivo?\')) return;\n\n    try {\n      const res = await fetch(`/api/receipts/${receiptId}`, { method: \'DELETE\' });\n      if (res.ok) {\n        setReceipts((prev) => prev.filter((r) => r.id !== receiptId));\n      }\n    } catch (err) {\n      console.error(\'Delete error:\', err);\n    }\n  };\n\n  const totalPaidEuros = quotas.reduce((acc, q) => acc + q.amount_cents / 100, 0);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10\">\n      \n      {/* Top Page Header */}\n      <div>\n        <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Gest\303\243o Financeira & Arquivo</span>\n        <h1 className=\"text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">\n          Pagamentos & Recibos de Quotas\n        </h1>\n        <p className=\"text-sm text-slate-500 mt-1 max-w-2xl\">\n          Consulte o seu hist\303\263rico completo de regulariza\303\247\303\243o de quotas, descarregue os recibos oficiais LPCS e anexe comprovativos banc\303\241rios adicionais.\n        </p>\n      </div>\n\n      {/* THREE SUMMARY STATS CARDS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n        \n        <div className=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center shrink-0\">\n            <CreditCard className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"text-xs font-bold uppercase text-slate-400\">Total de Pagamentos</div>\n            <div className=\"text-2xl font-black font-mono text-slate-900\">{quotas.length} efetuados</div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0\">\n            <Euro className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"text-xs font-bold uppercase text-slate-400\">Total Pago Acumulado</div>\n            <div className=\"text-2xl font-black font-mono text-slate-900\">{totalPaidEuros.toFixed(2)} \342\202\254</div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-3xl border border-slate-200 shadow-xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0\">\n            <FileCheck className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"text-xs font-bold uppercase text-slate-400\">Recibos em Arquivo</div>\n            <div className=\"text-2xl font-black font-mono text-slate-900\">{receipts.length} documentos</div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* UPLOAD RECEIPT SECTION */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-6\">\n        <div>\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Arquivo Digital Seguro</span>\n          <h2 className=\"text-xl font-bold text-slate-900 mt-1\">\n            Anexar Novo Recibo ou Comprovativo\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Suporta ficheiros PDF, PNG, JPG ou WEBP at\303\251 ao limite m\303\241ximo de 5 MB. Apenas acess\303\255vel por si e pela administra\303\247\303\243o da LPCS.\n          </p>\n        </div>\n\n        {uploadSuccess && (\n          <div className=\"p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-xs sm:text-sm text-emerald-800\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n            <span>{uploadSuccess}</span>\n          </div>\n        )}\n\n        {uploadError && (\n          <div className=\"p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3 text-xs sm:text-sm text-red-700\">\n            <XCircle className=\"w-5 h-5 text-red-600 shrink-0\" />\n            <span>{uploadError}</span>\n          </div>\n        )}\n\n        <form onSubmit={handleUploadSubmit} className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            \n            {/* File input */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase text-slate-700 mb-1\">\n                Ficheiro (PDF ou Imagem) *\n              </label>\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\".pdf,.png,.jpg,.jpeg,.webp\"\n                onChange={(e) => setSelectedFile(e.target.files?.[0] || null)}\n                className=\"w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-red-50 file:text-red-700 hover:file:bg-red-100 cursor-pointer\"\n                required\n              />\n              {selectedFile && (\n                <span className=\"text-[11px] text-slate-400 mt-1 block\">\n                  Selecionado: {selectedFile.name} ({(selectedFile.size / 1024).toFixed(1)} KB)\n                </span>\n              )}\n            </div>\n\n            {/* Associate with specific quota */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase text-slate-700 mb-1\">\n                Associar a Pagamento (Opcional)\n              </label>\n              <select\n                value={selectedQuotaId}\n                onChange={(e) => setSelectedQuotaId(e.target.value)}\n                className=\"w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 focus:outline-hidden focus:border-red-500\"\n              >\n                <option value=\"\">Nenhum pagamento espec\303\255fico</option>\n                {quotas.map((q) => (\n                  <option key={q.id} value={q.id}>\n                    {new Date(q.created_at).toLocaleDateString(\'pt-PT\')} \302\267 Quota {q.plan_type} ({(q.amount_cents / 100).toFixed(2)}\342\202\254)\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Notes */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase text-slate-700 mb-1\">\n                Nota / Descri\303\247\303\243o (Opcional)\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"Ex: Comprovativo transfer\303\252ncia banc\303\241ria Millennium\"\n                value={receiptNotes}\n                onChange={(e) => setReceiptNotes(e.target.value)}\n                className=\"w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={uploading || !selectedFile}\n            className=\"px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 disabled:opacity-50 text-white font-bold text-xs shadow-xs transition-all flex items-center justify-center gap-2\"\n          >\n            {uploading ? (\n              <>\n                <div className=\"w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                <span>A enviar ficheiro...</span>\n              </>\n            ) : (\n              <>\n                <Upload className=\"w-4 h-4\" />\n                <span>Arquivar Comprovativo</span>\n              </>\n            )}\n          </button>\n        </form>\n      </div>\n\n      {/* RECEIPTS ARCHIVE TABLE */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4\">\n        <h3 className=\"text-base font-bold text-slate-900\">Arquivo de Recibos Pessoais</h3>\n\n        {receipts.length === 0 ? (\n          <div className=\"p-8 text-center text-slate-400 text-xs\">\n            Nenhum recibo arquivado at\303\251 ao momento.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs text-slate-600\">\n              <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400\">\n                <tr>\n                  <th className=\"py-2.5 px-3\">Data de Arquivo</th>\n                  <th className=\"py-2.5 px-3\">Nome do Ficheiro</th>\n                  <th className=\"py-2.5 px-3\">Tamanho</th>\n                  <th className=\"py-2.5 px-3\">Notas</th>\n                  <th className=\"py-2.5 px-3 text-right\">A\303\247\303\265es</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 font-medium\">\n                {receipts.map((r) => (\n                  <tr key={r.id} className=\"hover:bg-slate-50/60 transition-colors\">\n                    <td className=\"py-3 px-3\">\n                      {new Date(r.created_at).toLocaleDateString(\'pt-PT\')}\n                    </td>\n                    <td className=\"py-3 px-3 font-semibold text-slate-900 flex items-center gap-2\">\n                      <FileText className=\"w-4 h-4 text-red-500 shrink-0\" />\n                      <span className=\"truncate max-w-xs\">{r.original_name}</span>\n                    </td>\n                    <td className=\"py-3 px-3 font-mono text-slate-500\">\n                      {(r.file_size / 1024).toFixed(1)} KB\n                    </td>\n                    <td className=\"py-3 px-3 text-slate-500 max-w-xs truncate\">\n                      {r.notes || \'\342\200\224\'}\n                    </td>\n                    <td className=\"py-3 px-3 text-right space-x-2\">\n                      <a\n                        href={`/api/receipts/${r.id}`}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-[11px] font-bold transition-colors\"\n                      >\n                        <Download className=\"w-3.5 h-3.5\" />\n                        <span>Ver / Descarregar</span>\n                      </a>\n                      <button\n                        onClick={() => handleDeleteReceipt(r.id)}\n                        className=\"inline-flex items-center p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                        title=\"Remover recibo\"\n                      >\n                        <Trash2 className=\"w-4 h-4\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* FULL QUOTAS HISTORY TABLE */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4\">\n        <h3 className=\"text-base font-bold text-slate-900\">Hist\303\263rico Completo de Quotas</h3>\n\n        {loading ? (\n          <p className=\"text-xs text-slate-400 py-4\">A carregar registos...</p>\n        ) : quotas.length === 0 ? (\n          <p className=\"text-xs text-slate-500 py-4\">Nenhum pagamento registado.</p>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs text-slate-600\">\n              <thead className=\"bg-slate-50 text-[11px] uppercase font-bold text-slate-400\">\n                <tr>\n                  <th className=\"py-2.5 px-3\">Data</th>\n                  <th className=\"py-2.5 px-3\">Plano</th>\n                  <th className=\"py-2.5 px-3\">Valor</th>\n                  <th className=\"py-2.5 px-3\">M\303\251todo</th>\n                  <th className=\"py-2.5 px-3\">Refer\303\252ncia</th>\n                  <th className=\"py-2.5 px-3\">Per\303\255odo V\303\241lido</th>\n                  <th className=\"py-2.5 px-3 text-right\">Estado</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 font-medium\">\n                {quotas.map((q) => (\n                  <tr key={q.id}>\n                    <td className=\"py-3 px-3\">{new Date(q.created_at).toLocaleDateString(\'pt-PT\')}</td>\n                    <td className=\"py-3 px-3 font-semibold text-slate-900 capitalize\">{q.plan_type}</td>\n                    <td className=\"py-3 px-3 font-mono font-bold text-slate-900\">\n                      {(q.amount_cents / 100).toFixed(2)} \342\202\254\n                    </td>\n                    <td className=\"py-3 px-3 uppercase text-slate-500\">{q.payment_method}</td>\n                    <td className=\"py-3 px-3 font-mono text-[11px] text-slate-600\">{q.reference}</td>\n                    <td className=\"py-3 px-3 font-mono text-slate-700\">\n                      {q.valid_from} at\303\251 {q.valid_until}\n                    </td>\n                    <td className=\"py-3 px-3 text-right\">\n                      <span className=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800\">\n                        {q.status}\n                      </span>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n    </div>\n  );\n};\n"
    num_lines: 386
    num_bytes: 15904
    line_range_bytes: 15904
  }
}
