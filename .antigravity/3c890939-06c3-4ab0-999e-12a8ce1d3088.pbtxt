  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { Partner, User } from \'../types.ts\';\nimport { CodeModal } from \'../components/CodeModal.tsx\';\nimport { \n  Search, \n  MapPin, \n  Tag, \n  Ticket, \n  Percent, \n  Lock, \n  Sparkles, \n  X, \n  ExternalLink, \n  ChevronRight,\n  ShieldAlert,\n  AlertCircle,\n  HelpCircle,\n  Layers\n} from \'lucide-react\';\n\ninterface PartnersPageProps {\n  user: User | null;\n  initialQuery?: Record<string, string>;\n  onNavigate: (path: string) => void;\n}\n\nexport const PartnersPage: React.FC<PartnersPageProps> = ({ user, initialQuery, onNavigate }) => {\n  const [partners, setPartners] = useState<Partner[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Filters state\n  const [selectedArea, setSelectedArea] = useState<string>(initialQuery?.area || \'all\');\n  const [selectedDistrict, setSelectedDistrict] = useState<string>(\'all\');\n  const [selectedCity, setSelectedCity] = useState<string>(\'all\');\n  const [selectedBenefitType, setSelectedBenefitType] = useState<string>(\'all\');\n  const [search, setSearch] = useState<string>(initialQuery?.search || \'\');\n\n  // Filter metadata from server\n  const [filterMeta, setFilterMeta] = useState<{\n    areaCounts: Record<string, number>;\n    districts: string[];\n    citiesByDistrict: Record<string, string[]>;\n  }>({\n    areaCounts: {},\n    districts: [],\n    citiesByDistrict: {},\n  });\n\n  // Modal for rotating code\n  const [redemptionData, setRedemptionData] = useState<any | null>(null);\n  const [redeemLoadingId, setRedeemLoadingId] = useState<number | null>(null);\n  const [actionError, setActionError] = useState<string | null>(null);\n\n  const fetchPartners = () => {\n    setLoading(true);\n    const params = new URLSearchParams();\n    if (selectedArea !== \'all\') params.set(\'area\', selectedArea);\n    if (selectedDistrict !== \'all\') params.set(\'district\', selectedDistrict);\n    if (selectedCity !== \'all\') params.set(\'city\', selectedCity);\n    if (selectedBenefitType !== \'all\') params.set(\'benefit_type\', selectedBenefitType);\n    if (search.trim()) params.set(\'search\', search.trim());\n\n    fetch(`/api/partners?${params.toString()}`)\n      .then((res) => res.json())\n      .then((data) => {\n        setPartners(data.partners || []);\n        if (data.filterMeta) {\n          setFilterMeta(data.filterMeta);\n        }\n        setLoading(false);\n      })\n      .catch((err) => {\n        console.error(\'Failed to load partners:\', err);\n        setError(\'N\303\243o foi poss\303\255vel carregar os parceiros. Tente recarregar a p\303\241gina.\');\n        setLoading(false);\n      });\n  };\n\n  useEffect(() => {\n    fetchPartners();\n  }, [selectedArea, selectedDistrict, selectedCity, selectedBenefitType]);\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    fetchPartners();\n  };\n\n  const handleClearFilters = () => {\n    setSelectedArea(\'all\');\n    setSelectedDistrict(\'all\');\n    setSelectedCity(\'all\');\n    setSelectedBenefitType(\'all\');\n    setSearch(\'\');\n  };\n\n  const hasActiveFilters = \n    selectedArea !== \'all\' || \n    selectedDistrict !== \'all\' || \n    selectedCity !== \'all\' || \n    selectedBenefitType !== \'all\' || \n    search.trim() !== \'\';\n\n  const handleRedeem = async (partnerId: number) => {\n    setActionError(null);\n    if (!user) {\n      onNavigate(\'/entrar\');\n      return;\n    }\n    if (!user.quota_status.has_active_quota) {\n      onNavigate(\'/pagamentos\');\n      return;\n    }\n\n    setRedeemLoadingId(partnerId);\n\n    try {\n      const res = await fetch(\'/api/benefits/redeem\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ partner_id: partnerId }),\n      });\n      const data = await res.json();\n\n      if (!res.ok) {\n        setActionError(data.error || \'Erro ao gerar c\303\263digo\');\n        setRedeemLoadingId(null);\n        return;\n      }\n\n      setRedemptionData(data);\n      setRedeemLoadingId(null);\n    } catch (err) {\n      console.error(\'Error redeeming benefit:\', err);\n      setActionError(\'Ocorreu uma falha de rede ao gerar o c\303\263digo.\');\n      setRedeemLoadingId(null);\n    }\n  };\n\n  const areaList = [\n    \'Sa\303\272de e Bem-estar\',\n    \'Desporto\',\n    \'Lazer e Cultura\',\n    \'Restaura\303\247\303\243o e Alimenta\303\247\303\243o\',\n    \'Forma\303\247\303\243o e Educa\303\247\303\243o\',\n    \'Servi\303\247os\',\n  ];\n\n  const hasQuota = user?.quota_status?.has_active_quota || false;\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\">\n      \n      {/* Top Page Header */}\n      <div className=\"text-center sm:text-left sm:flex sm:items-end sm:justify-between border-b border-slate-200 pb-6\">\n        <div>\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">Cat\303\241logo Oficial de Parcerias</span>\n          <h1 className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-1\">\n            Parceiros & Descontos Exclusivos\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1 max-w-2xl\">\n            A lista de parceiros e vantagens \303\251 p\303\272blica e aberta a todos. Os c\303\263digos de acesso e vouchers s\303\243o gerados em tempo real exclusivamente para associados com a quota anual ou semestral em dia.\n          </p>\n        </div>\n\n        {!hasQuota && (\n          <div className=\"mt-4 sm:mt-0 flex sm:flex-col items-center sm:items-end justify-center gap-2\">\n            <span className=\"text-xs text-slate-500\">Quer ter acesso aos descontos?</span>\n            <button\n              onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n              className=\"px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-xs\"\n            >\n              {user ? \'Regularizar Quota (35\342\202\254)\' : \'Fazer-me S\303\263cio\'}\n            </button>\n          </div>\n        )}\n      </div>\n\n      {actionError && (\n        <div className=\"p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3 text-sm text-red-700\">\n          <AlertCircle className=\"w-5 h-5 text-red-600 shrink-0\" />\n          <span>{actionError}</span>\n        </div>\n      )}\n\n      {/* FILTER CONTROLS BAR */}\n      <div className=\"bg-white rounded-2xl p-5 border border-slate-200 shadow-xs space-y-4\">\n        \n        {/* Search Input + Clear Button */}\n        <form onSubmit={handleSearchSubmit} className=\"flex flex-col sm:flex-row gap-3\">\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n            <input\n              type=\"text\"\n              placeholder=\"Pesquisar por nome de parceiro, servi\303\247o, desconto ou localidade...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition-colors\"\n          >\n            Filtrar\n          </button>\n          {hasActiveFilters && (\n            <button\n              type=\"button\"\n              onClick={handleClearFilters}\n              className=\"px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-1.5\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n              <span>Limpar Filtros</span>\n            </button>\n          )}\n        </form>\n\n        {/* Area Category Pills */}\n        <div>\n          <div className=\"text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2\">\n            \303\201rea de Atividade:\n          </div>\n          <div className=\"flex flex-wrap gap-2\">\n            <button\n              onClick={() => setSelectedArea(\'all\')}\n              className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors ${\n                selectedArea === \'all\'\n                  ? \'bg-red-600 text-white shadow-xs\'\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n              }`}\n            >\n              Todas as \303\201reas ({Object.values(filterMeta.areaCounts).reduce((a, b) => a + b, 0)})\n            </button>\n            {areaList.map((area) => {\n              const count = filterMeta.areaCounts[area] || 0;\n              const active = selectedArea === area;\n              return (\n                <button\n                  key={area}\n                  onClick={() => setSelectedArea(active ? \'all\' : area)}\n                  className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5 ${\n                    active\n                      ? \'bg-red-600 text-white shadow-xs\'\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                  }`}\n                >\n                  <span>{area}</span>\n                  <span className={`text-[10px] px-1.5 py-0.2 rounded-full ${active ? \'bg-white/30 text-white\' : \'bg-slate-200 text-slate-600\'}`}>\n                    {count}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Dropdowns Row: District, City, Benefit Type */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-100\">\n          \n          {/* District selector */}\n          <div>\n            <label className=\"text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1\">\n              Distrito\n            </label>\n            <select\n              value={selectedDistrict}\n              onChange={(e) => {\n                setSelectedDistrict(e.target.value);\n                setSelectedCity(\'all\');\n              }}\n              className=\"w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 focus:outline-hidden focus:border-red-500\"\n            >\n              <option value=\"all\">Todos os Distritos</option>\n              {filterMeta.districts.map((d) => (\n                <option key={d} value={d}>{d}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* City selector (cascading from district) */}\n          <div>\n            <label className=\"text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1\">\n              Localidade\n            </label>\n            <select\n              value={selectedCity}\n              onChange={(e) => setSelectedCity(e.target.value)}\n              disabled={selectedDistrict === \'all\'}\n              className=\"w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 disabled:opacity-50 focus:outline-hidden focus:border-red-500\"\n            >\n              <option value=\"all\">\n                {selectedDistrict === \'all\' ? \'Escolha primeiro um distrito\' : \'Todas as localidades\'}\n              </option>\n              {selectedDistrict !== \'all\' && filterMeta.citiesByDistrict[selectedDistrict]?.map((c) => (\n                <option key={c} value={c}>{c}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* Benefit Type selector */}\n          <div>\n            <label className=\"text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1\">\n              Tipo de Benef\303\255cio\n            </label>\n            <select\n              value={selectedBenefitType}\n              onChange={(e) => setSelectedBenefitType(e.target.value)}\n              className=\"w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-medium text-slate-800 focus:outline-hidden focus:border-red-500\"\n            >\n              <option value=\"all\">Todos os Tipos (Cup\303\265es, C\303\263digos, Vouchers)</option>\n              <option value=\"cupao\">Cup\303\243o Promocional (valor fixo \342\202\254)</option>\n              <option value=\"codigo\">C\303\263digo de Desconto (% cont\303\255nuo)</option>\n              <option value=\"voucher\">Voucher Nominal (uso \303\272nico)</option>\n            </select>\n          </div>\n\n        </div>\n\n        {/* Results Counter */}\n        <div className=\"flex items-center justify-between text-xs text-slate-500 pt-1\">\n          <div>\n            A apresentar <strong className=\"text-slate-800\">{partners.length}</strong> de 28 parceiros\n          </div>\n          {hasActiveFilters && (\n            <span className=\"text-red-600 font-medium\">Filtros ativos aplicados</span>\n          )}\n        </div>\n\n      </div>\n\n      {/* PARTNERS LISTING GRID */}\n      {loading ? (\n        <div className=\"py-20 text-center text-slate-500 space-y-3\">\n          <div className=\"w-8 h-8 border-3 border-red-600 border-t-transparent rounded-full animate-spin mx-auto\" />\n          <p className=\"text-sm\">A carregar parceiros e benef\303\255cios...</p>\n        </div>\n      ) : partners.length === 0 ? (\n        <div className=\"bg-white rounded-2xl p-12 text-center border border-slate-200 space-y-4\">\n          <Layers className=\"w-12 h-12 text-slate-400 mx-auto\" />\n          <h3 className=\"text-base font-bold text-slate-800\">Nenhum parceiro encontrado</h3>\n          <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n            N\303\243o foram encontrados parceiros com os filtros selecionados. Tente alargar a sua pesquisa ou limpar os filtros.\n          </p>\n          <button\n            onClick={handleClearFilters}\n            className=\"px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700\"\n          >\n            Limpar Todos os Filtros\n          </button>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {partners.map((partner) => {\n            const isRedeeming = redeemLoadingId === partner.id;\n\n            return (\n              <div\n                key={partner.id}\n                className=\"bg-white rounded-3xl border border-slate-200/90 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden group\"\n              >\n                {/* Partner Card Top */}\n                <div className=\"p-6\">\n                  \n                  {/* Category, Location & Benefit Badge */}\n                  <div className=\"flex items-start justify-between gap-2 mb-3\">\n                    <div>\n                      <span className=\"text-[11px] font-semibold text-slate-500 block\">\n                        {partner.category}\n                      </span>\n                      <div className=\"flex items-center gap-1 text-xs text-slate-400 mt-0.5\">\n                        <MapPin className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                        <span>{partner.city} ({partner.district})</span>\n                      </div>\n                    </div>\n\n                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0 ${\n                      partner.benefit_type === \'cupao\'\n                        ? \'bg-red-50 text-red-700 border border-red-200\'\n                        : partner.benefit_type === \'voucher\'\n                        ? \'bg-amber-50 text-amber-800 border border-amber-200\'\n                        : \'bg-emerald-50 text-emerald-800 border border-emerald-200\'\n                    }`}>\n                      {partner.benefit_type === \'cupao\' ? \'Cup\303\243o\' : partner.benefit_type === \'voucher\' ? \'Voucher\' : \'C\303\263digo %\'}\n                    </span>\n                  </div>\n\n                  {/* Partner Name */}\n                  <h3 className=\"text-xl font-bold text-slate-900 group-hover:text-red-600 transition-colors\">\n                    {partner.name}\n                  </h3>\n\n                  {/* DISCOUNT HIGHLIGHT (ALWAYS VISIBLE TO EVERYONE) */}\n                  <div className=\"mt-3 p-3 rounded-2xl bg-gradient-to-r from-red-50/80 to-amber-50/60 border border-red-100 flex items-center justify-between\">\n                    <div>\n                      <span className=\"text-[10px] uppercase font-bold text-red-800 tracking-wider block\">\n                        Vantagem de S\303\263cio\n                      </span>\n                      <span className=\"text-base font-black text-red-600\">\n                        {partner.discount_highlight}\n                      </span>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className=\"text-[10px] text-slate-400 block font-semibold\">Poupan\303\247a Est.</span>\n                      <span className=\"text-xs font-mono font-bold text-slate-800\">\n                        {partner.estimated_annual_savings} \342\202\254/ano\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Usage Conditions */}\n                  <div className=\"mt-3 flex items-center gap-1.5 text-xs text-slate-600 font-medium\">\n                    <Tag className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                    <span>{partner.usage_limit}</span>\n                  </div>\n\n                  {/* Description */}\n                  <p className=\"text-xs text-slate-500 mt-2.5 leading-relaxed line-clamp-3\">\n                    {partner.description}\n                  </p>\n\n                  {/* Terms / Validity */}\n                  <div className=\"mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400 leading-tight\">\n                    <span className=\"font-semibold text-slate-500\">Termos:</span> {partner.terms}\n                  </div>\n                </div>\n\n                {/* Partner Card Bottom (CTA or Code Access) */}\n                <div className=\"p-5 bg-slate-50/80 border-t border-slate-100\">\n                  {hasQuota ? (\n                    <button\n                      onClick={() => handleRedeem(partner.id)}\n                      disabled={isRedeeming}\n                      className=\"w-full py-2.5 px-4 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-2\"\n                    >\n                      {isRedeeming ? (\n                        <>\n                          <div className=\"w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                          <span>A gerar c\303\263digo seguro...</span>\n                        </>\n                      ) : (\n                        <>\n                          <Sparkles className=\"w-3.5 h-3.5\" />\n                          <span>Obter C\303\263digo / Voucher</span>\n                        </>\n                      )}\n                    </button>\n                  ) : (\n                    /* Locked Box for Non-Members or Inactive Quota */\n                    <div className=\"space-y-2\">\n                      <div className=\"p-3 bg-slate-100 rounded-xl border border-slate-200/80 flex items-center gap-2.5 text-xs text-slate-600\">\n                        <Lock className=\"w-4 h-4 text-slate-400 shrink-0\" />\n                        <div>\n                          <span className=\"font-bold text-slate-800 block\">C\303\263digo reservado a s\303\263cios</span>\n                          <span className=\"text-[11px] text-slate-500\">Mantenha a quota em dia para aceder.</span>\n                        </div>\n                      </div>\n\n                      <button\n                        onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n                        className=\"w-full py-2 px-3 rounded-xl border border-red-200 text-red-700 hover:bg-red-50 text-xs font-bold transition-colors text-center\"\n                      >\n                        {user ? \'Pagar Quota para Desbloquear (35\342\202\254)\' : \'Fazer-se S\303\263cio (35\342\202\254/ano)\'}\n                      </button>\n                    </div>\n                  )}\n                </div>\n\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Rotating Anti-Abuse Code Modal */}\n      {redemptionData && (\n        <CodeModal\n          redemptionData={redemptionData}\n          onClose={() => setRedemptionData(null)}\n        />\n      )}\n\n    </div>\n  );\n};\n"
