    content: "        <div className=\"max-w-2xl\">\n          <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\">\n            Cobertura Nacional\n          </div>\n          <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight mt-1\">\n            Vantagens em 6 \303\241reas do quotidiano\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {categories.map((cat) => (\n            <button\n              type=\"button\"\n              key={cat.name}\n              onClick={() => onNavigate(\'/parceiros\', { area: cat.name })}\n              className=\"text-left bg-white rounded-xl p-6 border border-stone-200 hover:border-stone-400 transition-colors group flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between text-xs text-stone-500 mb-3\">\n                  <span className=\"font-mono font-semibold text-stone-400\">{cat.num}</span>\n                  <span className=\"font-mono tabular-nums\">{cat.count} parceiros</span>\n                </div>\n                <h3 className=\"font-display text-lg font-semibold text-[#141619] group-hover:text-[#C81E2B] transition-colors\">\n                  {cat.name}\n                </h3>\n                <p className=\"text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed\">\n                  {cat.desc}\n                </p>\n              </div>\n              <div className=\"mt-5 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#141619] group-hover:text-[#C81E2B]\">\n                <span>Explorar \303\241rea</span>\n                <ChevronRight className=\"w-4 h-4 group-hover:translate-x-0.5 transition-transform\" />\n              </div>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* DEDICATED \"QUERO FAZER PARCERIA\" FOR COMPANIES */}\n      <section id=\"quero-fazer-parceria\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white rounded-2xl border border-stone-200 overflow-hidden\">\n          {/* Architectural Banner */}\n          <div className=\"relative h-64 sm:h-72 bg-[#141619]\">\n            {!partnerImgFailed && (\n              <img\n                src={partnershipStreetImg}\n                alt=\"Com\303\251rcio local e cl\303\255nicas parceiras da LPCS em Portugal\"\n                referrerPolicy=\"no-referrer\"\n                onError={() => setPartnerImgFailed(true)}\n                className=\"w-full h-full object-cover opacity-75\"\n              />\n            )}\n            <div className=\"absolute inset-0 bg-gradient-to-t from-[#141619] via-[#141619]/65 to-transparent\" />\n            <div className=\"absolute inset-0 p-6 sm:p-10 flex flex-col justify-end\">\n              <div className=\"max-w-3xl space-y-2\">\n                <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-rose-300\">\n                  Para Empresas e Comerciantes \302\267 Ades\303\243o Gratuita\n                </div>\n                <h2 className=\"font-display text-2xl sm:text-4xl font-semibold text-white tracking-tight text-balance\">\n                  Quero fazer parceria com a Liga Portuguesa Contra a SIDA\n                </h2>\n                <p className=\"text-sm text-stone-200 max-w-2xl leading-relaxed\">\n                  Ofere\303\247a descontos aos associados da LPCS e ganhe visibilidade nacional, impacto ESG certificado, clientes recorrentes e enquadramento de mecenato social.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-6 sm:p-10 space-y-8\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n              {companyBenefits.map((benefit) => {\n                const Icon = benefit.icon;\n                return (\n                  <div\n                    key={benefit.title}\n                    className=\"p-5 rounded-xl bg-[#FAF8F5] border border-stone-200/80 space-y-2.5\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <Icon className=\"w-5 h-5 text-[#C81E2B]\" />\n                      <span className=\"font-mono text-xs text-stone-400\">{benefit.num}</span>\n                    </div>\n                    <h3 className=\"text-base font-semibold text-[#141619]\">{benefit.title}</h3>\n                    <p className=\"text-xs sm:text-sm text-stone-600 leading-relaxed\">{benefit.desc}</p>\n                  </div>\n                );\n              })}"
