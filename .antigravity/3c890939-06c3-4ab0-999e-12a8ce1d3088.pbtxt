  view_file {
    absolute_path_uri: "file:///src/components/CodeModal.tsx"
    end_line: 239
    content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { ShieldCheck, Clock, AlertTriangle, EyeOff, X, Copy, Check } from \'lucide-react\';\n\ninterface CodeModalProps {\n  redemptionData: {\n    redemption_id: number;\n    reference_code: string;\n    totp_code: string;\n    seconds_remaining: number;\n    expires_at: string;\n    partner_name: string;\n    benefit_type: string;\n    discount_highlight: string;\n    benefit_value: string;\n    secret_code?: string | null;\n    member_number: string;\n    member_name: string;\n    timestamp: string;\n  };\n  onClose: () => void;\n}\n\nexport const CodeModal: React.FC<CodeModalProps> = ({ redemptionData, onClose }) => {\n  const [currentCode, setCurrentCode] = useState(redemptionData.totp_code);\n  const [secondsRemaining, setSecondsRemaining] = useState(redemptionData.seconds_remaining);\n  const [isWindowBlurred, setIsWindowBlurred] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [autoCloseRemaining, setAutoCloseRemaining] = useState(120); // 2 minutes auto-close\n\n  // Fetch code update every second / when seconds reach 0\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsRemaining((prev) => {\n        if (prev <= 1) {\n          // Refresh code from server\n          fetch(`/api/benefits/code-refresh/${redemptionData.redemption_id}`)\n            .then((r) => r.json())\n            .then((data) => {\n              if (data.totp_code) {\n                setCurrentCode(data.totp_code);\n                setSecondsRemaining(data.seconds_remaining || 30);\n              }\n            })\n            .catch((err) => console.error(\'Error refreshing code:\', err));\n          return 30;\n        }\n        return prev - 1;\n      });\n\n      setAutoCloseRemaining((prev) => {\n        if (prev <= 1) {\n          onClose();\n          return 0;\n        }\n        return prev - 1;\n      });\n    }, 1000);\n\n    return () => clearInterval(timer);\n  }, [redemptionData.redemption_id, onClose]);\n\n  // Anti-screenshot detection: blur on window blur or tab switch\n  useEffect(() => {\n    const handleBlur = () => setIsWindowBlurred(true);\n    const handleFocus = () => setIsWindowBlurred(false);\n    const handleVisibility = () => {\n      if (document.hidden) {\n        setIsWindowBlurred(true);\n      } else {\n        setIsWindowBlurred(false);\n      }\n    };\n\n    window.addEventListener(\'blur\', handleBlur);\n    window.addEventListener(\'focus\', handleFocus);\n    document.addEventListener(\'visibilitychange\', handleVisibility);\n\n    return () => {\n      window.removeEventListener(\'blur\', handleBlur);\n      window.removeEventListener(\'focus\', handleFocus);\n      document.removeEventListener(\'visibilitychange\', handleVisibility);\n    };\n  }, []);\n\n  const handleCopy = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  // Watermark text repeated\n  const watermarkText = `${redemptionData.member_number} \342\200\242 ${new Date().toLocaleTimeString(\'pt-PT\')}`;\n\n  return (\n    <div \n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md select-none\"\n      onContextMenu={(e) => e.preventDefault()}\n    >\n      <div className=\"relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden\">\n        \n        {/* Top Header */}\n        <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white\">\n              <ShieldCheck className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold tracking-tight\">C\303\263digo Seguro de Utiliza\303\247\303\243o</h3>\n              <p className=\"text-xs text-slate-400\">Prote\303\247\303\243o Anti-Abuso HMAC-SHA256</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-full text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Window Blurred Privacy Overlay */}\n        {isWindowBlurred && (\n          <div className=\"absolute inset-0 z-30 bg-slate-900/95 flex flex-col items-center justify-center text-center p-6 text-white backdrop-blur-xl\">\n            <EyeOff className=\"w-12 h-12 text-red-500 mb-3 animate-pulse\" />\n            <h4 className=\"text-lg font-bold\">Conte\303\272do Oculto por Seguran\303\247a</h4>\n            <p className=\"text-xs text-slate-300 max-w-xs mt-1\">\n              O c\303\263digo foi temporariamente ocultado porque a janela perdeu o foco. Clique na janela para voltar a visualizar.\n            </p>\n          </div>\n        )}\n\n        {/* Modal Body with Watermark */}\n        <div className=\"relative p-6 sm:p-8 bg-gradient-to-b from-slate-50 to-white overflow-hidden\">\n          \n          {/* Subtle Dynamic Repeating Watermark */}\n          <div className=\"absolute inset-0 opacity-[0.04] pointer-events-none flex flex-wrap gap-8 p-4 font-mono text-xs rotate-[-15deg] select-none text-slate-900\">\n            {Array.from({ length: 24 }).map((_, i) => (\n              <span key={i}>{watermarkText} \342\200\242 N\303\203O REPRODUZIR</span>\n            ))}\n          </div>\n\n          {/* Partner & Benefit Info */}\n          <div className=\"text-center mb-6\">\n            <span className=\"inline-block px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700 uppercase tracking-wider mb-2\">\n              {redemptionData.benefit_type}\n            </span>\n            <h2 className=\"text-xl sm:text-2xl font-black text-slate-900 tracking-tight\">\n              {redemptionData.partner_name}\n            </h2>\n            <p className=\"text-sm font-bold text-red-600 mt-1\">\n              {redemptionData.discount_highlight}\n            </p>\n            <p className=\"text-xs text-slate-500 mt-0.5\">{redemptionData.benefit_value}</p>\n          </div>\n\n          {/* The Rotating 6-Digit Code Box */}\n          <div className=\"bg-white rounded-2xl p-6 border-2 border-slate-200 shadow-inner text-center relative group\">\n            <div className=\"text-xs font-bold uppercase tracking-widest text-slate-400 mb-1\">\n              C\303\263digo Rotativo (Muda a cada 30s)\n            </div>\n            \n            <div className=\"text-4xl sm:text-5xl font-mono font-black tracking-widest text-slate-900 my-2\">\n              {currentCode.slice(0, 3)} {currentCode.slice(3)}\n            </div>\n\n            {/* Countdown Progress Bar (30s window) */}\n            <div className=\"w-full bg-slate-100 h-2 rounded-full overflow-hidden mt-4\">\n              <div\n                className=\"bg-red-600 h-full transition-all duration-1000 ease-linear rounded-full\"\n                style={{ width: `${(secondsRemaining / 30) * 100}%` }}\n              />\n            </div>\n\n            <div className=\"flex items-center justify-between text-xs text-slate-500 mt-2 font-medium\">\n              <span className=\"flex items-center gap-1\">\n                <Clock className=\"w-3.5 h-3.5 text-red-500\" />\n                <span>Expira em: <strong className=\"text-slate-800\">{secondsRemaining}s</strong></span>\n              </span>\n              <button\n                onClick={() => handleCopy(currentCode)}\n                className=\"inline-flex items-center gap-1 text-slate-600 hover:text-slate-900 font-semibold\"\n              >\n                {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copied ? \'Copiado!\' : \'Copiar\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Reference for Merchant */}\n          <div className=\"mt-5 p-3.5 bg-slate-100/90 rounded-xl border border-slate-200 flex items-center justify-between\">\n            <div>\n              <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-wider block\">\n                Refer\303\252ncia para Valida\303\247\303\243o no Estabelecimento\n              </span>\n              <span className=\"text-sm font-mono font-extrabold text-slate-800 tracking-wider\">\n                {redemptionData.reference_code}\n              </span>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"text-[10px] text-slate-400 block\">S\303\263cio Titular</span>\n              <span className=\"text-xs font-bold text-slate-700\">{redemptionData.member_number}</span>\n            </div>\n          </div>\n\n          {/* Fixed partner coupon code if applicable */}\n          {redemptionData.secret_code && (\n            <div className=\"mt-3 text-center\">\n              <span className=\"text-xs text-slate-500\">\n                C\303\263digo promocional fixo do parceiro: <strong className=\"font-mono text-slate-800\">{redemptionData.secret_code}</strong>\n              </span>\n            </div>\n          )}\n\n          {/* Security Notice & Auto-Close Timer */}\n          <div className=\"mt-6 flex items-start gap-2 text-xs text-slate-500 bg-amber-50/80 p-3 rounded-xl border border-amber-200/60\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n            <p>\n              Apresente este ecr\303\243 ou faculte a refer\303\252ncia e o c\303\263digo de 6 d\303\255gitos ao comerciante. Por raz\303\265es de seguran\303\247a, o c\303\263digo \303\251 de uso \303\272nico e esta janela fecha automaticamente em <strong>{autoCloseRemaining} segundos</strong>.\n            </p>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between\">\n          <div className=\"text-xs text-slate-400 font-mono\">\n            V\303\241lido at\303\251: {new Date(redemptionData.expires_at).toLocaleTimeString(\'pt-PT\')}\n          </div>\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold transition-colors\"\n          >\n            Concluir / Fechar\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 240
    num_bytes: 10116
    line_range_bytes: 10116
  }
}
