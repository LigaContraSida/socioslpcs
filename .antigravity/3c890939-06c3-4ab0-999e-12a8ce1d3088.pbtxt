  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { ShieldCheck, Clock, AlertTriangle, EyeOff, X, Copy, Check } from \'lucide-react\';\n\ninterface CodeModalProps {\n  redemptionData: {\n    redemption_id: number;\n    reference_code: string;\n    totp_code: string;\n    seconds_remaining: number;\n    expires_at: string;\n    partner_name: string;\n    benefit_type: string;\n    discount_highlight: string;\n    benefit_value: string;\n    secret_code?: string | null;\n    member_number: string;\n    member_name: string;\n    timestamp: string;\n  };\n  onClose: () => void;\n}\n\nexport const CodeModal: React.FC<CodeModalProps> = ({ redemptionData, onClose }) => {\n  const [currentCode, setCurrentCode] = useState(redemptionData.totp_code);\n  const [secondsRemaining, setSecondsRemaining] = useState(redemptionData.seconds_remaining);\n  const [isWindowBlurred, setIsWindowBlurred] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [autoCloseRemaining, setAutoCloseRemaining] = useState(180); // 3 minutes availability\n\n  // Tick down both the 30s TOTP window and the 3-minute modal countdown\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsRemaining((prev) => (prev <= 1 ? 0 : prev - 1));\n      setAutoCloseRemaining((prev) => (prev <= 1 ? 0 : prev - 1));\n    }, 1000);\n\n    return () => clearInterval(timer);\n  }, []);\n\n  // Refresh the rotating 6-digit code whenever the 30s window reaches 0\n  useEffect(() => {\n    if (secondsRemaining > 0) return;\n\n    let cancelled = false;\n    fetch(`/api/benefits/code-refresh/${redemptionData.redemption_id}`, {\n      credentials: \'same-origin\',\n    })\n      .then((r) => r.json())\n      .then((data) => {\n        if (cancelled) return;\n        if (data.totp_code) {\n          setCurrentCode(data.totp_code);\n          setSecondsRemaining(data.seconds_remaining || 30);\n        } else {\n          setSecondsRemaining(30);\n        }\n      })\n      .catch((err) => {\n        console.error(\'Error refreshing code:\', err);\n        if (!cancelled) setSecondsRemaining(30);\n      });\n\n    return () => {\n      cancelled = true;\n    };\n  }, [secondsRemaining, redemptionData.redemption_id]);\n\n  // Auto-close modal once the 3-minute availability window expires\n  useEffect(() => {\n    if (autoCloseRemaining <= 0) {\n      onClose();\n    }\n  }, [autoCloseRemaining, onClose]);\n\n  // Anti-screenshot detection: blur on window blur or tab switch\n  useEffect(() => {\n    const handleBlur = () => setIsWindowBlurred(true);\n    const handleFocus = () => setIsWindowBlurred(false);\n    const handleVisibility = () => {\n      setIsWindowBlurred(document.hidden);\n    };\n\n    window.addEventListener(\'blur\', handleBlur);\n    window.addEventListener(\'focus\', handleFocus);\n    document.addEventListener(\'visibilitychange\', handleVisibility);\n\n    return () => {\n      window.removeEventListener(\'blur\', handleBlur);\n      window.removeEventListener(\'focus\', handleFocus);\n      document.removeEventListener(\'visibilitychange\', handleVisibility);\n    };\n  }, []);\n\n  const handleCopy = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const benefitLabel =\n    redemptionData.benefit_type === \'cupao\'\n      ? \'Cup\303\243o Promocional\'\n      : redemptionData.benefit_type === \'voucher\'\n      ? \'Voucher Nominal\'\n      : \'C\303\263digo de Desconto\';\n\n  const watermarkText = `${redemptionData.member_number} \302\267 ${new Date().toLocaleTimeString(\'pt-PT\')}`;\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#141619]/80 backdrop-blur-sm select-none\"\n      onContextMenu={(e) => e.preventDefault()}\n    >\n      <div className=\"relative w-full max-w-lg bg-white rounded-2xl border border-stone-200 shadow-2xl overflow-hidden\">\n        {/* Top Header */}\n        <div className=\"px-6 py-4 bg-[#141619] text-white flex items-center justify-between border-b border-stone-800\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#C81E2B] flex items-center justify-center text-white\">\n              <ShieldCheck className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-semibold tracking-tight\">C\303\263digo Seguro de Utiliza\303\247\303\243o</h3>\n              <p className=\"text-xs text-stone-400\">Verifica\303\247\303\243o din\303\242mica de uso \303\272nico</p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Fechar\"\n            className=\"p-1.5 rounded-lg text-stone-400 hover:text-white hover:bg-stone-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Window Blurred Privacy Overlay */}\n        {isWindowBlurred && (\n          <div className=\"absolute inset-0 z-30 bg-[#141619]/95 flex flex-col items-center justify-center text-center p-6 text-white backdrop-blur-md\">\n            <EyeOff className=\"w-10 h-10 text-[#C81E2B] mb-3\" />\n            <h4 className=\"text-lg font-display font-semibold\">Conte\303\272do Oculto por Seguran\303\247a</h4>\n            <p className=\"text-xs text-stone-300 max-w-xs mt-1.5 leading-relaxed\">\n              O c\303\263digo foi temporariamente ocultado porque a janela perdeu o foco. Clique na janela para voltar a visualizar.\n            </p>\n          </div>\n        )}\n\n        {/* Modal Body */}\n        <div className=\"relative p-6 sm:p-8 bg-[#FAF8F5] overflow-hidden space-y-5\">\n          {/* Dynamic Repeating Watermark (functional anti-screenshot security feature) */}\n          <div className=\"absolute inset-0 opacity-[0.035] pointer-events-none flex flex-wrap gap-8 p-4 font-mono text-xs rotate-[-15deg] select-none text-[#141619]\">\n            {Array.from({ length: 24 }).map((_, i) => (\n              <span key={i}>{watermarkText}</span>\n            ))}\n          </div>\n\n          {/* Partner & Benefit Info */}\n          <div className=\"relative text-center space-y-1\">\n            <div className=\"text-xs font-medium text-stone-500\">\n              {benefitLabel} \302\267 {redemptionData.benefit_value}\n            </div>\n            <h2 className=\"font-display text-2xl font-bold text-[#141619] tracking-tight\">\n              {redemptionData.partner_name}\n            </h2>\n            <p className=\"text-sm font-semibold text-[#C81E2B]\">{redemptionData.discount_highlight}</p>\n          </div>\n\n          {/* Rotating 6-Digit Code Display */}\n          <div className=\"relative bg-white rounded-xl p-6 border border-stone-200 text-center\">\n            <div className=\"text-xs font-medium text-stone-500 mb-1\">\n              C\303\263digo rotativo (atualiza a cada 30 segundos)\n            </div>\n\n            <div className=\"text-4xl sm:text-5xl font-mono font-bold tracking-[0.18em] text-[#141619] my-3 tabular-nums\">\n              {currentCode.slice(0, 3)} {currentCode.slice(3)}\n            </div>\n\n            <div className=\"w-full bg-stone-100 h-1.5 rounded-full overflow-hidden mt-4\">\n              <div\n                className=\"bg-[#C81E2B] h-full transition-all duration-1000 ease-linear\"\n                style={{ width: `${(secondsRemaining / 30) * 100}%` }}\n              />\n            </div>\n\n            <div className=\"flex items-center justify-between text-xs text-stone-600 mt-3 font-medium\">\n              <span className=\"flex items-center gap-1.5 tabular-nums\">\n                <Clock className=\"w-3.5 h-3.5 text-[#C81E2B]\" />\n                <span>\n                  Expira em <strong className=\"text-[#141619] font-mono\">{secondsRemaining}s</strong>\n                </span>\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => handleCopy(currentCode)}\n                className=\"inline-flex items-center gap-1.5 text-stone-700 hover:text-[#141619] font-semibold\"\n              >\n                {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copied ? \'Copiado\' : \'Copiar c\303\263digo\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Reference for Merchant */}\n          <div className=\"relative px-4 py-3.5 bg-white rounded-xl border border-stone-200 flex items-center justify-between gap-4\">\n            <div>\n              <span className=\"text-xs text-stone-500 block\">Refer\303\252ncia para valida\303\247\303\243o</span>\n              <span className=\"text-sm font-mono font-bold text-[#141619] tracking-wide tabular-nums\">\n                {redemptionData.reference_code}\n              </span>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"text-xs text-stone-500 block\">S\303\263cio Titular</span>\n              <span className=\"text-xs font-mono font-semibold text-stone-800 tabular-nums\">\n                {redemptionData.member_number}\n              </span>\n            </div>\n          </div>\n\n          {redemptionData.secret_code && (\n            <div className=\"relative text-center text-xs text-stone-600\">\n              C\303\263digo promocional do parceiro:{\' \'}\n              <strong className=\"font-mono text-[#141619]\">{redemptionData.secret_code}</strong>\n            </div>\n          )}\n\n          {/* 3-Minute Availability Notice */}\n          <div className=\"relative flex items-start gap-2.5 text-xs text-amber-900 bg-amber-50/90 p-3.5 rounded-xl border border-amber-200/80 leading-relaxed\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n            <p>\n              Apresente este ecr\303\243 ou faculte a refer\303\252ncia e o c\303\263digo de 6 d\303\255gitos ao comerciante. O c\303\263digo rotativo fica dispon\303\255vel durante 3 minutos e esta janela fecha automaticamente em{\' \'}\n              <strong className=\"font-mono tabular-nums\">\n                {Math.floor(autoCloseRemaining / 60)}m {(autoCloseRemaining % 60).toString().padStart(2, \'0\')}s\n              </strong>\n              .\n            </p>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 bg-white border-t border-stone-200 flex items-center justify-between\">\n          <div className=\"text-xs text-stone-500 font-mono tabular-nums\">\n            Resgate v\303\241lido at\303\251 {new Date(redemptionData.expires_at).toLocaleTimeString(\'pt-PT\')}\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-5 py-2 rounded-lg bg-[#141619] hover:bg-stone-800 text-white text-xs font-semibold transition-colors\"\n          >\n            Concluir\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
