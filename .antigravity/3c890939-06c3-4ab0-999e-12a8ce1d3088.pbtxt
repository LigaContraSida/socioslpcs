    content: "          headline: `${status.days_remaining} dias restantes de acesso`,\n        }\n      : status.status === \'expirar\'\n      ? {\n          icon: AlertTriangle,\n          label: \'A Expirar (\342\211\244 30 dias)\',\n          textTone: \'text-amber-700\',\n          barTone: \'bg-amber-500\',\n          borderTone: \'border-amber-200\',\n          headline: `Apenas ${status.days_remaining} dias restantes`,\n        }\n      : status.status === \'expirada\'\n      ? {\n          icon: XCircle,\n          label: \'Quota Expirada\',\n          textTone: \'text-[#C81E2B]\',\n          barTone: \'bg-[#C81E2B]\',\n          borderTone: \'border-red-200\',\n          headline: `Expirada h\303\241 ${status.days_expired} dias`,\n        }\n      : {\n          icon: AlertCircle,\n          label: \'Sem Quota Ativa\',\n          textTone: \'text-stone-600\',\n          barTone: \'bg-stone-400\',\n          borderTone: \'border-stone-200\',\n          headline: \'Ainda n\303\243o ativou a sua quota de s\303\263cio\',\n        };\n\n  const StatusIcon = statusMeta.icon;\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\">\n      {/* Greeting & Member Card */}\n      <div className=\"bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 flex flex-col md:flex-row md:items-center justify-between gap-6\">\n        <div className=\"space-y-1.5\">\n          <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\">\n            \303\201rea Pessoal do Associado\n          </div>\n          <h1 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight\">\n            Ol\303\241, {user.name}\n          </h1>\n          <p className=\"text-xs sm:text-sm text-stone-500\">\n            {user.email} <span aria-hidden=\"true\" className=\"mx-1.5 text-stone-300\">\302\267</span> Cart\303\243o ativo na Liga Portuguesa Contra a SIDA\n          </p>\n        </div>"
    num_lines: 488
    num_bytes: 20212
    line_range_bytes: 1834
  }
