  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Building2,\n  HeartHandshake,\n  ShieldCheck,\n  TrendingUp,\n  BadgePercent,\n  Users,\n  Award,\n  Sparkles,\n  CheckCircle2,\n  AlertCircle,\n  Send,\n  QrCode,\n  FileCheck,\n  Megaphone,\n  ArrowLeft,\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface PartnershipPageProps {\n  onNavigate: (path: string) => void;\n}\n\nexport const PartnershipPage: React.FC<PartnershipPageProps> = ({ onNavigate }) => {\n  const [formData, setFormData] = useState({\n    company_name: \'\',\n    nif: \'\',\n    contact_name: \'\',\n    email: \'\',\n    phone: \'\',\n    area: \'Sa\303\272de e Bem-estar\',\n    district: \'Lisboa\',\n    city: \'\',\n    benefit_type: \'codigo\',\n    proposed_benefit: \'\',\n    website: \'\',\n    notes: \'\',\n  });\n\n  const [submitting, setSubmitting] = useState(false);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  const companyAdvantages = [\n    {\n      icon: HeartHandshake,\n      title: \'Responsabilidade Social & Impacto ESG\',\n      badge: \'Selo Oficial LPCS\',\n      desc: \'Associe a sua marca a uma Institui\303\247\303\243o Particular de Solidariedade Social (IPSS) e Pessoa Coletiva de Utilidade P\303\272blica com mais de 35 anos de trabalho na preven\303\247\303\243o do VIH/SIDA e defesa dos direitos humanos.\',\n      highlights: [\n        \'Selo digital e f\303\255sico \"Empresa Parceira Solid\303\241ria LPCS\"\',\n        \'Refor\303\247o comprovado nos relat\303\263rios anuais de sustentabilidade e ESG\',\n      ],\n    },\n    {\n      icon: Megaphone,\n      title: \'Visibilidade Direta & Novos Clientes\',\n      badge: \'Alcance Nacional\',\n      desc: \'A sua empresa entra imediatamente no cat\303\241logo p\303\272blico e pesquis\303\241vel da LPCS, com filtros por distrito, localidade e \303\241rea de atividade \342\200\224 visto por milhares de associados e visitantes.\',\n      highlights: [\n        \'Destaque em campanhas sazonais e newsletters para s\303\263cios\',\n        \'Fluxo recorrente de clientes com elevada taxa de fideliza\303\247\303\243o\',\n      ],\n    },\n    {\n      icon: FileCheck,\n      title: \'Enquadramento Fiscal & Mecenato\',\n      badge: \'Estatuto EBF\',\n      desc: \'As empresas que complementem a parceria com donativos ou patroc\303\255nios a projetos comunit\303\241rios beneficiam do enquadramento previsto no Estatuto dos Benef\303\255cios Fiscais (Mecenato Social).\',\n      highlights: [\n        \'Emiss\303\243o de declara\303\247\303\265es oficiais para efeitos de dedu\303\247\303\243o em IRC\',\n        \'Apoio direto a rastreios gratuitos e linhas de apoio social\',\n      ],\n    },\n    {\n      icon: ShieldCheck,\n      title: \'Zero Custos de Ades\303\243o & Anti-Abuso\',\n      badge: \'Seguran\303\247a HMAC-SHA256\',\n      desc: \'A ades\303\243o ao cat\303\241logo de benef\303\255cios da LPCS n\303\243o tem qualquer taxa ou comiss\303\243o. O sistema garante que apenas s\303\263cios com quota em dia acedem ao desconto.\',\n      highlights: [\n        \'C\303\263digos rotativos de 6 d\303\255gitos que mudam a cada 30 segundos\',\n        \'Validador comercial simples (/validar) que impede capturas de ecr\303\243\',\n      ],\n    },\n    {\n      icon: BadgePercent,\n      title: \'Flexibilidade Total no Tipo de Desconto\',\n      badge: \'\303\200 Sua Medida\',\n      desc: \'A empresa define livremente o benef\303\255cio que melhor protege a sua margem comercial, o limite de utiliza\303\247\303\265es e as condi\303\247\303\265es aplic\303\241veis.\',\n      highlights: [\n        \'Cup\303\243o promocional (valor fixo em \342\202\254 com n\302\272 m\303\241ximo de usos)\',\n        \'C\303\263digo de desconto (% cont\303\255nua) ou Voucher nominal (uso \303\272nico)\',\n      ],\n    },\n    {\n      icon: Users,\n      title: \'A\303\247\303\265es de Sa\303\272de & Bem-Estar na Empresa\',\n      badge: \'Equipas Saud\303\241veis\',\n      desc: \'Os parceiros podem solicitar a\303\247\303\265es de sensibiliza\303\247\303\243o, literacia em sa\303\272de, preven\303\247\303\243o e testes r\303\241pidos confidenciais promovidos pelas equipas t\303\251cnicas da LPCS.\',\n      highlights: [\n        \'Workshops de bem-estar e preven\303\247\303\243o para colaboradores\',\n        \'Cultura interna inclusiva e livre de estigma\',\n      ],\n    },\n  ];\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitting(true);\n    setErrorMsg(null);\n    setSuccessMsg(null);\n\n    try {\n      const res = await fetch(\'/api/partners/inquiry\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(formData),\n      });\n      const data = await res.json();\n\n      if (!res.ok) {\n        setErrorMsg(data.error || \'Erro ao enviar proposta.\');\n        setSubmitting(false);\n        return;\n      }\n\n      setSuccessMsg(data.message);\n      setSubmitting(false);\n      setFormData({\n        company_name: \'\',\n        nif: \'\',\n        contact_name: \'\',\n        email: \'\',\n        phone: \'\',\n        area: \'Sa\303\272de e Bem-estar\',\n        district: \'Lisboa\',\n        city: \'\',\n        benefit_type: \'codigo\',\n        proposed_benefit: \'\',\n        website: \'\',\n        notes: \'\',\n      });\n      confetti({\n        particleCount: 90,\n        spread: 65,\n        origin: { y: 0.6 },\n      });\n    } catch (err) {\n      console.error(\'Inquiry submit error:\', err);\n      setErrorMsg(\'Falha de liga\303\247\303\243o ao servidor. Tente novamente.\');\n      setSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16\">\n      {/* Top Back Link */}\n      <div>\n        <button\n          onClick={() => onNavigate(\'/\')}\n          className=\"inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-red-600 transition-colors\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Voltar \303\240 P\303\241gina Inicial</span>\n        </button>\n      </div>\n\n      {/* Hero Banner */}\n      <section className=\"bg-slate-900 text-white rounded-3xl p-8 sm:p-14 relative overflow-hidden shadow-xl\">\n        <div className=\"absolute -top-20 -right-20 w-96 h-96 bg-red-600/20 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"max-w-3xl space-y-5 relative z-10\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/20 border border-red-500/40 text-red-300 text-xs font-bold uppercase tracking-wider\">\n            <Building2 className=\"w-3.5 h-3.5\" />\n            <span>Rede de Empresas Parceiras LPCS</span>\n          </div>\n\n          <h1 className=\"text-3xl sm:text-5xl font-black tracking-tight leading-tight\">\n            Quero fazer parceria com a Liga Portuguesa Contra a SIDA\n          </h1>\n\n          <p className=\"text-sm sm:text-base text-slate-300 leading-relaxed\">\n            Junte a sua empresa a mais de duas dezenas de organiza\303\247\303\265es portuguesas que promovem vantagens reais para os nossos associados, ganham visibilidade junto de um p\303\272blico fidelizado e fortalecem o seu compromisso social e ESG \342\200\224 sem custos de ades\303\243o.\n          </p>\n\n          <div className=\"pt-2 flex flex-wrap gap-3\">\n            <button\n              onClick={() => {\n                document.getElementById(\'partner-form\')?.scrollIntoView({ behavior: \'smooth\' });\n              }}\n              className=\"px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm shadow-lg shadow-red-900/40 transition-all\"\n            >\n              Submeter Proposta de Parceria\n            </button>\n            <button\n              onClick={() => onNavigate(\'/parceiros\')}\n              className=\"px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/15 transition-colors\"\n            >\n              Ver Parceiros Atuais (28)\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* 6 CORE ADVANTAGES FOR COMPANIES */}\n      <section className=\"space-y-8\">\n        <div className=\"text-center max-w-2xl mx-auto\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">\n            Benef\303\255cios para Empresas Colaboradoras\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">\n            Todas as vantagens de ser Empresa Parceira LPCS\n          </h2>\n          <p className=\"text-sm text-slate-500 mt-2\">\n            Uma parceria estruturada para gerar retorno comercial, reputa\303\247\303\243o social positiva e seguran\303\247a tecnol\303\263gica total na valida\303\247\303\243o dos descontos.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {companyAdvantages.map((adv) => {\n            const Icon = adv.icon;\n            return (\n              <div\n                key={adv.title}\n                className=\"bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-xs hover:border-red-300 hover:shadow-md transition-all flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-12 h-12 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center\">\n                      <Icon className=\"w-6 h-6\" />\n                    </div>\n                    <span className=\"text-[11px] font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700\">\n                      {adv.badge}\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-lg font-extrabold text-slate-900\">{adv.title}</h3>\n                  <p className=\"text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed\">{adv.desc}</p>\n                </div>\n\n                <ul className=\"mt-5 pt-4 border-t border-slate-100 space-y-2\">\n                  {adv.highlights.map((item) => (\n                    <li key={item} className=\"flex items-start gap-2 text-xs text-slate-700 font-medium\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n                      <span>{item}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* HOW VALIDATION WORKS FOR MERCHANTS */}\n      <section className=\"bg-gradient-to-br from-red-50/80 via-white to-slate-50 rounded-3xl p-8 sm:p-10 border border-red-100\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8 items-center\">\n          <div className=\"lg:col-span-1 space-y-3\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">\n              Opera\303\247\303\243o Simples & Segura\n            </span>\n            <h3 className=\"text-2xl font-black text-slate-900\">\n              Como funciona no seu balc\303\243o ou loja online?\n            </h3>\n            <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed\">\n              N\303\243o precisa de instalar terminais nem integrar softwares complexos. Todo o processo demora menos de 10 segundos atrav\303\251s do nosso validador web.\n            </p>\n            <button\n              onClick={() => onNavigate(\'/validar\')}\n              className=\"inline-flex items-center gap-2 text-xs font-bold text-red-600 hover:text-red-700 pt-1\"\n            >\n              <QrCode className=\"w-4 h-4\" />\n              <span>Experimentar Validador de Comerciantes</span>\n            </button>\n          </div>\n\n          <div className=\"lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 space-y-2\">\n              <div className=\"w-8 h-8 rounded-full bg-red-600 text-white font-black text-xs flex items-center justify-center\">\n                1\n              </div>\n              <h4 className=\"font-bold text-sm text-slate-900\">S\303\263cio mostra o c\303\263digo</h4>\n              <p className=\"text-xs text-slate-500\">\n                O associado com quota ativa gera no telem\303\263vel uma refer\303\252ncia e um c\303\263digo de 6 d\303\255gitos que roda a cada 30 segundos.\n              </p>\n            </div>\n\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 space-y-2\">\n              <div className=\"w-8 h-8 rounded-full bg-red-600 text-white font-black text-xs flex items-center justify-center\">\n                2\n              </div>\n              <h4 className=\"font-bold text-sm text-slate-900\">Equipa valida em /validar</h4>\n              <p className=\"text-xs text-slate-500\">\n                O colaborador confirma a autenticidade e a quota ativa em segundos, sem risco de reutiliza\303\247\303\243o de capturas de ecr\303\243.\n              </p>\n            </div>\n\n            <div className=\"bg-white p-5 rounded-2xl border border-slate-200 space-y-2\">\n              <div className=\"w-8 h-8 rounded-full bg-emerald-600 text-white font-black text-xs flex items-center justify-center\">\n                3\n              </div>\n              <h4 className=\"font-bold text-sm text-slate-900\">Desconto aplicado</h4>\n              <p className=\"text-xs text-slate-500\">\n                O c\303\263digo fica marcado como consumido na hora e a sua empresa conquista um novo cliente fiel \303\240 sua marca.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* PARTNERSHIP PROPOSAL FORM */}\n      <section id=\"partner-form\" className=\"bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-lg max-w-4xl mx-auto\">\n        <div className=\"space-y-2 mb-6\">\n          <div className=\"inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-red-600\">\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Ades\303\243o Gratuita ao Programa</span>\n          </div>\n          <h2 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n            Proposta de Parceria Empresarial\n          </h2>\n          <p className=\"text-xs sm:text-sm text-slate-500\">\n            Preencha os dados da sua empresa e indique o benef\303\255cio que pretende oferecer aos associados da LPCS. A nossa equipa responder\303\241 em at\303\251 48 horas \303\272teis.\n          </p>\n        </div>\n\n        {successMsg && (\n          <div className=\"mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-start gap-3 text-sm text-emerald-800\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"block font-bold\">Proposta Enviada!</strong>\n              <span>{successMsg}</span>\n            </div>\n          </div>\n        )}\n\n        {errorMsg && (\n          <div className=\"mb-6 p-4 bg-red-50 border border-red-200 rounded-2xl flex items-start gap-3 text-sm text-red-700\">\n            <AlertCircle className=\"w-5 h-5 text-red-600 shrink-0 mt-0.5\" />\n            <span>{errorMsg}</span>\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-5\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Nome da Empresa / Marca *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.company_name}\n                onChange={(e) => setFormData({ ...formData, company_name: e.target.value })}\n                placeholder=\"Ex: Cl\303\255nica Sa\303\272de Atl\303\242ntico, Lda.\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                NIPC / NIF da Empresa (Opcional)\n              </label>\n              <input\n                type=\"text\"\n                maxLength={9}\n                value={formData.nif}\n                onChange={(e) => setFormData({ ...formData, nif: e.target.value.replace(/\\D/g, \'\') })}\n                placeholder=\"500123456\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 font-mono text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Pessoa de Contacto *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.contact_name}\n                onChange={(e) => setFormData({ ...formData, contact_name: e.target.value })}\n                placeholder=\"Nome completo do respons\303\241vel\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                E-mail Corporativo *\n              </label>\n              <input\n                type=\"email\"\n                required\n                value={formData.email}\n                onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                placeholder=\"parcerias@empresa.pt\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Telefone / Telem\303\263vel *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.phone}\n                onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                placeholder=\"912345678 ou 210000000\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 font-mono text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                \303\201rea de Atividade *\n              </label>\n              <select\n                value={formData.area}\n                onChange={(e) => setFormData({ ...formData, area: e.target.value })}\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              >\n                <option value=\"Sa\303\272de e Bem-estar\">Sa\303\272de e Bem-estar</option>\n                <option value=\"Desporto\">Desporto</option>\n                <option value=\"Lazer e Cultura\">Lazer e Cultura</option>\n                <option value=\"Restaura\303\247\303\243o e Alimenta\303\247\303\243o\">Restaura\303\247\303\243o e Alimenta\303\247\303\243o</option>\n                <option value=\"Forma\303\247\303\243o e Educa\303\247\303\243o\">Forma\303\247\303\243o e Educa\303\247\303\243o</option>\n                <option value=\"Servi\303\247os\">Servi\303\247os</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Distrito / Abrang\303\252ncia *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.district}\n                onChange={(e) => setFormData({ ...formData, district: e.target.value })}\n                placeholder=\"Lisboa, Porto, Coimbra, Nacional...\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Localidade / Online *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.city}\n                onChange={(e) => setFormData({ ...formData, city: e.target.value })}\n                placeholder=\"Ex: Lisboa ou Online\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Formato de Benef\303\255cio Pretendido *\n              </label>\n              <select\n                value={formData.benefit_type}\n                onChange={(e) => setFormData({ ...formData, benefit_type: e.target.value })}\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              >\n                <option value=\"codigo\">C\303\263digo de Desconto (% cont\303\255nua)</option>\n                <option value=\"cupao\">Cup\303\243o Promocional (valor fixo \342\202\254 com limite)</option>\n                <option value=\"voucher\">Voucher Nominal (oferta / uso \303\272nico)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Website da Empresa (Opcional)\n              </label>\n              <input\n                type=\"text\"\n                value={formData.website}\n                onChange={(e) => setFormData({ ...formData, website: e.target.value })}\n                placeholder=\"https://www.empresa.pt\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Desconto ou Condi\303\247\303\243o Proposta para Associados LPCS *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.proposed_benefit}\n                onChange={(e) => setFormData({ ...formData, proposed_benefit: e.target.value })}\n                placeholder=\"Ex: 20% de desconto em todos os servi\303\247os ou 1\302\252 consulta gratuita\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Observa\303\247\303\265es / Interesse em A\303\247\303\265es de Sensibiliza\303\247\303\243o ou Mecenato\n              </label>\n              <textarea\n                rows={3}\n                value={formData.notes}\n                onChange={(e) => setFormData({ ...formData, notes: e.target.value })}\n                placeholder=\"Indique se pretende tamb\303\251m organizar a\303\247\303\265es de preven\303\247\303\243o na empresa, receber o selo de Empresa Solid\303\241ria ou obter informa\303\247\303\265es sobre mecenato fiscal.\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"pt-2\">\n            <button\n              type=\"submit\"\n              disabled={submitting}\n              className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm shadow-md shadow-red-200 transition-all flex items-center justify-center gap-2\"\n            >\n              {submitting ? (\n                <>\n                  <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                  <span>A enviar proposta...</span>\n                </>\n              ) : (\n                <>\n                  <Send className=\"w-4 h-4\" />\n                  <span>Enviar Proposta de Parceria</span>\n                </>\n              )}\n            </button>\n          </div>\n        </form>\n      </section>\n    </div>\n  );\n};\n"
