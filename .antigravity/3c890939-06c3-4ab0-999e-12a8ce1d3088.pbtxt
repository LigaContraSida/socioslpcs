      thinking_signature: "\022\321\b\n\316\b\001i\024}\023\262\347\r\311\335_\201\374\271x\325\333\"\020Q!\036\320^\274*\254&8\360\352_\251\372\036d}\r\245/hS\323\021\200\006\213\275X;\fP\275V\034cZ\222\005 \254\b\254&\351\234\321;\352\226r\234\251\254\360\376%\263\030\004\247w\250Z\362\237\226\023\3530\205\351\033s\214xZ\255\273\332-.O3\270q\203\222TJ\2675\217$\b\004ZI\242\371N\032\241\201\246\230@\223K?\362!\321=N\2419\017\032\223\201\337\346\034\017w\234>\335B\235\332\234\232\021\213\371\252v\362\261!\241\fh\301\354o\227\365\030\037u!@\337(\377\257\307\327ik\326\261d\247\344Qy\341TO\251\205\030\213\353<yg\355\375\326q\326\020\273\316\034z&\344\033\034%\362\371\250\303#\330\255\033\353\371\215\005\360\326}\221\242\'\250\206:\270\366\031\202\212\000v?P\234\366\351\021w\3610\267\227T\027o]8\257<*\026z{uQ?Y{\305:\2206N\214\3232~\371\311\037\327\v(/\037\031\r\354\350\33130\223L\006\002\b>\026\2620\2074zu,\240\377\2158\342u\237\274\373\021IW\205U\026sl\027\260\251\312\313,[\024\002\2544\357\265Os\3628\352\'\365\f\252\225\021\272\265D\246\345\017uD\344<\330K\037\330\032\230\b\216\301\231\276J\374\334\177\313\367\261\372l\245\254\177\254\314\177\327\364\320\347\002.\004d\351\316\354\223\357B7\223\370S0\213\243\270>\355\354tN\365\2124n(y=/\021!\257\306;\324\221\t\037\275\264qV\244+u\3721\276\3023z\272h\f\213\024\f\\uX\300\326\371\037\336\021-\220T\025\216\262S\301\002\206UiJ\267\277\253\213\350v\226\3336\033p\354\310\252S\372\354\256\310\265\253\207\033*\315\261\351/JUb0\340\272U\035+\240\240{\277\217:\2679\'\207\035<\346\310.\235\254\321\rJgn .\325`l\304:\227:{\377\234\231C\335\002QyJm\275\251\034B!6\025\314\333\002\305N17\227\033`\327\025CAe~d\366R\r\t\375\360\321\330~\217\311\232\234\225\016W\353\256\314\003|\333\213\240\253\371\025\310\215,\373\036\217\321BM\210ae:\343\260\034\3478\370\364\375\324\315\365\245\030\026a\255\313@y\244P\240\357\210_\023g\270\331\3132d\336\000s\"-\320$\031@\273\323\325N_\337\345\331\n$\241\277u=~H\300\356\033\376\374K\202\023\350 \a\240\2