      thinking_signature: "\022\327\021\n\324\021\001i\024}\023\312\343c\333i6\337s\304\027\335\ri\024\262l\357\'X\236\231\267P\347\322\016A\322D\275&\0206k\177\211\\\031\223m2}\241\t\356\222\305i[_\307q\234[\3211\006R\006\377n\330$\204;\005\363\303\331\230i\n\2025\030Y\230N}+\276\217\353\000\374\202E\270\004?C\343\266\336]\234X/@\212\246\005\273_\262\t\343\364@\245\373\227R\325\037>+h\227dz\336\327\225\3766\345\245\t\355\204\223\t\037\217uLK\023\200W?\373\341\024\a\376\3777\255K\212$\025\022\242hJ\206mL\267(`2\366\236\217\002\270\247\352\016\331^\325\276W\214\311@\375\n\307&\221\240\204\213\303P\257@?\031a\033\336\215\370\231P\217\002\v`\221T\217/\213\204\247.@&/\355\236\304`\342\257\027?\373\224\017\361\226\362-\036\267>^\236Rf\301X.\364\031\346\032\200o\377\342\000x\004\347\205\032\241\204\315u\021\302\272\351\370C\255\321\351\030%X\363\017\235\3646\"\335\322Z\337\v\250z,\341]\352-\302\274IdD\262\243\256M\001\345\255T}\307\346z=\340\036;q\377\345\314\b\276\353\034\224\232\342\355\256\202=\311\300i\326\025,+C|`\276\017Z=\256\346r3\017\262\036C1U]\205\370\352kDp\356\342\020\b\233\240WZ \'\300\004\221\303\023$m:Y\270\004\024\374s\222\235\311\245\213\036)}\347\bC\267\b\356\216g\261K=\345\277\240\037\266i\0242v]#\271\277\332T\262\205W\324\307E\373t|\216\244\020D\330\245\263\003\231\242\224%N\215\270o\2104t8\211\237\'B\032\027\302\330\030\377!\353#7 \364b \n_\037\324\313QE\023\f\037\330\331f\016\2324\230\335c\307\222EG\367\253+\343\305\202\266\315\'\b\376R\363u\322\305}\376\022\343^\020\340\346\306nK\f\231\312\037\036\017\034\225\242\t\027xA\253\\P\224\337\2171\250ts\353\036\377+\240\321b\036\017\372\214\232\375\305\353,\240\372\vmq\221\244~;f\263\216\213\271f\301\356\206D:\204\016\332\"\320\220\254t\222\005\353\346\311\242\027\3225\001`\217c\232\263O\302\005\207w2\202v\374m\325b\3624\275\275\372\377$\035\027\247\270\004\033\242\374\347\302#8\331\006\031\352_\254\371\fY\375\341U\337\266\331\241\324\241\327\030\267s\025F%*\233B\214\227n\022}\202W\312\003\177\037D\246\302St\370\232\257\277\017V\201\363\271\270Y\224\270\327\331\030:\265`jf.\345{t\222\255\360\346^\312d\nZ\376\362\213L!\310\t\033\343\267\332\021\233\204\340\335_D\242\345:\232\204\345#\275}\016\262\b\027\267\370\006\355\367\354*\2439\320\325\363\261\214\211u1\\\226c\252\000I\275z\330\362\306\270Z\272\230r\370_\372Ke\222$\310\006\001Gk\2030X<y\303\006\300\366\316\220\177\207\177\233P\270\322!\242\377oA\307rd4\243MV\354\315`J\022\270}\320\235\204\'\030}\354\357{\233\0026\365\rE;\227\221hh&\005\317\006\313\036.\330\314pVLc\"W\345\316\230\375\206\2707\352\3377@\323\021~\214I\016s\346\n\bTf\2651LC[v\321b\003\367XE\370\221 !\271\234\242TG\352\017\325\3277j\017\177rG\362\231?\363\306 \020\364\017\246\261\212\227\266t\n\2348\f\200\031SYA\262PO\370\3633\005\"\315\nKQ\265\305M\333\034o\003Gy\"\275\f z\315\271\270\212\210\v\240.\310\336\363sqr\3615\024\2050.\370,\310\235+V/\367\340f\222\264h\321\266\001\215D\2760\256\017\315\aG\317\277\000K\016!G.\267o\222\rgn\237\210\207s+f\317\2558\343;\355OV\253>\265\005\372\312\305\376\201g\325\341\273JJC\340\244V3DG\224\270c\205\2173?%`\033nie`\202\226H!\020\305eD\340\2645_X\332\376\213\352\241\342\310x\005\350\365_\v \265\357z\244\263;\337\206\027\000\360ggV3[\276\374\243X\210\325?!\356/\366\304\3426\241\'\337\025\023\255\267c\032L\377\377%\367=\337\234c\360\254lN\345$S\342\247\332\370\'\305#\201YL%\272<\031R4\343\304\026f\240\362H\201\241\016\225\364\221\252\276\342\306 \2368E\f\206\315\033T\\w\ra\216\313r\344a\263\005\021\257I\267qz\250\320\nj\t*EN\213\311g\320\037\343\246I3\261\257\237\371-\352/iaF\346\225\2666\233\221\363U\237b\331\254p\261~}\304 mN\313ZK:\264\342\255\355\r\001HN\260\000\366\345\246{\325\264\316\330K-\033\304\3001E\034\370\266\347\355\353q\234\036\004`\223w*\030\234\225\200\214%-\257s^\r\261\350C\310\021z\313VM0`d\366gc\240\322%V\225\257\a;mh\363\b\241[\365D\001e7\210\316\223\213\220\211\2524|W\205\305\030\231\327\261\314\3743\n\267\217p\355\246\216d@P\252\307k\2157\364\344\276J\020\341F\025\227ej\306a\231\231\324\342\370\024BR\330\251\242Jyx\360C\004\217\213A\351\242I\353\"\350\346M\022\364\000\206W\213\226\271\235\322m\217R\300\036\324\204\\\321\246\270\034\353\177\207\243T\303\343\211>\355\351_\343&\251\ra\247\305\310\241\321&\316A7\272\311\ti\302\330\376\217\275\376\000\346c\236\240\240\230~\327w{\337}-X\035\362\207S\346\227\257\245\216N\267q\347\177\351F\016gGz\334\2156\033\332=\376J\201\242\025\234\200\352i[~\327Uu\004\222\016iw\323tf\244\246\210\247\323\025\256\344\204\t\367<\314\262\313E\\\356`\254I8`u\357\231\356\232\314\250b)\317\305\220e\235^\262\310Hy\304\334\305z\267\364\261N\320\345,3\245\375\371+\037n\'{\266\267\357\254\263/J\\\207\347\221\221\323d.\340\2775\246w0\311\313\321\310\226\277\201f\226\271\345\316\212sN\361\265M\250\217E\212\333\350(\035\035\334\031[\341\031\347\326w\243|A\254\241\017q\372*\376\016\355\214\f\342C\356S4\275\016ER!\302e\253\f\217\"\327\001V\3051\207\022H%K\000%\247m[\022mj}L-\303>5}R\313HCf\366z2v\262\0275g$\207\200\033\270\220\244t\267\004\265\031\204\b\260\200\324\236\325D\005\362\vI\312\224\357\006\334^$\303\027\277&\320\361\200\251\224VS\034\256\322\000f\226N\263S\245I!\340\275\376Q!\tKcA\372\000{Y4_\302\234= \037\177-\243s\325\024\3333\022e\032\023I\231\316i\350\351\341\330}d\226\313\323A\f\"\211\360:\035QX\f\302\f\205\n\266\265\223U2\204\020[g\235T\356}\006\027\004F\321\344\307@\3209\\\302\005p\200o\016\203s!\234\253\366\361Y\033\323>\337\226\373o\334\223\214\326\223\371R\230^n@\335\371\241-r>\\\371\002\'E\244W\177\031\303\ni2\366\234\237h^~\022\001\a\345\022\261\256x\001\256\030\202\236\037\\\311\355:\321\243\377c\016\344\246\247\352\373\312\264\v\365\223\317\177\221O+\277\267\214\037\340S\274x{\b+\0061\262\020\376\372\341\310b\267\307\027\317Q\200\"\336L\345{\264\201}[\250pH\006\3124e\242mu>EX\005\021R\351Ll\262p\207\354kr!Mx5b\006\202&\334\216\247\213\371\270\332\001\304;>>\212\335%\3355\255\216E&;(CX\341\275\320s\2040eP\222q\002\347_\243?r\374RA\305\000\215K\273\"T\2671\375\366\v\027\337/\316\0326\306\322mi\212\376\355I\210\2717C\355\275*:\253\254ss*\254\344\016}\2543=!\351\241\t\231D\255\340\342\211\315\225\343\211J,7\033\371\317t\274\264\027\353\255\354\004R*\207\363E(\276|#x\bs\335\260wZ\256:O%\227\223r\377\234I=\356\264\313\362\025\020\347\270\352{\tj\203k\215\255ia\030x\037\037\302Mx=x\265\b+\311r\031A)\037\030\024\2373M\251;\022\3313N|:\361=\t\266\370\032\327/\016\220\257\370\215\003\225,:\350,\253\230\237\340\371\330$\307\246\314\003BA;\227\266\241\223\020;"
