    thinking: "**Upgrading AdminPage.tsx**\n\nI\'m currently focused on upgrading `AdminPage.tsx`. I\'ve noted the need to replace `process.env.ADMIN_EMAIL` on line 41 with either `import.meta.env` or, for cleaner code, just the direct email string, avoiding `process.env` in the client-side Vite environment. This upgrade is underway.\n\n\n"
    tool_calls {
      id: "call_2560064191021294051"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { User, AuditLog } from \'../types.ts\';\\nimport {\\n  ShieldAlert,\\n  Users,\\n  Store,\\n  TrendingUp,\\n  Plus,\\n  Trash2,\\n  Edit,\\n  Power,\\n  Search,\\n  CheckCircle2,\\n  RefreshCw,\\n  Lock,\\n  X,\\n  Building2,\\n} from \'lucide-react\';\\n\\ninterface AdminPageProps {\\n  user: User | null;\\n  isAdmin: boolean;\\n  onNavigate: (path: string) => void;\\n}\\n\\nexport const AdminPage: React.FC<AdminPageProps> = ({ user, isAdmin, onNavigate }) => {\\n  if (!user || !isAdmin) {\\n    return (\\n      <div className=\\\"max-w-md mx-auto px-4 py-20 text-center space-y-4\\\">\\n        <div className=\\\"w-12 h-12 rounded-xl bg-red-50 text-[#C81E2B] border border-red-200 flex items-center justify-center mx-auto\\\">\\n          <Lock className=\\\"w-6 h-6\\\" />\\n        </div>\\n        <h2 className=\\\"font-display text-2xl font-semibold text-[#141619]\\\">Acesso Restrito</h2>\\n        <p className=\\\"text-sm text-stone-600\\\">\\n          Esta \303\241rea \303\251 reservada exclusivamente ao administrador oficial da Liga Portuguesa Contra a SIDA (admin@lpcs.pt).\\n        </p>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/\')}\\n          className=\\\"px-5 py-2.5 rounded-lg bg-[#141619] text-white text-xs font-semibold\\\"\\n        >\\n          Voltar \303\240 P\303\241gina Principal\\n        </button>\\n      </div>\\n    );\\n  }\\n\\n  const [activeTab, setActiveTab] = useState<\'summary\' | \'users\' | \'partners\' | \'inquiries\' | \'audit\'>(\'summary\');\\n  const [summaryData, setSummaryData] = useState<any | null>(null);\\n  const [usersList, setUsersList] = useState<any[]>([]);\\n  const [partnersList, setPartnersList] = useState<any[]>([]);\\n  const [inquiriesList, setInquiriesList] = useState<any[]>([]);\\n  const [auditLogs, setAuditLogs] = useState<AuditLog[]>([]);\\n  const [loading, setLoading] = useState(true);\\n\\n  const [userFilter, setUserFilter] = useState<\'todos\' | \'ativos\' | \'inativos\' | \'suspensos\'>(\'todos\');\\n  const [userSearch, setUserSearch] = useState(\'\');\\n  const [manualQuotaModalUser, setManualQuotaModalUser] = useState<any | null>(null);\\n  const [manualQuotaPlan, setManualQuotaPlan] = useState<\'semestral\' | \'anual\'>(\'anual\');\\n  const [manualQuotaNotes, setManualQuotaNotes] = useState(\'Pagamento por transfer\303\252ncia banc\303\241ria\');\\n\\n  const [partnerModalOpen, setPartnerModalOpen] = useState(false);\\n  const [editingPartner, setEditingPartner] = useState<any | null>(null);\\n  const [partnerFormData, setPartnerFormData] = useState({\\n    name: \'\',\\n    category: \'\',\\n    description: \'\',\\n    area: \'Sa\303\272de e Bem-estar\',\\n    district: \'Lisboa\',\\n    city: \'Lisboa\',\\n    benefit_type: \'codigo\',\\n    benefit_value: \'\',\\n    discount_highlight: \'\',\\n    usage_limit: \'Utiliza\303\247\303\243o cont\303\255nua\',\\n    estimated_annual_savings: \'50.0\',\\n    valid_until: \'2027-12-31\',\\n    terms: \'V\303\241lido mediante apresenta\303\247\303\243o do cart\303\243o ou c\303\263digo de s\303\263cio.\',\\n    website: \'\',\\n    is_active: true,\\n    secret_code: \'\',\\n  });\\n\\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\\n\\n  const showToast = (msg: string) => {\\n    setToastMessage(msg);\\n    setTimeout(() => setToastMessage(null), 3500);\\n  };\\n\\n  const loadSummary = () => {\\n    fetch(\'/api/admin/summary\', { credentials: \'same-origin\' })\\n      .then((r) => r.json())\\n      .then((data) => {\\n        setSummaryData(data);\\n        if (data.recentLogs) setAuditLogs(data.recentLogs);\\n      });\\n  };\\n\\n  const loadUsers = () => {\\n    const params = new URLSearchParams();\\n    if (userFilter !== \'todos\') params.set(\'filter\', userFilter);\\n    if (userSearch.trim()) params.set(\'search\', userSearch.trim());\\n\\n    fetch(`/api/admin/users?${params.toString()}`, { credentials: \'same-origin\' })\\n      .then((r) => r.json())\\n      .then((data) => setUsersList(data.users || []));\\n  };\\n\\n  const loadPartners = () => {\\n    fetch(\'/api/partners\', { credentials: \'same-origin\' })\\n      .then((r) => r.json())\\n      .then((data) => setPartnersList(data.partners || []));\\n  };\\n\\n  const loadInquiries = () => {\\n    fetch(\'/api/admin/inquiries\', { credentials: \'same-origin\' })\\n      .then((r) => r.json())\\n      .then((data) => setInquiriesList(data.inquiries || []));\\n  };\\n\\n  useEffect(() => {\\n    setLoading(true);\\n    Promise.all([\\n      fetch(\'/api/admin/summary\', { credentials: \'same-origin\' }).then((r) => r.json()),\\n      fetch(\'/api/admin/users\', { credentials: \'same-origin\' }).then((r) => r.json()),\\n      fetch(\'/api/partners\', { credentials: \'same-origin\' }).then((r) => r.json()),\\n      fetch(\'/api/admin/inquiries\', { credentials: \'same-origin\' }).then((r) => r.json()),\\n    ])\\n      .then(([summary, users, partners, inquiries]) => {\\n        setSummaryData(summary);\\n        if (summary.recentLogs) setAuditLogs(summary.recentLogs);\\n        setUsersList(users.users || []);\\n        setPartnersList(partners.partners || []);\\n        setInquiriesList(inquiries.inquiries || []);\\n        setLoading(false);\\n      })\\n      .catch((err) => {\\n        console.error(\'Error fetching admin data:\', err);\\n        setLoading(false);\\n      });\\n  }, []);\\n\\n  useEffect(() => {\\n    if (activeTab === \'users\') {\\n      loadUsers();\\n    }\\n  }, [userFilter, userSearch, activeTab]);\\n\\n  const handleToggleSuspend = async (userId: number) => {\\n    try {\\n      const res = await fetch(`/api/admin/users/${userId}/suspend`, {\\n        method: \'POST\',\\n        credentials: \'same-origin\',\\n      });\\n      const data = await res.json();\\n      if (res.ok) {\\n        showToast(data.message);\\n        loadUsers();\\n        loadSummary();\\n      } else {\\n        showToast(data.error || \'Erro ao alterar estado da conta.\');\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const handleDeleteUser = async (userId: number, name: string) => {\\n    if (\\n      !window.confirm(\\n        `Tem a certeza que deseja eliminar a conta de ${name} e todos os dados associados? Esta a\303\247\303\243o \303\251 irrevers\303\255vel.`\\n      )\\n    )\\n      return;\\n\\n    try {\\n      const res = await fetch(`/api/admin/users/${userId}`, {\\n        method: \'DELETE\',\\n        credentials: \'same-origin\',\\n      });\\n      const data = await res.json();\\n      if (res.ok) {\\n        showToast(data.message);\\n        loadUsers();\\n        loadSummary();\\n      } else {\\n        showToast(data.error || \'Erro ao eliminar conta.\');\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const handleGrantManualQuota = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!manualQuotaModalUser) return;\\n\\n    try {\\n      const res = await fetch(`/api/admin/users/${manualQuotaModalUser.id}/quota`, {\\n        method: \'POST\',\\n        credentials: \'same-origin\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          plan_type: manualQuotaPlan,\\n          notes: manualQuotaNotes,\\n        }),\\n      });\\n\\n      const data = await res.json();\\n      if (res.ok) {\\n        showToast(data.message);\\n        setManualQuotaModalUser(null);\\n        loadUsers();\\n        loadSummary();\\n      } else {\\n        showToast(data.error || \'Erro ao lan\303\247ar quota.\');\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const handleSavePartner = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const isEdit = !!editingPartner;\\n    const url = isEdit ? `/api/admin/partners/${editingPartner.id}` : \'/api/admin/partners\';\\n    const method = isEdit ? \'PUT\' : \'POST\';\\n\\n    try {\\n      const res = await fetch(url, {\\n        method,\\n        credentials: \'same-origin\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify(partnerFormData),\\n      });\\n\\n      const data = await res.json();\\n      if (res.ok) {\\n        showToast(isEdit ? \'Parceiro atualizado com sucesso.\' : \'Novo parceiro adicionado.\');\\n        setPartnerModalOpen(false);\\n        setEditingPartner(null);\\n        loadPartners();\\n        loadSummary();\\n      } else {\\n        showToast(data.error || \'Erro ao guardar parceiro.\');\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const handleTogglePartner = async (partnerId: number) => {\\n    try {\\n      const res = await fetch(`/api/admin/partners/${partnerId}/toggle`, {\\n        method: \'POST\',\\n        credentials: \'same-origin\',\\n      });\\n      if (res.ok) {\\n        showToast(\'Estado do parceiro alterado.\');\\n        loadPartners();\\n        loadSummary();\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const handleDeletePartner = async (partnerId: number, name: string) => {\\n    if (!window.confirm(`Tem a certeza que deseja remover o parceiro \\\"${name}\\\"?`)) return;\\n\\n    try {\\n      const res = await fetch(`/api/admin/partners/${partnerId}`, {\\n        method: \'DELETE\',\\n        credentials: \'same-origin\',\\n      });\\n      if (res.ok) {\\n        showToast(\'Parceiro removido com sucesso.\');\\n        loadPartners();\\n        loadSummary();\\n      }\\n    } catch (err) {\\n      console.error(err);\\n    }\\n  };\\n\\n  const openNewPartnerModal = () => {\\n    setEditingPartner(null);\\n    setPartnerFormData({\\n      name: \'\',\\n      category: \'Geral\',\\n      description: \'\',\\n      area: \'Sa\303\272de e Bem-estar\',\\n      district: \'Lisboa\',\\n      city: \'Lisboa\',\\n      benefit_type: \'codigo\',\\n      benefit_value: \'20% de desconto\',\\n      discount_highlight: \'20% em servi\303\247os\',\\n      usage_limit: \'Utiliza\303\247\303\243o cont\303\255nua\',\\n      estimated_annual_savings: \'50.0\',\\n      valid_until: \'2027-12-31\',\\n      terms: \'V\303\241lido mediante apresenta\303\247\303\243o do cart\303\243o ou c\303\263digo de s\303\263cio.\',\\n      website: \'\',\\n      is_active: true,\\n      secret_code: \'PARCEIRO20\',\\n    });\\n    setPartnerModalOpen(true);\\n  };\\n\\n  const openEditPartnerModal = (p: any) => {\\n    setEditingPartner(p);\\n    setPartnerFormData({\\n      name: p.name,\\n      category: p.category,\\n      description: p.description,\\n      area: p.area,\\n      district: p.district,\\n      city: p.city,\\n      benefit_type: p.benefit_type,\\n      benefit_value: p.benefit_value,\\n      discount_highlight: p.discount_highlight,\\n      usage_limit: p.usage_limit,\\n      estimated_annual_savings: String(p.estimated_annual_savings),\\n      valid_until: p.valid_until,\\n      terms: p.terms,\\n      website: p.website || \'\',\\n      is_active: p.is_active !== 0,\\n      secret_code: p.secret_code || \'CODE10\',\\n    });\\n    setPartnerModalOpen(true);\\n  };\\n\\n  const metrics = summaryData?.metrics || {\\n    totalAssociados: 0,\\n    associadosQuotaAtiva: 0,\\n    associadosInativos: 0,\\n    associadosSuspensos: 0,\\n    parceirosAtivos: 0,\\n    parceirosInativos: 0,\\n    receitaTotalEuros: 0,\\n    descontosResgatados: 0,\\n    descontosEmitidosTotal: 0,\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\\\">\\n      {toastMessage && (\\n        <div className=\\\"fixed bottom-6 right-6 z-50 px-4 py-3 bg-[#141619] text-white rounded-xl border border-stone-700 shadow-lg flex items-center gap-2.5 text-xs font-medium\\\">\\n          <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400 shrink-0\\\" />\\n          <span>{toastMessage}</span>\\n        </div>\\n      )}\\n\\n      {/* Top Admin Header */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-stone-200 pb-6\\\">\\n        <div>\\n          <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\\\">\\n            Administra\303\247\303\243o Institucional\\n          </div>\\n          <h1 className=\\\"font-display text-3xl font-semibold text-[#141619] tracking-tight mt-1\\\">\\n            Backoffice LPCS\\n          </h1>\\n          <p className=\\\"text-sm text-stone-600 mt-1\\\">\\n            Gest\303\243o de associados, lan\303\247amento de quotas, parceiros comerciais e auditoria.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              loadSummary();\\n              loadUsers();\\n              loadPartners();\\n              loadInquiries();\\n              showToast(\'Dados sincronizados.\');\\n            }}\\n            className=\\\"px-3.5 py-2 rounded-lg border border-stone-300 bg-white text-stone-700 hover:bg-stone-50 text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap\\\"\\n          >\\n            <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Sincronizar</span>\\n          </button>\\n          <div className=\\\"text-right text-xs hidden sm:block\\\">\\n            <span className=\\\"text-stone-400 block\\\">Sess\303\243o Admin</span>\\n            <span className=\\\"font-mono font-semibold text-[#141619]\\\">{user.email}</span>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Navigation Tabs */}\\n      <div className=\\\"flex border-b border-stone-200 gap-6 overflow-x-auto\\\">\\n        {[\\n          { id: \'summary\', name: \'Resumo Geral\', icon: TrendingUp },\\n          { id: \'users\', name: \'Associados\', icon: Users, count: metrics.totalAssociados },\\n          { id: \'partners\', name: \'Parceiros\', icon: Store, count: metrics.parceirosAtivos },\\n          { id: \'inquiries\', name: \'Propostas de Parceria\', icon: Building2, count: inquiriesList.length },\\n          { id: \'audit\', name: \'Auditoria\', icon: ShieldAlert },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = activeTab === tab.id;\\n          return (\\n            <button\\n              type=\\\"button\\\"\\n              key={tab.id}\\n              onClick={() => setActiveTab(tab.id as any)}\\n              className={`py-3 text-xs font-semibold border-b-2 transition-colors flex items-center gap-2 whitespace-nowrap shrink-0 tabular-nums ${\\n                active\\n                  ? \'border-[#C81E2B] text-[#141619]\'\\n                  : \'border-transparent text-stone-500 hover:text-[#141619]\'\\n              }`}\\n            >\\n              <Icon className=\\\"w-4 h-4\\\" />\\n              <span>{tab.name}</span>\\n              {tab.count !== undefined && (\\n                <span className=\\\"font-mono text-stone-400\\\">({tab.count})</span>\\n              )}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {loading ? (\\n        <div className=\\\"py-16 text-center text-sm text-stone-500\\\">A carregar dados do backoffice...</div>\\n      ) : (\\n        <>\\n          {/* TAB 1: SUMMARY */}\\n          {activeTab === \'summary\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div className=\\\"bg-white rounded-xl border border-stone-200 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-stone-200\\\">\\n                <div className=\\\"p-6\\\">\\n                  <span className=\\\"text-xs font-semibold uppercase tracking-wider text-stone-500\\\">\\n                    Associados Registados\\n                  </span>\\n                  <div className=\\\"text-3xl font-mono font-bold text-[#141619] mt-2 tabular-nums\\\">\\n                    {metrics.totalAssociados}\\n                  </div>\\n                  <span className=\\\"text-xs text-emerald-700 font-medium mt-1 block tabular-nums\\\">\\n                    {metrics.associadosQuotaAtiva} com quota ativa\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"p-6\\\">\\n                  <span className=\\\"text-xs font-semibold uppercase tracking-wider text-stone-500\\\">\\n                    Receita de Quotas\\n                  </span>\\n                  <div className=\\\"text-3xl font-mono font-bold text-emerald-700 mt-2 tabular-nums\\\">\\n                    {metrics.receitaTotalEuros.toFixed(2)} \342\202\254\\n                  </div>\\n                  <span className=\\\"text-xs text-stone-500 mt-1 block\\\">Fundos para miss\303\243o LPCS</span>\\n                </div>\\n\\n                <div className=\\\"p-6\\\">\\n                  <span className=\\\"text-xs font-semibold uppercase tracking-wider text-stone-500\\\">\\n                    Parceiros Ativos\\n                  </span>\\n                  <div className=\\\"text-3xl font-mono font-bold text-[#141619] mt-2 tabular-nums\\\">\\n                    {metrics.parceirosAtivos}\\n                  </div>\\n                  <span className=\\\"text-xs text-stone-500 mt-1 block tabular-nums\\\">\\n                    {metrics.parceirosInativos} desativados\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"p-6\\\">\\n                  <span className=\\\"text-xs font-semibold uppercase tracking-wider text-stone-500\\\">\\n                    Descontos Validados\\n                  </span>\\n                  <div className=\\\"text-3xl font-mono font-bold text-[#C81E2B] mt-2 tabular-nums\\\">\\n                    {metrics.descontosResgatados}\\n                  </div>\\n                  <span className=\\\"text-xs text-stone-500 mt-1 block tabular-nums\\\">\\n                    De {metrics.descontosEmitidosTotal} c\303\263digos emitidos\\n                  </span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-white rounded-2xl border border-stone-200 overflow-hidden\\\">\\n                <div className=\\\"px-6 py-4 border-b border-stone-200\\\">\\n                  <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                    Atividade Recente no Sistema\\n                  </h3>\\n                </div>\\n                <div className=\\\"divide-y divide-stone-100 text-xs\\\">\\n                  {auditLogs.slice(0, 8).map((log) => (\\n                    <div key={log.id} className=\\\"px-6 py-3.5 flex items-start justify-between gap-4\\\">\\n                      <div>\\n                        <span className=\\\"font-semibold text-[#141619] block\\\">{log.action}</span>\\n                        <span className=\\\"text-stone-600\\\">{log.details}</span>\\n                        {log.user_name && (\\n                          <span className=\\\"text-stone-400 block mt-0.5 font-mono text-[11px]\\\">\\n                            {log.user_name} \302\267 {log.member_number}\\n                          </span>\\n                        )}\\n                      </div>\\n                      <span className=\\\"text-[11px] font-mono text-stone-400 shrink-0 tabular-nums\\\">\\n                        {new Date(log.created_at).toLocaleTimeString(\'pt-PT\')}\\n                      </span>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* TAB 2: USERS */}\\n          {activeTab === \'users\' && (\\n            <div className=\\\"space-y-5\\\">\\n              <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-4 rounded-xl border border-stone-200\\\">\\n                <div className=\\\"relative flex-1 max-w-md\\\">\\n                  <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n                  <input\\n                    type=\\\"text\\\"\\n                    placeholder=\\\"Pesquisar por nome, email, NIF ou n\302\272 s\303\263cio...\\\"\\n                    value={userSearch}\\n                    onChange={(e) => setUserSearch(e.target.value)}\\n                    className=\\\"w-full pl-9 pr-4 py-2 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-xs focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-1.5 overflow-x-auto\\\">\\n                  {[\\n                    { id: \'todos\', label: \'Todos\' },\\n                    { id: \'ativos\', label: \'Quota Ativa\' },\\n                    { id: \'inativos\', label: \'Inativos\' },\\n                    { id: \'suspensos\', label: \'Suspensos\' },\\n                  ].map((f) => (\\n                    <button\\n                      type=\\\"button\\\"\\n                      key={f.id}\\n                      onClick={() => setUserFilter(f.id as any)}\\n                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap ${\\n                        userFilter === f.id\\n                          ? \'bg-[#141619] text-white\'\\n                          : \'bg-[#FAF8F5] border border-stone-200 text-stone-700 hover:border-stone-400\'\\n                      }`}\\n                    >\\n                      {f.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-white rounded-2xl border border-stone-200 overflow-hidden\\\">\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left text-xs text-stone-600\\\">\\n                    <thead className=\\\"bg-[#FAF8F5] text-[11px] uppercase font-semibold text-stone-500 border-b border-stone-200\\\">\\n                      <tr>\\n                        <th className=\\\"py-3 px-4\\\">S\303\263cio</th>\\n                        <th className=\\\"py-3 px-4\\\">N\302\272 S\303\263cio / NIF</th>\\n                        <th className=\\\"py-3 px-4\\\">Localidade</th>\\n                        <th className=\\\"py-3 px-4\\\">Estado Quota</th>\\n                        <th className=\\\"py-3 px-4\\\">Conta</th>\\n                        <th className=\\\"py-3 px-4 text-right\\\">A\303\247\303\265es</th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-stone-100\\\">\\n                      {usersList.map((u) => {\\n                        const isSelf = u.id === user.id;\\n                        const hasActiveQuota = u.quota_status?.has_active_quota;\\n\\n                        return (\\n                          <tr key={u.id} className=\\\"hover:bg-stone-50/70\\\">\\n                            <td className=\\\"py-3 px-4\\\">\\n                              <strong className=\\\"text-[#141619] block\\\">{u.name}</strong>\\n                              <span className=\\\"text-[11px] text-stone-500\\\">{u.email}</span>\\n                            </td>\\n                            <td className=\\\"py-3 px-4 font-mono tabular-nums\\\">\\n                              <span className=\\\"font-semibold text-[#141619] block\\\">{u.member_number}</span>\\n                              <span className=\\\"text-[11px] text-stone-500\\\">NIF {u.nif}</span>\\n                            </td>\\n                            <td className=\\\"py-3 px-4 text-stone-700\\\">{u.city}</td>\\n                            <td className=\\\"py-3 px-4 tabular-nums\\\">\\n                              {hasActiveQuota ? (\\n                                <span className=\\\"font-semibold text-emerald-700\\\">\\n                                  V\303\241lida at\303\251 {u.quota_status.valid_until}\\n                                </span>\\n                              ) : (\\n                                <span className=\\\"font-semibold text-[#C81E2B]\\\">Expirada / Inativa</span>\\n                              )}\\n                            </td>\\n                            <td className=\\\"py-3 px-4\\\">\\n                              {u.is_suspended === 1 ? (\\n                                <span className=\\\"font-semibold text-[#C81E2B]\\\">Suspensa</span>\\n                              ) : (\\n                                <span className=\\\"font-medium text-emerald-700\\\">Normal</span>\\n                              )}\\n                            </td>\\n                            <td className=\\\"py-3 px-4 text-right space-x-1.5 whitespace-nowrap\\\">\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => setManualQuotaModalUser(u)}\\n                                className=\\\"px-2.5 py-1 rounded-md border border-stone-300 bg-white hover:bg-stone-50 text-[#141619] font-semibold text-[11px]\\\"\\n                              >\\n                                + Quota\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleToggleSuspend(u.id)}\\n                                disabled={isSelf}\\n                                className={`p-1.5 rounded-md ${\\n                                  isSelf\\n                                    ? \'opacity-30 cursor-not-allowed\'\\n                                    : u.is_suspended === 1\\n                                    ? \'text-emerald-700 hover:bg-emerald-50\'\\n                                    : \'text-amber-700 hover:bg-amber-50\'\\n                                }`}\\n                                title={\\n                                  isSelf\\n                                    ? \'N\303\243o se pode suspender a si pr\303\263prio\'\\n                                    : u.is_suspended === 1\\n                                    ? \'Reativar conta\'\\n                                    : \'Suspender conta\'\\n                                }\\n                              >\\n                                <Power className=\\\"w-3.5 h-3.5\\\" />\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleDeleteUser(u.id, u.name)}\\n                                disabled={isSelf}\\n                                className={`p-1.5 rounded-md ${\\n                                  isSelf\\n                                    ? \'opacity-30 cursor-not-allowed\'\\n                                    : \'text-stone-400 hover:text-[#C81E2B] hover:bg-red-50\'\\n                                }`}\\n                                title={isSelf ? \'N\303\243o pode eliminar a sua pr\303\263pria conta\' : \'Eliminar conta\'}\\n                              >\\n                                <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                              </button>\\n                            </td>\\n                          </tr>\\n                        );\\n                      })}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* TAB 3: PARTNERS */}\\n          {activeTab === \'partners\' && (\\n            <div className=\\\"space-y-5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                  Cat\303\241logo de Parceiros LPCS\\n                </h3>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={openNewPartnerModal}\\n                  className=\\\"px-4 py-2 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-xs flex items-center gap-1.5\\\"\\n                >\\n                  <Plus className=\\\"w-4 h-4\\\" />\\n                  <span>Adicionar Parceiro</span>\\n                </button>\\n              </div>\\n\\n              <div className=\\\"bg-white rounded-2xl border border-stone-200 overflow-hidden\\\">\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left text-xs text-stone-600\\\">\\n                    <thead className=\\\"bg-[#FAF8F5] text-[11px] uppercase font-semibold text-stone-500 border-b border-stone-200\\\">\\n                      <tr>\\n                        <th className=\\\"py-3 px-4\\\">Parceiro</th>\\n                        <th className=\\\"py-3 px-4\\\">\303\201rea / Local</th>\\n                        <th className=\\\"py-3 px-4\\\">Desconto</th>\\n                        <th className=\\\"py-3 px-4\\\">C\303\263digo \303\232nico</th>\\n                        <th className=\\\"py-3 px-4\\\">Poupan\303\247a Est.</th>\\n                        <th className=\\\"py-3 px-4\\\">Estado</th>\\n                        <th className=\\\"py-3 px-4 text-right\\\">A\303\247\303\265es</th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-stone-100\\\">\\n                      {partnersList.map((p) => (\\n                        <tr key={p.id} className=\\\"hover:bg-stone-50/70\\\">\\n                          <td className=\\\"py-3 px-4\\\">\\n                            <strong className=\\\"text-[#141619] block\\\">{p.name}</strong>\\n                            <span className=\\\"text-[11px] text-stone-500\\\">{p.category}</span>\\n                          </td>\\n                          <td className=\\\"py-3 px-4\\\">\\n                            <span className=\\\"text-stone-800 block\\\">{p.area}</span>\\n                            <span className=\\\"text-[11px] text-stone-500\\\">\\n                              {p.city} ({p.district})\\n                            </span>\\n                          </td>\\n                          <td className=\\\"py-3 px-4\\\">\\n                            <span className=\\\"font-semibold text-[#C81E2B] block\\\">{p.discount_highlight}</span>\\n                            <span className=\\\"text-[11px] uppercase text-stone-400\\\">{p.benefit_type}</span>\\n                          </td>\\n                          <td className=\\\"py-3 px-4 font-mono font-semibold text-[#141619]\\\">\\n                            {p.secret_code || \'\342\200\224\'}\\n                          </td>\\n                          <td className=\\\"py-3 px-4 font-mono font-semibold text-[#141619] tabular-nums\\\">\\n                            {p.estimated_annual_savings} \342\202\254/ano\\n                          </td>\\n                          <td className=\\\"py-3 px-4\\\">\\n                            {p.is_active !== 0 ? (\\n                              <span className=\\\"font-semibold text-emerald-700\\\">Ativo</span>\\n                            ) : (\\n                              <span className=\\\"font-medium text-stone-500\\\">Inativo</span>\\n                            )}\\n                          </td>\\n                          <td className=\\\"py-3 px-4 text-right space-x-1 whitespace-nowrap\\\">\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => openEditPartnerModal(p)}\\n                              className=\\\"p-1.5 rounded-md text-stone-600 hover:text-[#141619] hover:bg-stone-100\\\"\\n                              title=\\\"Editar parceiro\\\"\\n                            >\\n                              <Edit className=\\\"w-3.5 h-3.5\\\" />\\n                            </button>\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleTogglePartner(p.id)}\\n                              className=\\\"p-1.5 rounded-md text-stone-600 hover:text-amber-700 hover:bg-amber-50\\\"\\n                              title=\\\"Ativar/Desativar\\\"\\n                            >\\n                              <Power className=\\\"w-3.5 h-3.5\\\" />\\n                            </button>\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleDeletePartner(p.id, p.name)}\\n                              className=\\\"p-1.5 rounded-md text-stone-400 hover:text-[#C81E2B] hover:bg-red-50\\\"\\n                              title=\\\"Remover parceiro\\\"\\n                            >\\n                              <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                            </button>\\n                          </td>\\n                        </tr>\\n                      ))}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* TAB 4: PARTNER INQUIRIES */}\\n          {activeTab === \'inquiries\' && (\\n            <div className=\\\"bg-white rounded-2xl border border-stone-200 overflow-hidden\\\">\\n              <div className=\\\"px-6 py-5 border-b border-stone-200 flex items-center justify-between\\\">\\n                <div>\\n                  <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                    Propostas de Parceria Empresarial\\n                  </h3>\\n                  <p className=\\\"text-xs text-stone-500 mt-0.5\\\">\\n                    Empresas interessadas em colaborar atrav\303\251s do formul\303\241rio de parceria.\\n                  </p>\\n                </div>\\n                <span className=\\\"text-xs font-mono text-stone-500 tabular-nums\\\">\\n                  Total: {inquiriesList.length}\\n                </span>\\n              </div>\\n\\n              {inquiriesList.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 p-8 text-center\\\">\\n                  Ainda n\303\243o foram submetidas propostas de parceria.\\n                </p>\\n              ) : (\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left text-xs text-stone-600\\\">\\n                    <thead className=\\\"bg-[#FAF8F5] text-[11px] uppercase font-semibold text-stone-500 border-b border-stone-200\\\">\\n                      <tr>\\n                        <th className=\\\"py-3 px-4\\\">Empresa / Contacto</th>\\n                        <th className=\\\"py-3 px-4\\\">\303\201rea / Local</th>\\n                        <th className=\\\"py-3 px-4\\\">Desconto Proposto</th>\\n                        <th className=\\\"py-3 px-4\\\">Estado</th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-stone-100\\\">\\n                      {inquiriesList.map((inq) => (\\n                        <tr key={inq.id} className=\\\"hover:bg-stone-50/70\\\">\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <strong className=\\\"text-[#141619] block\\\">{inq.company_name}</strong>\\n                            <span className=\\\"text-[11px] text-stone-500 block\\\">\\n                              {inq.contact_name} \302\267 {inq.email} \302\267 {inq.phone}\\n                            </span>\\n                            {inq.nif && (\\n                              <span className=\\\"text-[11px] font-mono text-stone-400\\\">NIPC: {inq.nif}</span>\\n                            )}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <span className=\\\"text-stone-800 block\\\">{inq.area}</span>\\n                            <span className=\\\"text-[11px] text-stone-500\\\">\\n                              {inq.city} ({inq.district})\\n                            </span>\\n                          </td>\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <span className=\\\"font-semibold text-[#C81E2B] block\\\">{inq.proposed_benefit}</span>\\n                            <span className=\\\"text-[11px] uppercase text-stone-400\\\">{inq.benefit_type}</span>\\n                            {inq.notes && (\\n                              <p className=\\\"text-[11px] text-stone-500 mt-1 max-w-xs\\\">{inq.notes}</p>\\n                            )}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <select\\n                              value={inq.status}\\n                              onChange={async (e) => {\\n                                const status = e.target.value;\\n                                const res = await fetch(`/api/admin/inquiries/${inq.id}/status`, {\\n                                  method: \'POST\',\\n                                  credentials: \'same-origin\',\\n                                  headers: { \'Content-Type\': \'application/json\' },\\n                                  body: JSON.stringify({ status }),\\n                                });\\n                                if (res.ok) {\\n                                  showToast(\'Estado da proposta atualizado.\');\\n                                  loadInquiries();\\n                                }\\n                              }}\\n                              className=\\\"py-1.5 px-2.5 rounded-lg border border-stone-300 text-xs font-medium bg-white\\\"\\n                            >\\n                              <option value=\\\"pendente\\\">Pendente</option>\\n                              <option value=\\\"em_analise\\\">Em An\303\241lise</option>\\n                              <option value=\\\"aprovada\\\">Aprovada</option>\\n                              <option value=\\\"recusada\\\">Recusada</option>\\n                            </select>\\n                          </td>\\n                        </tr>\\n                      ))}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              )}\\n            </div>\\n          )}\\n\\n          {/* TAB 5: AUDIT LOGS */}\\n          {activeTab === \'audit\' && (\\n            <div className=\\\"bg-white rounded-2xl border border-stone-200 overflow-hidden\\\">\\n              <div className=\\\"px-6 py-5 border-b border-stone-200 flex items-center justify-between\\\">\\n                <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                  Registo Completo de Auditoria\\n                </h3>\\n                <span className=\\\"text-xs font-mono text-stone-500 tabular-nums\\\">\\n                  {auditLogs.length} eventos\\n                </span>\\n              </div>\\n\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left text-xs text-stone-600\\\">\\n                  <thead className=\\\"bg-[#FAF8F5] text-[11px] uppercase font-semibold text-stone-500 border-b border-stone-200\\\">\\n                    <tr>\\n                      <th className=\\\"py-3 px-4\\\">Data / Hora</th>\\n                      <th className=\\\"py-3 px-4\\\">A\303\247\303\243o</th>\\n                      <th className=\\\"py-3 px-4\\\">Detalhes</th>\\n                      <th className=\\\"py-3 px-4\\\">S\303\263cio</th>\\n                      <th className=\\\"py-3 px-4\\\">Origem</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-stone-100\\\">\\n                    {auditLogs.map((log) => (\\n                      <tr key={log.id} className=\\\"hover:bg-stone-50/70\\\">\\n                        <td className=\\\"py-3 px-4 font-mono text-[11px] text-stone-500 whitespace-nowrap tabular-nums\\\">\\n                          {new Date(log.created_at).toLocaleString(\'pt-PT\')}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 font-semibold text-[#141619]\\\">{log.action}</td>\\n                        <td className=\\\"py-3 px-4 text-stone-700 max-w-sm truncate\\\">{log.details}</td>\\n                        <td className=\\\"py-3 px-4 text-stone-600\\\">\\n                          {log.user_name ? `${log.user_name} (${log.member_number})` : \'\342\200\224\'}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 font-mono text-[11px] text-stone-400 whitespace-nowrap tabular-nums\\\">\\n                          {log.ip_address || \'127.0.0.1\'}\\n                        </td>\\n                      </tr>\\n                    ))}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </div>\\n          )}\\n        </>\\n      )}\\n\\n      {/* MODAL: MANUAL QUOTA GRANT */}\\n      {manualQuotaModalUser && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#141619]/70 backdrop-blur-xs\\\">\\n          <div className=\\\"bg-white rounded-2xl p-6 sm:p-8 max-w-md w-full border border-stone-200 shadow-2xl space-y-5\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-stone-100 pb-3\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                Lan\303\247ar Quota Manualmente\\n              </h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setManualQuotaModalUser(null)}\\n                className=\\\"text-stone-400 hover:text-[#141619]\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n              Atribuir quota a <strong className=\\\"text-[#141619]\\\">{manualQuotaModalUser.name}</strong> (\\n              <span className=\\\"font-mono\\\">{manualQuotaModalUser.member_number}</span>) ap\303\263s confirma\303\247\303\243o de pagamento externo.\\n            </p>\\n\\n            <form onSubmit={handleGrantManualQuota} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"text-xs font-semibold text-stone-700 block mb-1.5\\\">\\n                  Plano de Quota\\n                </label>\\n                <select\\n                  value={manualQuotaPlan}\\n                  onChange={(e) => setManualQuotaPlan(e.target.value as any)}\\n                  className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs font-medium bg-white\\\"\\n                >\\n                  <option value=\\\"anual\\\">Anual (35,00 \342\202\254 \302\267 12 Meses)</option>\\n                  <option value=\\\"semestral\\\">Semestral (17,50 \342\202\254 \302\267 6 Meses)</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"text-xs font-semibold text-stone-700 block mb-1.5\\\">Nota Interna</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={manualQuotaNotes}\\n                  onChange={(e) => setManualQuotaNotes(e.target.value)}\\n                  className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                  placeholder=\\\"Ex: Transfer\303\252ncia banc\303\241ria comprovativo n\302\272 849\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex gap-2.5 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setManualQuotaModalUser(null)}\\n                  className=\\\"flex-1 py-2.5 rounded-lg border border-stone-300 text-xs font-semibold text-stone-700\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"flex-1 py-2.5 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white text-xs font-semibold\\\"\\n                >\\n                  Confirmar Lan\303\247amento\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* MODAL: ADD / EDIT PARTNER */}\\n      {partnerModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#141619]/70 backdrop-blur-xs overflow-y-auto\\\">\\n          <div className=\\\"bg-white rounded-2xl p-6 sm:p-8 max-w-2xl w-full border border-stone-200 shadow-2xl space-y-5 my-8\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-stone-100 pb-3\\\">\\n              <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">\\n                {editingPartner ? `Editar Parceiro: ${editingPartner.name}` : \'Adicionar Novo Parceiro\'}\\n              </h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setPartnerModalOpen(false)}\\n                className=\\\"text-stone-400 hover:text-[#141619]\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleSavePartner} className=\\\"space-y-4\\\">\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div className=\\\"sm:col-span-2\\\">\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    Nome do Parceiro *\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.name}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, name: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: Farm\303\241cia Sa\303\272de+\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">Categoria *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.category}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, category: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: Farm\303\241cias & Parafarm\303\241cia\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    \303\201rea de Atividade *\\n                  </label>\\n                  <select\\n                    value={partnerFormData.area}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, area: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs bg-white\\\"\\n                  >\\n                    <option value=\\\"Sa\303\272de e Bem-estar\\\">Sa\303\272de e Bem-estar</option>\\n                    <option value=\\\"Desporto\\\">Desporto</option>\\n                    <option value=\\\"Lazer e Cultura\\\">Lazer e Cultura</option>\\n                    <option value=\\\"Restaura\303\247\303\243o e Alimenta\303\247\303\243o\\\">Restaura\303\247\303\243o e Alimenta\303\247\303\243o</option>\\n                    <option value=\\\"Forma\303\247\303\243o e Educa\303\247\303\243o\\\">Forma\303\247\303\243o e Educa\303\247\303\243o</option>\\n                    <option value=\\\"Servi\303\247os\\\">Servi\303\247os</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">Distrito *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.district}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, district: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: Lisboa, Porto, Coimbra ou Nacional\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">Localidade *</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.city}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, city: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: Lisboa, Online ou Matosinhos\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    Tipo de Benef\303\255cio *\\n                  </label>\\n                  <select\\n                    value={partnerFormData.benefit_type}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, benefit_type: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs bg-white\\\"\\n                  >\\n                    <option value=\\\"cupao\\\">Cup\303\243o Promocional (valor fixo \342\202\254)</option>\\n                    <option value=\\\"codigo\\\">C\303\263digo de Desconto (% cont\303\255nuo)</option>\\n                    <option value=\\\"voucher\\\">Voucher Nominal (uso \303\272nico)</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    Desconto em Destaque *\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.discount_highlight}\\n                    onChange={(e) =>\\n                      setPartnerFormData({ ...partnerFormData, discount_highlight: e.target.value })\\n                    }\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: 35% em an\303\241lises ou 50\342\202\254 em tratamentos\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    Poupan\303\247a Anual Estimada (\342\202\254) *\\n                  </label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    step=\\\"0.5\\\"\\n                    required\\n                    value={partnerFormData.estimated_annual_savings}\\n                    onChange={(e) =>\\n                      setPartnerFormData({ ...partnerFormData, estimated_annual_savings: e.target.value })\\n                    }\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs font-mono tabular-nums\\\"\\n                    placeholder=\\\"50.0\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    C\303\263digo \303\232nico (Mascarado) *\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={partnerFormData.secret_code}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, secret_code: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs font-mono uppercase\\\"\\n                    placeholder=\\\"Ex: FARMA5\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"sm:col-span-2\\\">\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">Descri\303\247\303\243o</label>\\n                  <textarea\\n                    rows={2}\\n                    value={partnerFormData.description}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, description: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Breve descri\303\247\303\243o dos servi\303\247os e produtos oferecidos.\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"sm:col-span-2\\\">\\n                  <label className=\\\"text-xs font-semibold text-stone-700 block mb-1\\\">\\n                    Condi\303\247\303\265es e Termos\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={partnerFormData.terms}\\n                    onChange={(e) => setPartnerFormData({ ...partnerFormData, terms: e.target.value })}\\n                    className=\\\"w-full p-2.5 rounded-lg border border-stone-300 text-xs\\\"\\n                    placeholder=\\\"Ex: N\303\243o acumul\303\241vel com outras promo\303\247\303\265es.\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex gap-2.5 pt-4 border-t border-stone-200\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setPartnerModalOpen(false)}\\n                  className=\\\"flex-1 py-2.5 rounded-lg border border-stone-300 text-xs font-semibold text-stone-700\\\"\\n                >\\n                  Cancelar\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"flex-1 py-2.5 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white text-xs font-semibold\\\"\\n                >\\n                  Guardar Parceiro\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign AdminPage with clean SaaS dashboard tables, tabular numerals, refined tabs, and fixed client-safe admin email copy\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AdminPage.tsx\", \"toolAction\":\"Redesigning AdminPage component\", \"toolSummary\":\"Redesign AdminPage.tsx\"}"
