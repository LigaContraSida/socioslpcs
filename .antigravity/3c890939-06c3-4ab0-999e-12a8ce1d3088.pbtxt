    tool_calls {
      id: "call_10424770392577795403"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { Partner, User } from \'../types.ts\';\\nimport { CodeModal } from \'../components/CodeModal.tsx\';\\nimport { Search, MapPin, Lock, X, AlertCircle, Layers, ArrowRight } from \'lucide-react\';\\n\\ninterface PartnersPageProps {\\n  user: User | null;\\n  initialQuery?: Record<string, string>;\\n  onNavigate: (path: string) => void;\\n}\\n\\nexport const PartnersPage: React.FC<PartnersPageProps> = ({ user, initialQuery, onNavigate }) => {\\n  const [partners, setPartners] = useState<Partner[]>([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const [selectedArea, setSelectedArea] = useState<string>(initialQuery?.area || \'all\');\\n  const [selectedDistrict, setSelectedDistrict] = useState<string>(\'all\');\\n  const [selectedCity, setSelectedCity] = useState<string>(\'all\');\\n  const [selectedBenefitType, setSelectedBenefitType] = useState<string>(\'all\');\\n  const [search, setSearch] = useState<string>(initialQuery?.search || \'\');\\n\\n  const [filterMeta, setFilterMeta] = useState<{\\n    areaCounts: Record<string, number>;\\n    districts: string[];\\n    citiesByDistrict: Record<string, string[]>;\\n  }>({\\n    areaCounts: {},\\n    districts: [],\\n    citiesByDistrict: {},\\n  });\\n\\n  const [redemptionData, setRedemptionData] = useState<any | null>(null);\\n  const [redeemLoadingId, setRedeemLoadingId] = useState<number | null>(null);\\n  const [actionError, setActionError] = useState<string | null>(null);\\n\\n  const fetchPartners = () => {\\n    setLoading(true);\\n    const params = new URLSearchParams();\\n    if (selectedArea !== \'all\') params.set(\'area\', selectedArea);\\n    if (selectedDistrict !== \'all\') params.set(\'district\', selectedDistrict);\\n    if (selectedCity !== \'all\') params.set(\'city\', selectedCity);\\n    if (selectedBenefitType !== \'all\') params.set(\'benefit_type\', selectedBenefitType);\\n    if (search.trim()) params.set(\'search\', search.trim());\\n\\n    fetch(`/api/partners?${params.toString()}`)\\n      .then((res) => res.json())\\n      .then((data) => {\\n        setPartners(data.partners || []);\\n        if (data.filterMeta) {\\n          setFilterMeta(data.filterMeta);\\n        }\\n        setLoading(false);\\n      })\\n      .catch((err) => {\\n        console.error(\'Failed to load partners:\', err);\\n        setError(\'N\303\243o foi poss\303\255vel carregar os parceiros. Tente recarregar a p\303\241gina.\');\\n        setLoading(false);\\n      });\\n  };\\n\\n  useEffect(() => {\\n    fetchPartners();\\n  }, [selectedArea, selectedDistrict, selectedCity, selectedBenefitType]);\\n\\n  const handleSearchSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    fetchPartners();\\n  };\\n\\n  const handleClearFilters = () => {\\n    setSelectedArea(\'all\');\\n    setSelectedDistrict(\'all\');\\n    setSelectedCity(\'all\');\\n    setSelectedBenefitType(\'all\');\\n    setSearch(\'\');\\n  };\\n\\n  const hasActiveFilters =\\n    selectedArea !== \'all\' ||\\n    selectedDistrict !== \'all\' ||\\n    selectedCity !== \'all\' ||\\n    selectedBenefitType !== \'all\' ||\\n    search.trim() !== \'\';\\n\\n  const handleRedeem = async (partnerId: number) => {\\n    setActionError(null);\\n    if (!user) {\\n      onNavigate(\'/entrar\');\\n      return;\\n    }\\n    if (!user.quota_status.has_active_quota) {\\n      onNavigate(\'/pagamentos\');\\n      return;\\n    }\\n\\n    setRedeemLoadingId(partnerId);\\n\\n    try {\\n      const res = await fetch(\'/api/benefits/redeem\', {\\n        method: \'POST\',\\n        credentials: \'same-origin\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ partner_id: partnerId }),\\n      });\\n      const data = await res.json();\\n\\n      if (!res.ok) {\\n        setActionError(data.error || \'Erro ao gerar c\303\263digo\');\\n        setRedeemLoadingId(null);\\n        return;\\n      }\\n\\n      setRedemptionData(data);\\n      setRedeemLoadingId(null);\\n    } catch (err) {\\n      console.error(\'Error redeeming benefit:\', err);\\n      setActionError(\'Ocorreu uma falha de rede ao gerar o c\303\263digo.\');\\n      setRedeemLoadingId(null);\\n    }\\n  };\\n\\n  const areaList = [\\n    \'Sa\303\272de e Bem-estar\',\\n    \'Desporto\',\\n    \'Lazer e Cultura\',\\n    \'Restaura\303\247\303\243o e Alimenta\303\247\303\243o\',\\n    \'Forma\303\247\303\243o e Educa\303\247\303\243o\',\\n    \'Servi\303\247os\',\\n  ];\\n\\n  const hasQuota = user?.quota_status?.has_active_quota || false;\\n  const totalCount = Object.values(filterMeta.areaCounts).reduce((a, b) => a + b, 0) || 28;\\n\\n  const getBenefitLabel = (type: string) => {\\n    if (type === \'cupao\') return \'Cup\303\243o Promocional\';\\n    if (type === \'voucher\') return \'Voucher Nominal\';\\n    return \'C\303\263digo %\';\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8\\\">\\n      {/* Header */}\\n      <div className=\\\"flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-stone-200 pb-6\\\">\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\\\">\\n            Cat\303\241logo Oficial de Parcerias\\n          </div>\\n          <h1 className=\\\"font-display text-3xl sm:text-4xl font-semibold text-[#141619] tracking-tight\\\">\\n            Parceiros e Descontos Exclusivos\\n          </h1>\\n          <p className=\\\"text-sm text-stone-600 max-w-2xl leading-relaxed\\\">\\n            A lista de parceiros e descontos \303\251 p\303\272blica. Os c\303\263digos rotativos de acesso s\303\243o gerados exclusivamente para associados com a quota regularizada.\\n          </p>\\n        </div>\\n\\n        {!hasQuota && (\\n          <div className=\\\"shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\\n              className=\\\"px-5 py-2.5 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors whitespace-nowrap\\\"\\n            >\\n              {user ? \'Regularizar Quota (35 \342\202\254)\' : \'Fazer-se S\303\263cio \302\267 35 \342\202\254/ano\'}\\n            </button>\\n          </div>\\n        )}\\n      </div>\\n\\n      {error && (\\n        <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-sm text-red-800\\\">\\n          <AlertCircle className=\\\"w-5 h-5 text-[#C81E2B] shrink-0\\\" />\\n          <span>{error}</span>\\n        </div>\\n      )}\\n\\n      {actionError && (\\n        <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-sm text-red-800\\\">\\n          <AlertCircle className=\\\"w-5 h-5 text-[#C81E2B] shrink-0\\\" />\\n          <span>{actionError}</span>\\n        </div>\\n      )}\\n\\n      {/* Filter Controls */}\\n      <div className=\\\"bg-white rounded-xl p-5 sm:p-6 border border-stone-200 space-y-5\\\">\\n        <form onSubmit={handleSearchSubmit} className=\\\"flex flex-col sm:flex-row gap-3\\\">\\n          <div className=\\\"relative flex-1\\\">\\n            <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              placeholder=\\\"Pesquisar por nome de parceiro, servi\303\247o, desconto ou localidade...\\\"\\n              value={search}\\n              onChange={(e) => setSearch(e.target.value)}\\n              className=\\\"w-full pl-10 pr-4 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/60 text-sm text-[#141619] focus:outline-hidden focus:bg-white focus:border-[#C81E2B] focus:ring-1 focus:ring-[#C81E2B]\\\"\\n            />\\n          </div>\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"px-5 py-2.5 rounded-lg bg-[#141619] hover:bg-stone-800 text-white text-sm font-semibold transition-colors whitespace-nowrap\\\"\\n          >\\n            Filtrar\\n          </button>\\n          {hasActiveFilters && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleClearFilters}\\n              className=\\\"px-4 py-2.5 rounded-lg border border-stone-300 text-sm font-medium text-stone-700 hover:bg-stone-50 flex items-center justify-center gap-1.5 whitespace-nowrap\\\"\\n            >\\n              <X className=\\\"w-4 h-4\\\" />\\n              <span>Limpar</span>\\n            </button>\\n          )}\\n        </form>\\n\\n        {/* Segmented Area Filter Buttons */}\\n        <div className=\\\"space-y-2\\\">\\n          <div className=\\\"text-xs font-semibold text-stone-500\\\">\303\201rea de atividade</div>\\n          <div className=\\\"flex flex-wrap gap-1.5\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setSelectedArea(\'all\')}\\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap tabular-nums ${\\n                selectedArea === \'all\'\\n                  ? \'bg-[#141619] text-white\'\\n                  : \'bg-[#FAF8F5] border border-stone-200 text-stone-700 hover:border-stone-400\'\\n              }`}\\n            >\\n              Todas ({totalCount})\\n            </button>\\n            {areaList.map((area) => {\\n              const count = filterMeta.areaCounts[area] || 0;\\n              const active = selectedArea === area;\\n              return (\\n                <button\\n                  type=\\\"button\\\"\\n                  key={area}\\n                  onClick={() => setSelectedArea(active ? \'all\' : area)}\\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap tabular-nums ${\\n                    active\\n                      ? \'bg-[#C81E2B] text-white\'\\n                      : \'bg-[#FAF8F5] border border-stone-200 text-stone-700 hover:border-stone-400\'\\n                  }`}\\n                >\\n                  {area} \302\267 {count}\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Location & Type Dropdowns */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-stone-100\\\">\\n          <div>\\n            <label className=\\\"text-xs font-semibold text-stone-600 block mb-1.5\\\">Distrito</label>\\n            <select\\n              value={selectedDistrict}\\n              onChange={(e) => {\\n                setSelectedDistrict(e.target.value);\\n                setSelectedCity(\'all\');\\n              }}\\n              className=\\\"w-full py-2 px-3 rounded-lg border border-stone-300 bg-white text-sm text-[#141619] focus:outline-hidden focus:border-[#C81E2B]\\\"\\n            >\\n              <option value=\\\"all\\\">Todos os Distritos</option>\\n              {filterMeta.districts.map((d) => (\\n                <option key={d} value={d}>\\n                  {d}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"text-xs font-semibold text-stone-600 block mb-1.5\\\">Localidade</label>\\n            <select\\n              value={selectedCity}\\n              onChange={(e) => setSelectedCity(e.target.value)}\\n              disabled={selectedDistrict === \'all\'}\\n              className=\\\"w-full py-2 px-3 rounded-lg border border-stone-300 bg-white text-sm text-[#141619] disabled:opacity-50 focus:outline-hidden focus:border-[#C81E2B]\\\"\\n            >\\n              <option value=\\\"all\\\">\\n                {selectedDistrict === \'all\' ? \'Escolha primeiro um distrito\' : \'Todas as localidades\'}\\n              </option>\\n              {selectedDistrict !== \'all\' &&\\n                filterMeta.citiesByDistrict[selectedDistrict]?.map((c) => (\\n                  <option key={c} value={c}>\\n                    {c}\\n                  </option>\\n                ))}\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"text-xs font-semibold text-stone-600 block mb-1.5\\\">Tipo de Benef\303\255cio</label>\\n            <select\\n              value={selectedBenefitType}\\n              onChange={(e) => setSelectedBenefitType(e.target.value)}\\n              className=\\\"w-full py-2 px-3 rounded-lg border border-stone-300 bg-white text-sm text-[#141619] focus:outline-hidden focus:border-[#C81E2B]\\\"\\n            >\\n              <option value=\\\"all\\\">Todos os Tipos</option>\\n              <option value=\\\"cupao\\\">Cup\303\243o Promocional (valor fixo \342\202\254)</option>\\n              <option value=\\\"codigo\\\">C\303\263digo de Desconto (% cont\303\255nuo)</option>\\n              <option value=\\\"voucher\\\">Voucher Nominal (uso \303\272nico)</option>\\n            </select>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center justify-between text-xs text-stone-500 pt-1 tabular-nums\\\">\\n          <span>\\n            A apresentar <strong className=\\\"text-[#141619]\\\">{partners.length}</strong> de {totalCount} parceiros\\n          </span>\\n          {hasActiveFilters && <span className=\\\"text-[#C81E2B] font-semibold\\\">Filtros ativos</span>}\\n        </div>\\n      </div>\\n\\n      {/* Partners Grid */}\\n      {loading ? (\\n        <div className=\\\"py-20 text-center text-stone-500 space-y-3\\\">\\n          <div className=\\\"w-8 h-8 border-2 border-[#C81E2B] border-t-transparent rounded-full animate-spin mx-auto\\\" />\\n          <p className=\\\"text-sm\\\">A carregar cat\303\241logo de parceiros...</p>\\n        </div>\\n      ) : partners.length === 0 ? (\\n        <div className=\\\"bg-white rounded-xl p-12 text-center border border-stone-200 space-y-4\\\">\\n          <Layers className=\\\"w-10 h-10 text-stone-400 mx-auto\\\" />\\n          <h3 className=\\\"font-display text-lg font-semibold text-[#141619]\\\">Nenhum parceiro encontrado</h3>\\n          <p className=\\\"text-sm text-stone-500 max-w-sm mx-auto\\\">\\n            N\303\243o existem parceiros com a combina\303\247\303\243o de filtros selecionada.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleClearFilters}\\n            className=\\\"px-4 py-2 rounded-lg border border-stone-300 hover:bg-stone-50 text-xs font-semibold text-[#141619]\\\"\\n          >\\n            Limpar Filtros\\n          </button>\\n        </div>\\n      ) : (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\\\">\\n          {partners.map((partner) => {\\n            const isRedeeming = redeemLoadingId === partner.id;\\n\\n            return (\\n              <div\\n                key={partner.id}\\n                className=\\\"bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors flex flex-col justify-between overflow-hidden\\\"\\n              >\\n                <div>\\n                  <div className=\\\"p-6 space-y-3\\\">\\n                    {/* Unboxed Clean Metadata Header */}\\n                    <div className=\\\"flex items-center justify-between gap-2 text-xs text-stone-500\\\">\\n                      <span className=\\\"truncate\\\">\\n                        {partner.category} \302\267 {getBenefitLabel(partner.benefit_type)}\\n                      </span>\\n                      <span className=\\\"inline-flex items-center gap-1 shrink-0 text-stone-500\\\">\\n                        <MapPin className=\\\"w-3.5 h-3.5 text-stone-400\\\" />\\n                        <span>{partner.city}</span>\\n                      </span>\\n                    </div>\\n\\n                    <h3 className=\\\"font-display text-xl font-semibold text-[#141619] tracking-tight\\\">\\n                      {partner.name}\\n                    </h3>\\n\\n                    <p className=\\\"text-xs sm:text-sm text-stone-600 leading-relaxed line-clamp-3\\\">\\n                      {partner.description}\\n                    </p>\\n                  </div>\\n\\n                  {/* Clean Discount Strip */}\\n                  <div className=\\\"px-6 py-3.5 bg-[#FAF8F5] border-y border-stone-200/80 flex items-center justify-between gap-3\\\">\\n                    <div>\\n                      <span className=\\\"text-xs text-stone-500 block\\\">Vantagem de S\303\263cio</span>\\n                      <span className=\\\"text-base font-bold text-[#C81E2B]\\\">\\n                        {partner.discount_highlight}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"text-right shrink-0\\\">\\n                      <span className=\\\"text-xs text-stone-500 block\\\">Poupan\303\247a est.</span>\\n                      <span className=\\\"text-sm font-mono font-bold text-[#141619] tabular-nums\\\">\\n                        {partner.estimated_annual_savings} \342\202\254/ano\\n                      </span>\\n                    </div>\\n                  </div>\\n\\n                  {/* Conditions & Terms */}\\n                  <div className=\\\"px-6 py-4 space-y-1.5 text-xs text-stone-600\\\">\\n                    <div className=\\\"font-medium text-stone-800\\\">{partner.usage_limit}</div>\\n                    <div className=\\\"text-stone-500 leading-snug\\\">\\n                      Termos: {partner.terms} \302\267 V\303\241lido at\303\251{\' \'}\\n                      <span className=\\\"font-mono tabular-nums\\\">{partner.valid_until}</span>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                {/* Action Footer */}\\n                <div className=\\\"px-6 py-4 bg-[#FAF8F5]/60 border-t border-stone-200/80\\\">\\n                  {hasQuota ? (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => handleRedeem(partner.id)}\\n                      disabled={isRedeeming}\\n                      className=\\\"w-full py-2.5 px-4 rounded-lg bg-[#141619] hover:bg-stone-800 text-white text-xs font-semibold transition-colors flex items-center justify-center gap-2\\\"\\n                    >\\n                      {isRedeeming ? (\\n                        <>\\n                          <div className=\\\"w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin\\\" />\\n                          <span>A gerar c\303\263digo seguro...</span>\\n                        </>\\n                      ) : (\\n                        <>\\n                          <span>Obter C\303\263digo Seguro</span>\\n                          <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                        </>\\n                      )}\\n                    </button>\\n                  ) : (\\n                    <div className=\\\"flex items-center justify-between gap-3\\\">\\n                      <div className=\\\"flex items-center gap-2 text-xs text-stone-600\\\">\\n                        <Lock className=\\\"w-3.5 h-3.5 text-stone-400 shrink-0\\\" />\\n                        <span>C\303\263digo reservado a s\303\263cios</span>\\n                      </div>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\\n                        className=\\\"text-xs font-semibold text-[#C81E2B] hover:text-[#A11622] whitespace-nowrap shrink-0\\\"\\n                      >\\n                        {user ? \'Ativar quota \342\206\222\' : \'Fazer-se s\303\263cio \342\206\222\'}\\n                      </button>\\n                    </div>\\n                  )}\\n                </div>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      )}\\n\\n      {redemptionData && (\\n        <CodeModal redemptionData={redemptionData} onClose={() => setRedemptionData(null)} />\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign PartnersPage with clean typographic catalog cards, zero-pill metadata, segmented area filters, and tabular alignment\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/PartnersPage.tsx\", \"toolAction\":\"Redesigning PartnersPage component\", \"toolSummary\":\"Redesign PartnersPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10424770392577797544"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  HeartHandshake,\\n  ShieldCheck,\\n  BadgePercent,\\n  Users,\\n  CheckCircle2,\\n  AlertCircle,\\n  Send,\\n  QrCode,\\n  FileCheck,\\n  Megaphone,\\n  ArrowLeft,\\n} from \'lucide-react\';\\nimport confetti from \'canvas-confetti\';\\nimport partnershipStreetImg from \'../assets/images/partnership_corporate_alliance_1794510456114.jpg\';\\n\\ninterface PartnershipPageProps {\\n  onNavigate: (path: string) => void;\\n}\\n\\nexport const PartnershipPage: React.FC<PartnershipPageProps> = ({ onNavigate }) => {\\n  const [heroImgFailed, setHeroImgFailed] = useState(false);\\n  const [formData, setFormData] = useState({\\n    company_name: \'\',\\n    nif: \'\',\\n    contact_name: \'\',\\n    email: \'\',\\n    phone: \'\',\\n    area: \'Sa\303\272de e Bem-estar\',\\n    district: \'Lisboa\',\\n    city: \'\',\\n    benefit_type: \'codigo\',\\n    proposed_benefit: \'\',\\n    website: \'\',\\n    notes: \'\',\\n  });\\n\\n  const [submitting, setSubmitting] = useState(false);\\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\\n\\n  const companyAdvantages = [\\n    {\\n      num: \'01\',\\n      icon: HeartHandshake,\\n      title: \'Responsabilidade Social e Selo LPCS\',\\n      subtitle: \'Selo Oficial LPCS\',\\n      desc: \'Associe a sua marca a uma Institui\303\247\303\243o Particular de Solidariedade Social (IPSS) e Pessoa Coletiva de Utilidade P\303\272blica com mais de 35 anos de trabalho na preven\303\247\303\243o do VIH/SIDA e defesa dos direitos humanos.\',\\n      highlights: [\\n        \'Selo digital e f\303\255sico \\\"Empresa Parceira Solid\303\241ria LPCS\\\"\',\\n        \'Refor\303\247o comprovado nos relat\303\263rios de sustentabilidade e ESG\',\\n      ],\\n    },\\n    {\\n      num: \'02\',\\n      icon: Megaphone,\\n      title: \'Visibilidade Direta e Novos Clientes\',\\n      subtitle: \'Alcance Nacional\',\\n      desc: \'A sua empresa entra imediatamente no cat\303\241logo p\303\272blico e pesquis\303\241vel da LPCS, com filtros por distrito, localidade e \303\241rea de atividade.\',\\n      highlights: [\\n        \'Destaque em campanhas sazonais e newsletters para s\303\263cios\',\\n        \'Fluxo recorrente de clientes fidelizados pela causa\',\\n      ],\\n    },\\n    {\\n      num: \'03\',\\n      icon: FileCheck,\\n      title: \'Enquadramento Fiscal e Mecenato\',\\n      subtitle: \'Estatuto EBF\',\\n      desc: \'As empresas que complementem a parceria com donativos ou patroc\303\255nios a projetos comunit\303\241rios beneficiam do enquadramento previsto no Estatuto dos Benef\303\255cios Fiscais.\',\\n      highlights: [\\n        \'Declara\303\247\303\265es oficiais para efeitos de dedu\303\247\303\243o em IRC\',\\n        \'Apoio direto a rastreios gratuitos e linhas de apoio social\',\\n      ],\\n    },\\n    {\\n      num: \'04\',\\n      icon: ShieldCheck,\\n      title: \'Zero Custos de Ades\303\243o e Anti-Abuso\',\\n      subtitle: \'Seguran\303\247a HMAC-SHA256\',\\n      desc: \'A ades\303\243o ao cat\303\241logo de benef\303\255cios da LPCS n\303\243o tem qualquer taxa ou comiss\303\243o. O sistema garante que apenas s\303\263cios com quota em dia acedem ao desconto.\',\\n      highlights: [\\n        \'C\303\263digos rotativos de 6 d\303\255gitos que mudam a cada 30 segundos\',\\n        \'Validador comercial simples (/validar) contra capturas de ecr\303\243\',\\n      ],\\n    },\\n    {\\n      num: \'05\',\\n      icon: BadgePercent,\\n      title: \'Flexibilidade Total no Desconto\',\\n      subtitle: \'\303\200 Sua Medida\',\\n      desc: \'A empresa define livremente o benef\303\255cio que melhor protege a sua margem comercial, o limite de utiliza\303\247\303\265es e os termos aplic\303\241veis.\',\\n      highlights: [\\n        \'Cup\303\243o promocional (valor fixo em \342\202\254 com n\302\272 m\303\241ximo de usos)\',\\n        \'C\303\263digo de desconto (% cont\303\255nua) ou Voucher nominal (uso \303\272nico)\',\\n      ],\\n    },\\n    {\\n      num: \'06\',\\n      icon: Users,\\n      title: \'A\303\247\303\265es de Sa\303\272de e Bem-Estar na Empresa\',\\n      subtitle: \'Equipas Saud\303\241veis\',\\n      desc: \'Os parceiros podem solicitar a\303\247\303\265es de sensibiliza\303\247\303\243o, literacia em sa\303\272de, preven\303\247\303\243o e testes r\303\241pidos confidenciais promovidos pelas equipas t\303\251cnicas da LPCS.\',\\n      highlights: [\\n        \'Workshops de bem-estar e preven\303\247\303\243o para colaboradores\',\\n        \'Cultura organizacional inclusiva e informada\',\\n      ],\\n    },\\n  ];\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSubmitting(true);\\n    setErrorMsg(null);\\n    setSuccessMsg(null);\\n\\n    try {\\n      const res = await fetch(\'/api/partners/inquiry\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify(formData),\\n      });\\n      const data = await res.json();\\n\\n      if (!res.ok) {\\n        setErrorMsg(data.error || \'Erro ao enviar proposta.\');\\n        setSubmitting(false);\\n        return;\\n      }\\n\\n      setSuccessMsg(data.message);\\n      setSubmitting(false);\\n      setFormData({\\n        company_name: \'\',\\n        nif: \'\',\\n        contact_name: \'\',\\n        email: \'\',\\n        phone: \'\',\\n        area: \'Sa\303\272de e Bem-estar\',\\n        district: \'Lisboa\',\\n        city: \'\',\\n        benefit_type: \'codigo\',\\n        proposed_benefit: \'\',\\n        website: \'\',\\n        notes: \'\',\\n      });\\n      confetti({\\n        particleCount: 90,\\n        spread: 65,\\n        origin: { y: 0.6 },\\n      });\\n    } catch (err) {\\n      console.error(\'Inquiry submit error:\', err);\\n      setErrorMsg(\'Falha de liga\303\247\303\243o ao servidor. Tente novamente.\');\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16\\\">\\n      <div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/\')}\\n          className=\\\"inline-flex items-center gap-1.5 text-xs font-semibold text-stone-500 hover:text-[#141619] transition-colors\\\"\\n        >\\n          <ArrowLeft className=\\\"w-4 h-4\\\" />\\n          <span>Voltar \303\240 P\303\241gina Inicial</span>\\n        </button>\\n      </div>\\n\\n      {/* Marquee Hero */}\\n      <section className=\\\"relative rounded-2xl overflow-hidden bg-[#141619] border border-stone-800\\\">\\n        {!heroImgFailed && (\\n          <img\\n            src={partnershipStreetImg}\\n            alt=\\\"Empresas e estabelecimentos parceiros da Liga Portuguesa Contra a SIDA\\\"\\n            referrerPolicy=\\\"no-referrer\\\"\\n            onError={() => setHeroImgFailed(true)}\\n            className=\\\"w-full h-[360px] sm:h-[420px] object-cover opacity-55\\\"\\n          />\\n        )}\\n        <div className=\\\"absolute inset-0 bg-gradient-to-t from-[#141619] via-[#141619]/75 to-[#141619]/35\\\" />\\n        <div className=\\\"absolute inset-0 p-6 sm:p-12 flex flex-col justify-end\\\">\\n          <div className=\\\"max-w-3xl space-y-4\\\">\\n            <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-rose-300\\\">\\n              Rede de Empresas Parceiras LPCS \302\267 Ades\303\243o Gratuita\\n            </div>\\n            <h1 className=\\\"font-display text-3xl sm:text-5xl font-semibold text-white tracking-tight leading-tight text-balance\\\">\\n              Quero fazer parceria com a Liga Portuguesa Contra a SIDA\\n            </h1>\\n            <p className=\\\"text-sm sm:text-base text-stone-200 leading-relaxed max-w-2xl\\\">\\n              Junte a sua empresa \303\240s organiza\303\247\303\265es portuguesas que promovem vantagens reais para os associados, ganham visibilidade junto de um p\303\272blico fidelizado e refor\303\247am o seu compromisso social e ESG.\\n            </p>\\n            <div className=\\\"pt-2 flex flex-wrap gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  document.getElementById(\'partner-form\')?.scrollIntoView({ behavior: \'smooth\' });\\n                }}\\n                className=\\\"px-6 py-3 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors\\\"\\n              >\\n                Submeter Proposta de Parceria\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'/parceiros\')}\\n                className=\\\"px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-colors\\\"\\n              >\\n                Ver Parceiros Atuais (28)\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 6 Core Advantages */}\\n      <section className=\\\"space-y-8\\\">\\n        <div className=\\\"max-w-2xl space-y-2\\\">\\n          <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\\\">\\n            Benef\303\255cios para Empresas Colaboradoras\\n          </div>\\n          <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight\\\">\\n            Todas as vantagens de ser Empresa Parceira LPCS\\n          </h2>\\n          <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">\\n            Uma colabora\303\247\303\243o estruturada para gerar retorno comercial, reputa\303\247\303\243o social e seguran\303\247a tecnol\303\263gica total na valida\303\247\303\243o dos descontos.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\\\">\\n          {companyAdvantages.map((adv) => {\\n            const Icon = adv.icon;\\n            return (\\n              <div\\n                key={adv.title}\\n                className=\\\"bg-white rounded-xl p-6 sm:p-7 border border-stone-200 flex flex-col justify-between space-y-6\\\"\\n              >\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs text-stone-500\\\">\\n                    <span className=\\\"font-medium\\\">{adv.num} \302\267 {adv.subtitle}</span>\\n                    <Icon className=\\\"w-5 h-5 text-[#C81E2B]\\\" />\\n                  </div>\\n                  <h3 className=\\\"font-display text-xl font-semibold text-[#141619]\\\">{adv.title}</h3>\\n                  <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">{adv.desc}</p>\\n                </div>\\n\\n                <ul className=\\\"pt-4 border-t border-stone-100 space-y-2\\\">\\n                  {adv.highlights.map((item) => (\\n                    <li key={item} className=\\\"flex items-start gap-2 text-xs text-stone-700 font-medium\\\">\\n                      <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\\\" />\\n                      <span>{item}</span>\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </section>\\n\\n      {/* 3-Step Merchant Workflow */}\\n      <section className=\\\"bg-white rounded-2xl p-8 sm:p-10 border border-stone-200\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\\\">\\n          <div className=\\\"lg:col-span-4 space-y-3\\\">\\n            <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\\\">\\n              Opera\303\247\303\243o ao Balc\303\243o\\n            </div>\\n            <h3 className=\\\"font-display text-2xl font-semibold text-[#141619]\\\">\\n              Como funciona na sua loja f\303\255sica ou online?\\n            </h3>\\n            <p className=\\\"text-sm text-stone-600 leading-relaxed\\\">\\n              Sem terminais dedicados nem integra\303\247\303\265es complexas. Todo o processo demora menos de 10 segundos no nosso validador web.\\n            </p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'/validar\')}\\n              className=\\\"inline-flex items-center gap-2 text-xs font-semibold text-[#C81E2B] hover:text-[#A11622] pt-1\\\"\\n            >\\n              <QrCode className=\\\"w-4 h-4\\\" />\\n              <span>Abrir Validador de Comerciantes \342\206\222</span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-5 border-t lg:border-t-0 lg:border-l border-stone-200 pt-6 lg:pt-0 lg:pl-8\\\">\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"font-mono text-xs font-bold text-[#C81E2B]\\\">01</div>\\n              <h4 className=\\\"font-semibold text-sm text-[#141619]\\\">S\303\263cio apresenta o c\303\263digo</h4>\\n              <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                O associado com quota ativa gera no telem\303\263vel uma refer\303\252ncia e um c\303\263digo de 6 d\303\255gitos que roda a cada 30 segundos.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"font-mono text-xs font-bold text-[#C81E2B]\\\">02</div>\\n              <h4 className=\\\"font-semibold text-sm text-[#141619]\\\">Equipa valida em /validar</h4>\\n              <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                O colaborador confirma a autenticidade e a titularidade em segundos, impedindo reutiliza\303\247\303\243o de capturas de ecr\303\243.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"font-mono text-xs font-bold text-emerald-700\\\">03</div>\\n              <h4 className=\\\"font-semibold text-sm text-[#141619]\\\">Desconto aplicado</h4>\\n              <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                O c\303\263digo fica marcado como consumido na hora e a sua empresa fideliza um novo cliente solid\303\241rio.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Proposal Form */}\\n      <section id=\\\"partner-form\\\" className=\\\"bg-white rounded-2xl p-6 sm:p-10 border border-stone-200 max-w-4xl mx-auto\\\">\\n        <div className=\\\"space-y-2 mb-8 border-b border-stone-100 pb-6\\\">\\n          <div className=\\\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\\\">\\n            Ades\303\243o Gratuita ao Programa\\n          </div>\\n          <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight\\\">\\n            Proposta de Parceria Empresarial\\n          </h2>\\n          <p className=\\\"text-sm text-stone-600\\\">\\n            Preencha os dados da empresa e o benef\303\255cio proposto. A equipa da LPCS responder\303\241 em at\303\251 48 horas \303\272teis.\\n          </p>\\n        </div>\\n\\n        {successMsg && (\\n          <div className=\\\"mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-start gap-3 text-sm text-emerald-900\\\">\\n            <CheckCircle2 className=\\\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\\\" />\\n            <div>\\n              <strong className=\\\"block font-semibold\\\">Proposta Enviada</strong>\\n              <span>{successMsg}</span>\\n            </div>\\n          </div>\\n        )}\\n\\n        {errorMsg && (\\n          <div className=\\\"mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-start gap-3 text-sm text-red-800\\\">\\n            <AlertCircle className=\\\"w-5 h-5 text-[#C81E2B] shrink-0 mt-0.5\\\" />\\n            <span>{errorMsg}</span>\\n          </div>\\n        )}\\n\\n        <form onSubmit={handleSubmit} className=\\\"space-y-5\\\">\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Nome da Empresa / Marca *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.company_name}\\n                onChange={(e) => setFormData({ ...formData, company_name: e.target.value })}\\n                placeholder=\\\"Ex: Cl\303\255nica Sa\303\272de Atl\303\242ntico, Lda.\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B] focus:ring-1 focus:ring-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                NIPC / NIF da Empresa (Opcional)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                maxLength={9}\\n                value={formData.nif}\\n                onChange={(e) => setFormData({ ...formData, nif: e.target.value.replace(/\\\\D/g, \'\') })}\\n                placeholder=\\\"500123456\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 font-mono text-sm tabular-nums focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Pessoa de Contacto *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.contact_name}\\n                onChange={(e) => setFormData({ ...formData, contact_name: e.target.value })}\\n                placeholder=\\\"Nome completo do respons\303\241vel\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                E-mail Corporativo *\\n              </label>\\n              <input\\n                type=\\\"email\\\"\\n                required\\n                value={formData.email}\\n                onChange={(e) => setFormData({ ...formData, email: e.target.value })}\\n                placeholder=\\\"parcerias@empresa.pt\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Telefone / Telem\303\263vel *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.phone}\\n                onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\\n                placeholder=\\\"912345678 ou 210000000\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 font-mono text-sm tabular-nums focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                \303\201rea de Atividade *\\n              </label>\\n              <select\\n                value={formData.area}\\n                onChange={(e) => setFormData({ ...formData, area: e.target.value })}\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-white text-sm focus:outline-hidden focus:border-[#C81E2B]\\\"\\n              >\\n                <option value=\\\"Sa\303\272de e Bem-estar\\\">Sa\303\272de e Bem-estar</option>\\n                <option value=\\\"Desporto\\\">Desporto</option>\\n                <option value=\\\"Lazer e Cultura\\\">Lazer e Cultura</option>\\n                <option value=\\\"Restaura\303\247\303\243o e Alimenta\303\247\303\243o\\\">Restaura\303\247\303\243o e Alimenta\303\247\303\243o</option>\\n                <option value=\\\"Forma\303\247\303\243o e Educa\303\247\303\243o\\\">Forma\303\247\303\243o e Educa\303\247\303\243o</option>\\n                <option value=\\\"Servi\303\247os\\\">Servi\303\247os</option>\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Distrito / Abrang\303\252ncia *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.district}\\n                onChange={(e) => setFormData({ ...formData, district: e.target.value })}\\n                placeholder=\\\"Lisboa, Porto, Coimbra, Nacional...\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Localidade / Online *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.city}\\n                onChange={(e) => setFormData({ ...formData, city: e.target.value })}\\n                placeholder=\\\"Ex: Lisboa ou Online\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Formato de Benef\303\255cio *\\n              </label>\\n              <select\\n                value={formData.benefit_type}\\n                onChange={(e) => setFormData({ ...formData, benefit_type: e.target.value })}\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-white text-sm focus:outline-hidden focus:border-[#C81E2B]\\\"\\n              >\\n                <option value=\\\"codigo\\\">C\303\263digo de Desconto (% cont\303\255nua)</option>\\n                <option value=\\\"cupao\\\">Cup\303\243o Promocional (valor fixo \342\202\254 com limite)</option>\\n                <option value=\\\"voucher\\\">Voucher Nominal (oferta / uso \303\272nico)</option>\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Website da Empresa (Opcional)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={formData.website}\\n                onChange={(e) => setFormData({ ...formData, website: e.target.value })}\\n                placeholder=\\\"https://www.empresa.pt\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"sm:col-span-2\\\">\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Desconto ou Condi\303\247\303\243o Proposta *\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={formData.proposed_benefit}\\n                onChange={(e) => setFormData({ ...formData, proposed_benefit: e.target.value })}\\n                placeholder=\\\"Ex: 20% de desconto em todos os servi\303\247os ou 1\302\252 consulta gratuita\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"sm:col-span-2\\\">\\n              <label className=\\\"block text-xs font-semibold text-stone-700 mb-1.5\\\">\\n                Observa\303\247\303\265es / Interesse em A\303\247\303\265es de Sensibiliza\303\247\303\243o ou Mecenato\\n              </label>\\n              <textarea\\n                rows={3}\\n                value={formData.notes}\\n                onChange={(e) => setFormData({ ...formData, notes: e.target.value })}\\n                placeholder=\\\"Indique se pretende tamb\303\251m organizar a\303\247\303\265es de preven\303\247\303\243o na empresa, receber o selo de Empresa Solid\303\241ria ou obter informa\303\247\303\265es sobre mecenato fiscal.\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/50 text-sm focus:outline-hidden focus:bg-white focus:border-[#C81E2B]\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-2\\\">\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={submitting}\\n              className=\\\"px-7 py-3 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors flex items-center justify-center gap-2\\\"\\n            >\\n              {submitting ? (\\n                <>\\n                  <div className=\\\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\\\" />\\n                  <span>A enviar proposta...</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Send className=\\\"w-4 h-4\\\" />\\n                  <span>Enviar Proposta de Parceria</span>\\n                </>\\n              )}\\n            </button>\\n          </div>\\n        </form>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign PartnershipPage with editorial marquee hero, numbered corporate advantages, and clean proposal form\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/PartnershipPage.tsx\", \"toolAction\":\"Redesigning PartnershipPage component\", \"toolSummary\":\"Redesign PartnershipPage.tsx\"}"
