      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Phone, Mail, MapPin, ShieldCheck, Globe, Building2 } from \'lucide-react\';\\n\\nexport const Footer: React.FC<{ onNavigate: (path: string) => void }> = ({ onNavigate }) => {\\n  return (\\n    <footer className=\\\"bg-[#141619] text-stone-300 border-t border-stone-800 mt-24\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\\\">\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12\\\">\\n          {/* Column 1: Official LPCS Identification & Logo */}\\n          <div className=\\\"md:col-span-4 space-y-4\\\">\\n            <div className=\\\"inline-block bg-white rounded-xl px-3.5 py-2\\\">\\n              <img\\n                src=\\\"/assets/aistudio/logo_LPCS_f0a028f9.jpg\\\"\\n                alt=\\\"Liga Portuguesa Contra a SIDA\\\"\\n                className=\\\"h-12 w-auto object-contain\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"space-y-1.5\\\">\\n              <div className=\\\"text-sm font-bold text-white tracking-tight\\\">\\n                Liga Portuguesa Contra a SIDA (LPCS)\\n              </div>\\n              <p className=\\\"text-xs text-stone-400 leading-relaxed\\\">\\n                Institui\303\247\303\243o Particular de Solidariedade Social (IPSS) e Pessoa Coletiva de Utilidade P\303\272blica, fundada em 1990, dedicada \303\240 preven\303\247\303\243o do VIH/SIDA, apoio \303\240s pessoas que vivem com a infe\303\247\303\243o e defesa dos direitos humanos.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"pt-2 border-t border-stone-800 space-y-1 text-xs text-stone-400 tabular-nums\\\">\\n              <div>\\n                <span className=\\\"text-stone-500\\\">NIPC / NIF:</span>{\' \'}\\n                <strong className=\\\"text-white font-semibold\\\">502 665 548</strong>\\n              </div>\\n              <div>\\n                <span className=\\\"text-stone-500\\\">Estatuto:</span>{\' \'}\\n                <span className=\\\"text-stone-300\\\">IPSS \302\267 Utilidade P\303\272blica</span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Column 2: Portal Links */}\\n          <div className=\\\"md:col-span-3\\\">\\n            <h4 className=\\\"text-xs font-bold text-stone-400 uppercase tracking-wider mb-4\\\">\\n              Portal do Associado\\n            </h4>\\n            <ul className=\\\"space-y-2.5 text-sm text-stone-300\\\">\\n              <li>\\n                <button onClick={() => onNavigate(\'/\')} className=\\\"hover:text-white transition-colors\\\">\\n                  In\303\255cio e Benef\303\255cios\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => onNavigate(\'/parceiros\')} className=\\\"hover:text-white transition-colors\\\">\\n                  Cat\303\241logo de Parceiros\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => onNavigate(\'/dashboard\')} className=\\\"hover:text-white transition-colors\\\">\\n                  \303\201rea Pessoal do S\303\263cio\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => onNavigate(\'/pagamentos\')} className=\\\"hover:text-white transition-colors\\\">\\n                  Quotas e Recibos\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => onNavigate(\'/validar\')} className=\\\"hover:text-white transition-colors\\\">\\n                  Validador de Comerciantes\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  onClick={() => onNavigate(\'/parceria\')}\\n                  className=\\\"hover:text-white text-rose-400 font-semibold transition-colors\\\"\\n                >\\n                  Quero Fazer Parceria\\n                </button>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          {/* Column 3: Official Contacts & Sede */}\\n          <div className=\\\"md:col-span-3\\\">\\n            <h4 className=\\\"text-xs font-bold text-stone-400 uppercase tracking-wider mb-4\\\">\\n              Identifica\303\247\303\243o e Contactos\\n            </h4>\\n            <ul className=\\\"space-y-3 text-sm text-stone-300\\\">\\n              <li className=\\\"flex items-start gap-2.5\\\">\\n                <MapPin className=\\\"w-4 h-4 text-[#E31E24] shrink-0 mt-0.5\\\" />\\n                <span>Pra\303\247a Carlos Fabi\303\243o, n.\302\272 3, A/B, 1600-316 Lisboa</span>\\n              </li>\\n              <li className=\\\"flex items-center gap-2.5\\\">\\n                <Phone className=\\\"w-4 h-4 text-[#E31E24] shrink-0\\\" />\\n                <span className=\\\"tabular-nums\\\">Tel.: 213 479 376</span>\\n              </li>\\n              <li className=\\\"flex items-center gap-2.5\\\">\\n                <Mail className=\\\"w-4 h-4 text-[#E31E24] shrink-0\\\" />\\n                <span>info@ligacontrasida.org</span>\\n              </li>\\n              <li className=\\\"flex items-center gap-2.5\\\">\\n                <Globe className=\\\"w-4 h-4 text-[#E31E24] shrink-0\\\" />\\n                <a\\n                  href=\\\"https://www.ligacontrasida.org\\\"\\n                  target=\\\"_blank\\\"\\n                  rel=\\\"noopener noreferrer\\\"\\n                  className=\\\"hover:text-white underline decoration-stone-600 underline-offset-4\\\"\\n                >\\n                  www.ligacontrasida.org\\n                </a>\\n              </li>\\n              <li className=\\\"flex items-center gap-2.5\\\">\\n                <Building2 className=\\\"w-4 h-4 text-stone-400 shrink-0\\\" />\\n                <span className=\\\"tabular-nums text-xs text-stone-400\\\">NIPC 502 665 548</span>\\n              </li>\\n              <li className=\\\"flex items-center gap-2.5\\\">\\n                <ShieldCheck className=\\\"w-4 h-4 text-emerald-400 shrink-0\\\" />\\n                <span className=\\\"text-xs text-stone-400\\\">Tratamento de dados em conformidade RGPD</span>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          {/* Column 4: Solidarity Commitment */}\\n          <div className=\\\"md:col-span-2 flex flex-col justify-between border-t md:border-t-0 md:border-l border-stone-800 pt-6 md:pt-0 md:pl-8\\\">\\n            <div className=\\\"space-y-3\\\">\\n              <h4 className=\\\"text-xs font-bold text-stone-400 uppercase tracking-wider\\\">\\n                Impacto da Quota\\n              </h4>\\n              <p className=\\\"text-xs text-stone-400 leading-relaxed font-helvetica-light\\\">\\n                Cada quota anual de 35,00 \342\202\254 financia rastreios an\303\263nimos, acompanhamento social e a\303\247\303\265es educativas em todo o pa\303\255s.\\n              </p>\\n            </div>\\n            <div className=\\\"mt-6 pt-4 border-t border-stone-800 text-xs text-stone-400 tabular-nums\\\">\\n              <span className=\\\"text-white font-bold block\\\">2,92 \342\202\254 / m\303\252s</span>\\n              <span>Apoio cont\303\255nuo LPCS</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"mt-12 pt-6 border-t border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500\\\">\\n          <p>\\n            \302\251 {new Date().getFullYear()} Liga Portuguesa Contra a SIDA \302\267 NIPC 502 665 548 \302\267 Todos os direitos reservados.\\n          </p>\\n          <div className=\\\"flex items-center gap-3 text-stone-400\\\">\\n            <span>Lisboa, Portugal</span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>IPSS de Utilidade P\303\272blica</span>\\n          </div>\\n        </div>\\n      </div>\\n    </footer>\\n  );\\n};\\n\", \"Description\":\"Update Footer with official LPCS logo and verified institutional identification details (NIPC 502 665 548, Pra\303\247a Carlos Fabi\303\243o, Tel 213 479 376, info@ligacontrasida.org, www.ligacontrasida.org)\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Footer.tsx\", \"toolAction\":\"Updating Footer with official LPCS details\", \"toolSummary\":\"Update Footer.tsx with LPCS identification\"}"
      original_name: "write_to_file"
    }
