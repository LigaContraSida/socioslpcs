      original_chunk {
        target_content: "  const fetchCurrentUser = async () => {\n    try {\n      const res = await fetch(\'/api/auth/me\');\n      const data = await res.json();\n      if (data.user) {\n        setUser(data.user);\n        setIsAdmin(!!data.isAdmin);\n      } else {\n        setUser(null);\n        setIsAdmin(false);\n      }\n    } catch (err) {\n      console.error(\'Failed to fetch user:\', err);\n      setUser(null);\n      setIsAdmin(false);\n    } finally {\n      setLoadingUser(false);\n    }\n  };"
        replacement_content: "  const fetchCurrentUser = async (): Promise<User | null> => {\n    try {\n      const res = await fetch(\'/api/auth/me\', { credentials: \'same-origin\' });\n      const data = await res.json();\n      if (data.user) {\n        setUser(data.user);\n        setIsAdmin(!!data.isAdmin);\n        return data.user;\n      } else {\n        setUser(null);\n        setIsAdmin(false);\n        return null;\n      }\n    } catch (err) {\n      console.error(\'Failed to fetch user:\', err);\n      setUser(null);\n      setIsAdmin(false);\n      return null;\n    } finally {\n      setLoadingUser(false);\n    }\n  };"
        start_line: 22
        end_line: 42
      }
      num_matches: 1
    }
    description: "Return Promise<User | null> from fetchCurrentUser in App.tsx so login/register flows can await state sync before navigating"
