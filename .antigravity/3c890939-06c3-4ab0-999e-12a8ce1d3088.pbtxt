  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { HeroStats, User } from \'../types.ts\';\nimport {\n  Check,\n  ArrowRight,\n  TrendingUp,\n  ShieldCheck,\n  Heart,\n  Percent,\n  Ticket,\n  Tag,\n  Award,\n  ChevronRight,\n  LogIn,\n  Mail,\n  Lock,\n  AlertCircle,\n  Building2,\n  HeartHandshake,\n  Megaphone,\n  FileCheck,\n  BadgePercent,\n  Users,\n} from \'lucide-react\';\nimport heroCommunityImg from \'../assets/images/hero_lpcs_community_1794510456196.jpg\';\nimport partnershipStreetImg from \'../assets/images/partnership_corporate_alliance_1794510456114.jpg\';\nimport wellnessBenefitImg from \'../assets/images/member_wellness_benefit_1794510457676.jpg\';\n\ninterface HomePageProps {\n  user: User | null;\n  onNavigate: (path: string, query?: Record<string, string>) => void;\n  onRefreshUser: () => Promise<User | null> | void;\n}\n\nexport const HomePage: React.FC<HomePageProps> = ({ user, onNavigate, onRefreshUser }) => {\n  const [stats, setStats] = useState<HeroStats | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  const [heroImgFailed, setHeroImgFailed] = useState(false);\n  const [wellnessImgFailed, setWellnessImgFailed] = useState(false);\n  const [partnerImgFailed, setPartnerImgFailed] = useState(false);\n\n  // Inline Member Login state\n  const [loginEmail, setLoginEmail] = useState(\'\');\n  const [loginPassword, setLoginPassword] = useState(\'\');\n  const [loginError, setLoginError] = useState<string | null>(null);\n  const [cookieBlocked, setCookieBlocked] = useState(false);\n  const [loginSubmitting, setLoginSubmitting] = useState(false);\n\n  useEffect(() => {\n    fetch(\'/api/partners/hero-stats\')\n      .then((res) => res.json())\n      .then((data: HeroStats) => {\n        setStats(data);\n        setLoading(false);\n      })\n      .catch((err) => {\n        console.error(\'Failed to load hero stats:\', err);\n        setLoading(false);\n      });\n  }, []);\n\n  const handleInlineLogin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginSubmitting(true);\n    setLoginError(null);\n    setCookieBlocked(false);\n\n    try {\n      const res = await fetch(\'/api/auth/login\', {\n        method: \'POST\',\n        credentials: \'same-origin\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ email: loginEmail, password: loginPassword }),\n      });\n\n      const data = await res.json();\n\n      if (!res.ok) {\n        setLoginError(data.error || \'E-mail ou palavra-passe incorretos.\');\n        setLoginSubmitting(false);\n        return;\n      }\n\n      const loggedUser = await onRefreshUser();\n      if (!loggedUser) {\n        setCookieBlocked(true);\n        setLoginError(\n          \'O seu browser bloqueou os cookies de sess\303\243o dentro da pr\303\251-visualiza\303\247\303\243o. Abra o portal num novo separador para entrar.\'\n        );\n        setLoginSubmitting(false);\n        return;\n      }\n\n      setLoginSubmitting(false);\n      onNavigate(data.redirect || \'/dashboard\');\n    } catch (err) {\n      console.error(\'Home login error:\', err);\n      const form = document.getElementById(\'home-native-login-form\') as HTMLFormElement;\n      form?.submit();\n    }\n  };\n\n  const totalSavings = stats ? Math.floor(stats.totalSavings) : 1580;\n  const multiplier = stats ? stats.savingsMultiplier : 45.1;\n  const partnersCount = stats ? stats.partnersCount : 28;\n\n  const categories = [\n    {\n      num: \'01\',\n      name: \'Sa\303\272de e Bem-estar\',\n      count: 12,\n      desc: \'Farm\303\241cias, an\303\241lises cl\303\255nicas, medicina dent\303\241ria, psicologia e fisioterapia com condi\303\247\303\265es preferenciais.\',\n    },\n    {\n      num: \'02\',\n      name: \'Desporto\',\n      count: 3,\n      desc: \'Gin\303\241sios, campos de padel e centros aqu\303\241ticos com redu\303\247\303\243o direta na mensalidade e inscri\303\247\303\243o.\',\n    },\n    {\n      num: \'03\',\n      name: \'Lazer e Cultura\',\n      count: 5,\n      desc: \'Livrarias independentes, salas de teatro, estadias nacionais e turismo sustent\303\241vel.\',\n    },\n    {\n      num: \'04\',\n      name: \'Restaura\303\247\303\243o e Alimenta\303\247\303\243o\',\n      count: 3,\n      desc: \'Restaurantes de cozinha saud\303\241vel, cafetarias e cabazes biol\303\263gicos de produtores locais.\',\n    },\n    {\n      num: \'05\',\n      name: \'Forma\303\247\303\243o e Educa\303\247\303\243o\',\n      count: 1,\n      desc: \'Cursos certificados, idiomas e academias tecnol\303\263gicas em formato presencial e online.\',\n    },\n    {\n      num: \'06\',\n      name: \'Servi\303\247os\',\n      count: 4,\n      desc: \'Media\303\247\303\243o de seguros, mobilidade e consultoria jur\303\255dica especializada para associados.\',\n    },\n  ];\n\n  const companyBenefits = [\n    {\n      num: \'01\',\n      icon: HeartHandshake,\n      title: \'Responsabilidade Social e Selo LPCS\',\n      desc: \'Associe a sua marca a uma IPSS de Utilidade P\303\272blica com mais de 35 anos de hist\303\263ria, recebendo o selo oficial Empresa Parceira Solid\303\241ria LPCS.\',\n    },\n    {\n      num: \'02\',\n      icon: Megaphone,\n      title: \'Visibilidade e Novos Clientes Fidelizados\',\n      desc: \'Presen\303\247a permanente no cat\303\241logo p\303\272blico pesquis\303\241vel por distrito, localidade e \303\241rea, al\303\251m de destaque nas comunica\303\247\303\265es aos s\303\263cios.\',\n    },\n    {\n      num: \'03\',\n      icon: FileCheck,\n      title: \'Enquadramento Fiscal (Mecenato Social)\',\n      desc: \'As empresas que complementem a parceria com donativos usufruem dos benef\303\255cios previstos no Estatuto dos Benef\303\255cios Fiscais (EBF).\',\n    },\n    {\n      num: \'04\',\n      icon: ShieldCheck,\n      title: \'Ades\303\243o Gratuita e Seguran\303\247a Anti-Abuso\',\n      desc: \'Zero taxas de entrada. Valida\303\247\303\243o instant\303\242nea ao balc\303\243o atrav\303\251s de c\303\263digos rotativos de 6 d\303\255gitos (HMAC-SHA256) de uso \303\272nico.\',\n    },\n    {\n      num: \'05\',\n      icon: BadgePercent,\n      title: \'Controlo Total sobre a Oferta\',\n      desc: \'Escolha o formato ideal para a sua opera\303\247\303\243o: cup\303\243o com limite de utiliza\303\247\303\265es, c\303\263digo percentual cont\303\255nuo ou voucher nominal.\',\n    },\n    {\n      num: \'06\',\n      icon: Users,\n      title: \'A\303\247\303\265es de Sa\303\272de para Equipas\',\n      desc: \'Acesso a sess\303\265es de literacia em sa\303\272de, preven\303\247\303\243o e rastreios an\303\263nimos conduzidos pelas equipas da LPCS junto dos seus colaboradores.\',\n    },\n  ];\n\n  return (\n    <div className=\"space-y-24 pb-16\">\n      {/* EDITORIAL HERO SPLIT */}\n      <section className=\"pt-8 sm:pt-14 pb-10 border-b border-stone-200/80 bg-[#FAF8F5]\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-stretch\">\n            {/* Left 7 columns: Institutional Headline, Copy, Primary Actions & Editorial Image */}\n            <div className=\"lg:col-span-7 flex flex-col justify-between space-y-8\">\n              <div className=\"space-y-6\">\n                <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-stone-500\">\n                  Liga Portuguesa Contra a SIDA <span aria-hidden=\"true\" className=\"mx-1.5 text-stone-300\">\302\267</span> Desde 1990\n                </div>\n\n                <h1 className=\"font-display text-4xl sm:text-5xl lg:text-[3.35rem] font-semibold text-[#141619] tracking-[-0.02em] leading-[1.08] text-balance\">\n                  Uma quota de <span className=\"text-[#C81E2B]\">35 \342\202\254 por ano</span> que apoia a sa\303\272de comunit\303\241ria e poupa{\' \'}\n                  <span className=\"tabular-nums underline decoration-stone-300 underline-offset-6\">\n                    {loading ? \'...\' : `+${totalSavings} \342\202\254`}\n                  </span>\n                  .\n                </h1>\n\n                <p className=\"text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl\">\n                  Ao tornar-se associado da LPCS financia rastreios an\303\263nimos, apoio psicossocial e a\303\247\303\265es de preven\303\247\303\243o em Portugal \342\200\224 e recupera o valor da sua quota logo na primeira utiliza\303\247\303\243o nos {partnersCount} parceiros certificados.\n                </p>\n\n                {/* Focused Action Hierarchy */}\n                <div className=\"pt-1 flex flex-wrap items-center gap-3\">\n                  {user ? (\n                    <button\n                      type=\"button\"\n                      onClick={() => onNavigate(\'/parceiros\')}\n                      className=\"px-6 py-3 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors flex items-center gap-2 whitespace-nowrap\"\n                    >\n                      <span>Explorar Parceiros</span>\n                      <ArrowRight className=\"w-4 h-4\" />\n                    </button>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => onNavigate(\'/registar\')}\n                      className=\"px-6 py-3 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors flex items-center gap-2 whitespace-nowrap\"\n                    >\n                      <span>Fazer-se S\303\263cio \302\267 35 \342\202\254/ano</span>\n                      <ArrowRight className=\"w-4 h-4\" />\n                    </button>\n                  )}\n\n                  <button\n                    type=\"button\"\n                    onClick={() => onNavigate(\'/parceiros\')}\n                    className=\"px-5 py-3 rounded-lg bg-white border border-stone-300 text-[#141619] font-semibold text-sm hover:bg-stone-100/70 transition-colors whitespace-nowrap\"\n                  >\n                    Cat\303\241logo P\303\272blico\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      const el = document.getElementById(\'quero-fazer-parceria\');\n                      if (el) {\n                        el.scrollIntoView({ behavior: \'smooth\' });\n                      } else {\n                        onNavigate(\'/parceria\');\n                      }\n                    }}\n                    className=\"px-5 py-3 rounded-lg border border-stone-300 bg-[#F3EFE8] hover:bg-stone-200/70 text-[#141619] font-semibold text-sm transition-colors flex items-center gap-2 whitespace-nowrap\"\n                  >\n                    <Building2 className=\"w-4 h-4 text-[#C81E2B]\" />\n                    <span>Quero Fazer Parceria</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Documentary Editorial Frame */}\n              <figure className=\"overflow-hidden rounded-2xl border border-stone-200 bg-stone-100\">\n                {!heroImgFailed ? (\n                  <img\n                    src={heroCommunityImg}\n                    alt=\"Atendimento e apoio comunit\303\241rio na Liga Portuguesa Contra a SIDA em Lisboa\"\n                    referrerPolicy=\"no-referrer\"\n                    onError={() => setHeroImgFailed(true)}\n                    className=\"w-full h-56 sm:h-64 object-cover\"\n                  />\n                ) : (\n                  <div className=\"w-full h-56 sm:h-64 bg-gradient-to-br from-stone-200 to-stone-100 flex items-center justify-center p-6 text-stone-600 text-sm font-medium\">\n                    Centro de Apoio e Preven\303\247\303\243o LPCS \302\267 Lisboa\n                  </div>\n                )}\n                <figcaption className=\"px-4 py-2.5 bg-white border-t border-stone-200 flex items-center justify-between text-xs text-stone-500\">\n                  <span>Apoio psicossocial e literacia em sa\303\272de comunit\303\241ria</span>\n                  <span className=\"font-mono text-[11px] text-stone-400\">Lisboa \302\267 Nacional</span>\n                </figcaption>\n              </figure>\n            </div>\n\n            {/* Right 5 columns: Member Login Portal or Active Member Desk */}\n            <div className=\"lg:col-span-5 flex flex-col justify-between bg-white rounded-2xl border border-stone-200 p-6 sm:p-8\">\n              {user ? (\n                <div className=\"flex flex-col justify-between h-full space-y-6\">\n                  <div className=\"space-y-4\">\n                    <div className=\"flex items-center justify-between pb-4 border-b border-stone-100\">\n                      <span className=\"text-xs font-semibold uppercase tracking-wider text-stone-500\">\n                        Sess\303\243o de Associado\n                      </span>\n                      <span className=\"font-mono text-xs font-semibold text-[#141619] tabular-nums\">\n                        {user.member_number}\n                      </span>\n                    </div>\n\n                    <div>\n                      <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight\">\n                        Bem-vindo, {user.name.split(\' \')[0]}\n                      </h2>\n                      <p className=\"text-sm text-stone-600 mt-2 leading-relaxed\">\n                        {user.quota_status.has_active_quota\n                          ? `A sua quota encontra-se regularizada com ${user.quota_status.days_remaining} dias de validade restantes.`\n                          : \'Regularize a sua quota anual ou semestral para emitir c\303\263digos de desconto nos parceiros.\'}\n                      </p>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-stone-100 grid grid-cols-2 gap-4 text-xs\">\n                      <div>\n                        <span className=\"text-stone-400 block\">Estado da Quota</span>\n                        <span\n                          className={`font-semibold mt-0.5 block ${\n                            user.quota_status.has_active_quota ? \'text-emerald-700\' : \'text-[#C81E2B]\'\n                          }`}\n                        >\n                          {user.quota_status.has_active_quota ? \'Ativa e V\303\241lida\' : \'Inativa / Expirada\'}\n                        </span>\n                      </div>\n                      <div>\n                        <span className=\"text-stone-400 block\">Validade</span>\n                        <span className=\"font-mono font-semibold text-[#141619] mt-0.5 block tabular-nums\">\n                          {user.quota_status.valid_until || \'\342\200\224\'}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-stone-100\">\n                    <button\n                      type=\"button\"\n                      onClick={() => onNavigate(\'/dashboard\')}\n                      className=\"py-2.5 px-4 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors\"\n                    >\n                      \303\201rea Pessoal\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => onNavigate(\'/pagamentos\')}\n                      className=\"py-2.5 px-4 rounded-lg border border-stone-300 bg-white hover:bg-stone-50 text-[#141619] font-semibold text-sm transition-colors\"\n                    >\n                      Quotas e Recibos\n                    </button>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"flex flex-col justify-between h-full space-y-6\">\n                  <div className=\"space-y-5\">\n                    <div className=\"flex items-start justify-between pb-4 border-b border-stone-100\">\n                      <div>\n                        <div className=\"text-xs font-semibold uppercase tracking-wider text-[#C81E2B]\">\n                          \303\201rea Reservada\n                        </div>\n                        <h2 className=\"font-display text-2xl font-semibold text-[#141619] tracking-tight mt-0.5\">\n                          Login para S\303\263cios\n                        </h2>\n                      </div>\n                      <LogIn className=\"w-5 h-5 text-stone-400 mt-1\" />\n                    </div>\n\n                    {loginError && (\n                      <div className=\"p-3.5 bg-red-50 border border-red-200 rounded-lg flex flex-col gap-2 text-xs text-red-800\">\n                        <div className=\"flex items-start gap-2\">\n                          <AlertCircle className=\"w-4 h-4 text-[#C81E2B] shrink-0 mt-0.5\" />\n                          <span>{loginError}</span>\n                        </div>\n                        {cookieBlocked && (\n                          <a\n                            href={window.location.href}\n                            target=\"_blank\"\n                            rel=\"noopener noreferrer\"\n                            className=\"self-start ml-6 px-3 py-1.5 rounded-md bg-[#C81E2B] text-white text-xs font-semibold hover:bg-[#A11622]\"\n                          >\n                            Abrir Portal num Novo Separador\n                          </a>\n                        )}\n                      </div>\n                    )}\n\n                    <form\n                      id=\"home-native-login-form\"\n                      method=\"post\"\n                      action=\"/api/auth/login\"\n                      onSubmit={handleInlineLogin}\n                      className=\"space-y-4\"\n                    >\n                      <div>\n                        <label className=\"block text-xs font-semibold text-stone-700 mb-1.5\">\n                          E-mail de Associado\n                        </label>\n                        <div className=\"relative\">\n                          <Mail className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                          <input\n                            type=\"email\"\n                            name=\"email\"\n                            required\n                            value={loginEmail}\n                            onChange={(e) => setLoginEmail(e.target.value)}\n                            placeholder=\"socio@exemplo.pt\"\n                            className=\"w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/60 text-sm text-[#141619] focus:outline-hidden focus:bg-white focus:border-[#C81E2B] focus:ring-1 focus:ring-[#C81E2B] transition-colors\"\n                          />\n                        </div>\n                      </div>\n\n                      <div>\n                        <label className=\"block text-xs font-semibold text-stone-700 mb-1.5\">\n                          Palavra-passe\n                        </label>\n                        <div className=\"relative\">\n                          <Lock className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                          <input\n                            type=\"password\"\n                            name=\"password\"\n                            required\n                            value={loginPassword}\n                            onChange={(e) => setLoginPassword(e.target.value)}\n                            placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                            className=\"w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-stone-300 bg-[#FAF8F5]/60 text-sm text-[#141619] focus:outline-hidden focus:bg-white focus:border-[#C81E2B] focus:ring-1 focus:ring-[#C81E2B] transition-colors\"\n                          />\n                        </div>\n                      </div>\n\n                      <button\n                        type=\"submit\"\n                        disabled={loginSubmitting}\n                        className=\"w-full py-3 rounded-lg bg-[#141619] hover:bg-stone-800 text-white font-semibold text-sm transition-colors flex items-center justify-center gap-2\"\n                      >\n                        {loginSubmitting ? (\n                          <>\n                            <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                            <span>A entrar...</span>\n                          </>\n                        ) : (\n                          <>\n                            <LogIn className=\"w-4 h-4\" />\n                            <span>Entrar na \303\201rea de S\303\263cio</span>\n                          </>\n                        )}\n                      </button>\n                    </form>\n                  </div>\n\n                  <div className=\"pt-4 border-t border-stone-100 flex items-center justify-between text-xs\">\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setLoginEmail(\'demo@lpcs.pt\');\n                        setLoginPassword(\'demo1234\');\n                      }}\n                      className=\"text-stone-500 hover:text-[#141619] font-medium underline decoration-stone-300 underline-offset-4\"\n                    >\n                      Usar conta de demonstra\303\247\303\243o\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => onNavigate(\'/registar\')}\n                      className=\"font-semibold text-[#C81E2B] hover:text-[#A11622]\"\n                    >\n                      Criar conta \342\206\222\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* FULL-WIDTH OPERATIONAL KPI STRIP */}\n          <div className=\"mt-12 bg-white rounded-xl border border-stone-200 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-stone-200\">\n            <div className=\"p-6 sm:p-7\">\n              <div className=\"text-xs font-semibold uppercase tracking-wider text-stone-500\">\n                Poupan\303\247a Anual Estimada\n              </div>\n              <div className=\"font-mono text-3xl sm:text-4xl font-bold text-[#141619] mt-2 tabular-nums\">\n                {loading ? \'...\' : `+${totalSavings} \342\202\254`}\n              </div>\n              <p className=\"text-xs text-stone-500 mt-1.5 leading-relaxed\">\n                Valor acumulado nos {partnersCount} acordos ativos em sa\303\272de, desporto, cultura e servi\303\247os.\n              </p>\n            </div>\n\n            <div className=\"p-6 sm:p-7\">\n              <div className=\"text-xs font-semibold uppercase tracking-wider text-stone-500\">\n                Retorno sobre a Quota\n              </div>\n              <div className=\"font-mono text-3xl sm:text-4xl font-bold text-[#C81E2B] mt-2 tabular-nums\">\n                {loading ? \'...\' : `${multiplier}\303\227`}\n              </div>\n              <p className=\"text-xs text-stone-500 mt-1.5 leading-relaxed\">\n                Por cada 1 \342\202\254 na quota anual de 35 \342\202\254, acede em m\303\251dia a {Math.floor(multiplier)} \342\202\254 em benef\303\255cios reais.\n              </p>\n            </div>\n\n            <div className=\"p-6 sm:p-7\">\n              <div className=\"text-xs font-semibold uppercase tracking-wider text-stone-500\">\n                Amortiza\303\247\303\243o Imediata\n              </div>\n              <div className=\"font-mono text-3xl sm:text-4xl font-bold text-[#141619] mt-2 tabular-nums\">\n                1\302\252 utiliza\303\247\303\243o\n              </div>\n              <p className=\"text-xs text-stone-500 mt-1.5 leading-relaxed\">\n                Uma consulta dent\303\241ria, an\303\241lise cl\303\255nica ou inscri\303\247\303\243o num gin\303\241sio supera de imediato os 35 \342\202\254 anuais.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* TRANSPARENCY & VALUE LEDGER */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#141619] text-stone-100 rounded-2xl p-8 sm:p-12 border border-stone-800\">\n          <div className=\"max-w-2xl mb-10 space-y-2\">\n            <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-rose-400\">\n              Transpar\303\252ncia e Custo Real\n            </div>\n            <h2 className=\"font-display text-3xl sm:text-4xl font-semibold tracking-tight text-white text-balance\">\n              35 \342\202\254 por ano equivalem a 2,92 \342\202\254 por m\303\252s.\n            </h2>\n            <p className=\"text-sm sm:text-base text-stone-400 leading-relaxed\">\n              Um contributo mensal acess\303\255vel que sustenta servi\303\247os gratuitos de sa\303\272de p\303\272blica e devolve centenas de euros em descontos diretos.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-stone-800 pt-8\">\n            <div className=\"space-y-6\">\n              <div>\n                <div className=\"text-xs font-semibold uppercase tracking-wider text-stone-400\">\n                  O seu contributo solid\303\241rio\n                </div>\n                <div className=\"font-mono text-4xl font-bold text-white mt-2 tabular-nums\">\n                  35,00 \342\202\254 <span className=\"text-sm font-sans font-normal text-stone-400\">/ ano</span>\n                </div>\n                <p className=\"text-xs text-stone-400 mt-1 tabular-nums\">\n                  Equivalente a 2,92 \342\202\254 por m\303\252s (ou plano semestral de 17,50 \342\202\254)\n                </p>\n              </div>\n\n              <ul className=\"space-y-3 text-sm text-stone-300 border-t border-stone-800 pt-5\">\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                  <span>Financiamento direto de testes r\303\241pidos an\303\263nimos e apoio psicol\303\263gico</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                  <span>Acesso integral aos {partnersCount} parceiros certificados em Portugal</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                  <span>Cart\303\243o de associado digital com emiss\303\243o instant\303\242nea de c\303\263digos</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"md:border-l md:border-stone-800 md:pl-8 space-y-6\">\n              <div>\n                <div className=\"text-xs font-semibold uppercase tracking-wider text-rose-400\">\n                  Retorno anual dispon\303\255vel\n                </div>\n                <div className=\"font-mono text-4xl font-bold text-rose-400 mt-2 tabular-nums\">\n                  {loading ? \'...\' : `+${totalSavings},00 \342\202\254`}\n                </div>\n                <p className=\"text-xs text-stone-400 mt-1\">\n                  Distribui\303\247\303\243o estimada por tipologia de benef\303\255cio:\n                </p>\n              </div>\n\n              <div className=\"divide-y divide-stone-800 border-t border-b border-stone-800 text-sm\">\n                <div className=\"py-3.5 flex items-center justify-between gap-4\">\n                  <span className=\"flex items-center gap-2.5 text-stone-300\">\n                    <Ticket className=\"w-4 h-4 text-rose-400 shrink-0\" />\n                    <span>Cup\303\265es promocionais (valor fixo em \342\202\254)</span>\n                  </span>\n                  <span className=\"font-mono font-semibold text-white tabular-nums\">\n                    {stats ? `${Math.round(stats.breakdown.couponSavings)} \342\202\254` : \'418 \342\202\254\'}\n                  </span>\n                </div>\n                <div className=\"py-3.5 flex items-center justify-between gap-4\">\n                  <span className=\"flex items-center gap-2.5 text-stone-300\">\n                    <Award className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                    <span>Vouchers nominais (consultas e exames)</span>\n                  </span>\n                  <span className=\"font-mono font-semibold text-white tabular-nums\">\n                    {stats ? `${Math.round(stats.breakdown.voucherSavings)} \342\202\254` : \'418 \342\202\254\'}\n                  </span>\n                </div>\n                <div className=\"py-3.5 flex items-center justify-between gap-4\">\n                  <span className=\"flex items-center gap-2.5 text-stone-300\">\n                    <Percent className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                    <span>C\303\263digos de desconto percentual cont\303\255nuo</span>\n                  </span>\n                  <span className=\"font-mono font-semibold text-white tabular-nums\">\n                    {stats ? `${Math.round(stats.breakdown.codeSavings)} \342\202\254` : \'732 \342\202\254\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* TOP BENEFITS + LIFESTYLE PROOF */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10\">\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-stone-200 pb-5\">\n          <div>\n            <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\">\n              Destaques do Cat\303\241logo\n            </div>\n            <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight mt-1\">\n              Benef\303\255cios que por si s\303\263 pagam a quota\n            </h2>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'/parceiros\')}\n            className=\"text-sm font-semibold text-[#C81E2B] hover:text-[#A11622] flex items-center gap-1 group whitespace-nowrap\"\n          >\n            <span>Ver todos os {partnersCount} parceiros</span>\n            <ChevronRight className=\"w-4 h-4 group-hover:translate-x-0.5 transition-transform\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5\">\n          {stats?.topBenefits?.map((item) => (\n            <button\n              type=\"button\"\n              key={item.id}\n              onClick={() => onNavigate(\'/parceiros\', { search: item.name })}\n              className=\"text-left bg-white rounded-xl p-6 border border-stone-200 hover:border-stone-400 transition-colors flex flex-col justify-between group\"\n            >\n              <div>\n                <div className=\"text-xs font-medium text-stone-500\">\n                  <span>{item.area}</span>\n                  {item.pays_quota && (\n                    <>\n                      <span aria-hidden=\"true\" className=\"mx-1.5 text-stone-300\">\302\267</span>\n                      <span className=\"text-emerald-700 font-semibold\">Paga a quota</span>\n                    </>\n                  )}\n                </div>\n                <h3 className=\"font-display text-lg font-semibold text-[#141619] group-hover:text-[#C81E2B] transition-colors mt-2\">\n                  {item.name}\n                </h3>\n                <p className=\"text-sm font-semibold text-[#C81E2B] mt-1.5\">\n                  {item.discount_highlight}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-stone-100 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-xs text-stone-400 block\">Poupan\303\247a estimada</span>\n                  <span className=\"text-sm font-mono font-bold text-[#141619] tabular-nums\">\n                    {item.estimated_annual_savings} \342\202\254 / ano\n                  </span>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-stone-400 group-hover:text-[#C81E2B] group-hover:translate-x-0.5 transition-all\" />\n              </div>\n            </button>\n          ))}\n        </div>\n\n        {/* Editorial Proof Banner with Wellness Photo */}\n        <div className=\"bg-white rounded-2xl border border-stone-200 overflow-hidden grid grid-cols-1 lg:grid-cols-12 items-stretch\">\n          <div className=\"lg:col-span-5 bg-stone-100\">\n            {!wellnessImgFailed ? (\n              <img\n                src={wellnessBenefitImg}\n                alt=\"Atendimento personalizado em parceiro de sa\303\272de e bem-estar\"\n                referrerPolicy=\"no-referrer\"\n                onError={() => setWellnessImgFailed(true)}\n                className=\"w-full h-60 lg:h-full object-cover\"\n              />\n            ) : (\n              <div className=\"w-full h-60 lg:h-full bg-stone-200 flex items-center justify-center p-6 text-stone-600 text-sm\">\n                Rede Nacional de Sa\303\272de e Bem-estar\n              </div>\n            )}\n          </div>\n          <div className=\"lg:col-span-7 p-8 sm:p-10 flex flex-col justify-center space-y-4\">\n            <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-stone-500\">\n              Utiliza\303\247\303\243o Simples e Segura\n            </div>\n            <h3 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight text-balance\">\n              Do telem\303\263vel para o balc\303\243o em segundos, sem cart\303\265es f\303\255sicos.\n            </h3>\n            <p className=\"text-sm text-stone-600 leading-relaxed max-w-xl\">\n              Qualquer associado com quota regularizada gera um c\303\263digo din\303\242mico de 6 d\303\255gitos (dispon\303\255vel durante 3 minutos com atualiza\303\247\303\243o a cada 30 segundos) para valida\303\247\303\243o imediata no estabelecimento parceiro.\n            </p>\n            <div className=\"pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'/parceiros\')}\n                className=\"inline-flex items-center gap-2 text-sm font-semibold text-[#C81E2B] hover:text-[#A11622]\"\n              >\n                <span>Consultar todos os descontos dispon\303\255veis</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 6 ACTIVITY AREAS DIRECTORY */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        <div className=\"max-w-2xl\">\n          <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\">\n            Cobertura Nacional\n          </div>\n          <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight mt-1\">\n            Vantagens em 6 \303\241reas do quotidiano\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {categories.map((cat) => (\n            <button\n              type=\"button\"\n              key={cat.name}\n              onClick={() => onNavigate(\'/parceiros\', { area: cat.name })}\n              className=\"text-left bg-white rounded-xl p-6 border border-stone-200 hover:border-stone-400 transition-colors group flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between text-xs text-stone-500 mb-3\">\n                  <span className=\"font-mono font-semibold text-stone-400\">{cat.num}</span>\n                  <span className=\"font-mono tabular-nums\">{cat.count} parceiros</span>\n                </div>\n                <h3 className=\"font-display text-lg font-semibold text-[#141619] group-hover:text-[#C81E2B] transition-colors\">\n                  {cat.name}\n                </h3>\n                <p className=\"text-xs sm:text-sm text-stone-600 mt-2 leading-relaxed\">\n                  {cat.desc}\n                </p>\n              </div>\n              <div className=\"mt-5 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#141619] group-hover:text-[#C81E2B]\">\n                <span>Explorar \303\241rea</span>\n                <ChevronRight className=\"w-4 h-4 group-hover:translate-x-0.5 transition-transform\" />\n              </div>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* DEDICATED \"QUERO FAZER PARCERIA\" FOR COMPANIES */}\n      <section id=\"quero-fazer-parceria\" className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white rounded-2xl border border-stone-200 overflow-hidden\">\n          {/* Architectural Banner */}\n          <div className=\"relative h-64 sm:h-72 bg-[#141619]\">\n            {!partnerImgFailed && (\n              <img\n                src={partnershipStreetImg}\n                alt=\"Com\303\251rcio local e cl\303\255nicas parceiras da LPCS em Portugal\"\n                referrerPolicy=\"no-referrer\"\n                onError={() => setPartnerImgFailed(true)}\n                className=\"w-full h-full object-cover opacity-75\"\n              />\n            )}\n            <div className=\"absolute inset-0 bg-gradient-to-t from-[#141619] via-[#141619]/65 to-transparent\" />\n            <div className=\"absolute inset-0 p-6 sm:p-10 flex flex-col justify-end\">\n              <div className=\"max-w-3xl space-y-2\">\n                <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-rose-300\">\n                  Para Empresas e Comerciantes \302\267 Ades\303\243o Gratuita\n                </div>\n                <h2 className=\"font-display text-2xl sm:text-4xl font-semibold text-white tracking-tight text-balance\">\n                  Quero fazer parceria com a Liga Portuguesa Contra a SIDA\n                </h2>\n                <p className=\"text-sm text-stone-200 max-w-2xl leading-relaxed\">\n                  Ofere\303\247a descontos aos associados da LPCS e ganhe visibilidade nacional, impacto ESG certificado, clientes recorrentes e enquadramento de mecenato social.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-6 sm:p-10 space-y-8\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n              {companyBenefits.map((benefit) => {\n                const Icon = benefit.icon;\n                return (\n                  <div\n                    key={benefit.title}\n                    className=\"p-5 rounded-xl bg-[#FAF8F5] border border-stone-200/80 space-y-2.5\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <Icon className=\"w-5 h-5 text-[#C81E2B]\" />\n                      <span className=\"font-mono text-xs text-stone-400\">{benefit.num}</span>\n                    </div>\n                    <h3 className=\"text-base font-semibold text-[#141619]\">{benefit.title}</h3>\n                    <p className=\"text-xs sm:text-sm text-stone-600 leading-relaxed\">{benefit.desc}</p>\n                  </div>\n                );\n              })}\n            </div>\n\n            <div className=\"pt-6 border-t border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div className=\"text-sm text-stone-600\">\n                <strong className=\"text-[#141619]\">Sem comiss\303\265es nem custos fixos.</strong>{\' \'}\n                Valida\303\247\303\243o instant\303\242nea ao balc\303\243o atrav\303\251s de <span className=\"font-mono text-xs\">/validar</span>.\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'/parceria\')}\n                className=\"px-6 py-3 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors flex items-center justify-center gap-2 whitespace-nowrap shrink-0\"\n              >\n                <span>Submeter Proposta de Parceria</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* QUOTA PLANS COMPARISON */}\n      <section className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        <div className=\"text-center max-w-xl mx-auto space-y-2\">\n          <div className=\"text-xs font-semibold uppercase tracking-[0.14em] text-[#C81E2B]\">\n            Modalidades de Quota\n          </div>\n          <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-[#141619] tracking-tight\">\n            Escolha como prefere apoiar a LPCS\n          </h2>\n          <p className=\"text-sm text-stone-600\">\n            Ambos os planos conferem estatuto completo de associado e acesso imediato a todos os parceiros.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {/* Semestral */}\n          <div className=\"bg-white rounded-2xl p-8 border border-stone-200 flex flex-col justify-between space-y-8\">\n            <div>\n              <div className=\"text-xs font-semibold uppercase tracking-wider text-stone-500\">\n                Plano Semestral\n              </div>\n              <div className=\"font-mono text-3xl sm:text-4xl font-bold text-[#141619] mt-2 tabular-nums\">\n                17,50 \342\202\254 <span className=\"text-sm font-sans font-normal text-stone-500\">/ 6 meses</span>\n              </div>\n              <p className=\"text-xs text-stone-500 mt-1\">Renova\303\247\303\243o flex\303\255vel de seis em seis meses.</p>\n\n              <ul className=\"mt-6 pt-6 border-t border-stone-100 space-y-3 text-sm text-stone-700\">\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Acesso a todos os {partnersCount} parceiros e descontos</span>\n                </li>\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Emiss\303\243o de c\303\263digos rotativos de 6 d\303\255gitos</span>\n                </li>\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Recibos oficiais arquivados no portal</span>\n                </li>\n              </ul>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n              className=\"w-full py-3 px-4 rounded-lg border border-stone-300 bg-white hover:bg-stone-50 font-semibold text-sm text-[#141619] transition-colors\"\n            >\n              Aderir ao Plano Semestral\n            </button>\n          </div>\n\n          {/* Anual */}\n          <div className=\"bg-white rounded-2xl p-8 border-2 border-[#C81E2B] flex flex-col justify-between space-y-8\">\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-semibold uppercase tracking-wider text-[#C81E2B]\">\n                  Plano Anual Completo\n                </span>\n                <span className=\"text-xs font-semibold text-[#C81E2B]\">Mais vantajosa</span>\n              </div>\n              <div className=\"font-mono text-3xl sm:text-4xl font-bold text-[#141619] mt-2 tabular-nums\">\n                35,00 \342\202\254 <span className=\"text-sm font-sans font-normal text-stone-500\">/ 12 meses</span>\n              </div>\n              <p className=\"text-xs text-stone-600 mt-1 tabular-nums\">Equivale a 2,92 \342\202\254 por m\303\252s.</p>\n\n              <ul className=\"mt-6 pt-6 border-t border-stone-100 space-y-3 text-sm text-stone-700\">\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-[#C81E2B] shrink-0\" />\n                  <span>12 meses de acesso cont\303\255nuo a todos os parceiros</span>\n                </li>\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-[#C81E2B] shrink-0\" />\n                  <span>Potencial completo de poupan\303\247a (+{totalSavings} \342\202\254 anuais)</span>\n                </li>\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-[#C81E2B] shrink-0\" />\n                  <span>Maior estabilidade de apoio aos projetos sociais LPCS</span>\n                </li>\n                <li className=\"flex items-center gap-2.5\">\n                  <Check className=\"w-4 h-4 text-[#C81E2B] shrink-0\" />\n                  <span>Renova\303\247\303\243o acumula sobre a data de validade atual</span>\n                </li>\n              </ul>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(user ? \'/pagamentos\' : \'/registar\')}\n              className=\"w-full py-3 px-4 rounded-lg bg-[#C81E2B] hover:bg-[#A11622] text-white font-semibold text-sm transition-colors\"\n            >\n              Aderir ao Plano Anual (35 \342\202\254)\n            </button>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
