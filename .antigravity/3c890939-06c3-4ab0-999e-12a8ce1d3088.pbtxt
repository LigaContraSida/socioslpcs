        use_fast_apply: true
        replacement_chunks {
          target_content: "  const [autoCloseRemaining, setAutoCloseRemaining] = useState(120); // 2 minutes auto-close\n\n  // Fetch code update every second / when seconds reach 0\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsRemaining((prev) => {\n        if (prev <= 1) {\n          // Refresh code from server\n          fetch(`/api/benefits/code-refresh/${redemptionData.redemption_id}`)\n            .then((r) => r.json())\n            .then((data) => {\n              if (data.totp_code) {\n                setCurrentCode(data.totp_code);\n                setSecondsRemaining(data.seconds_remaining || 30);\n              }\n            })\n            .catch((err) => console.error(\'Error refreshing code:\', err));\n          return 30;\n        }"
          replacement_content: "  const [autoCloseRemaining, setAutoCloseRemaining] = useState(180); // 3 minutes availability\n\n  // Fetch code update every second / when seconds reach 0\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsRemaining((prev) => {\n        if (prev <= 1) {\n          // Refresh code from server\n          fetch(`/api/benefits/code-refresh/${redemptionData.redemption_id}`, {\n            credentials: \'same-origin\',\n          })\n            .then((r) => r.json())\n            .then((data) => {\n              if (data.totp_code) {\n                setCurrentCode(data.totp_code);\n                setSecondsRemaining(data.seconds_remaining || 30);\n              }\n            })\n            .catch((err) => console.error(\'Error refreshing code:\', err));\n          return 30;\n        }"
          start_line: 28
          end_line: 45
        }
        replacement_chunks {
          target_content: "          {/* Security Notice & Auto-Close Timer */}\n          <div className=\"mt-6 flex items-start gap-2 text-xs text-slate-500 bg-amber-50/80 p-3 rounded-xl border border-amber-200/60\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n            <p>\n              Apresente este ecr\303\243 ou faculte a refer\303\252ncia e o c\303\263digo de 6 d\303\255gitos ao comerciante. Por raz\303\265es de seguran\303\247a, o c\303\263digo \303\251 de uso \303\272nico e esta janela fecha automaticamente em <strong>{autoCloseRemaining} segundos</strong>.\n            </p>\n          </div>"
          replacement_content: "          {/* Security Notice & Auto-Close Timer */}\n          <div className=\"mt-6 flex items-start gap-2 text-xs text-slate-500 bg-amber-50/80 p-3 rounded-xl border border-amber-200/60\">\n            <AlertTriangle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n            <p>\n              Apresente este ecr\303\243 ou faculte a refer\303\252ncia e o c\303\263digo de 6 d\303\255gitos ao comerciante. O c\303\263digo rotativo fica dispon\303\255vel durante 3 minutos e esta janela fecha automaticamente em{\' \'}\n              <strong>\n                {Math.floor(autoCloseRemaining / 60)}m {(autoCloseRemaining % 60).toString().padStart(2, \'0\')}s\n              </strong>\n              .\n            </p>\n          </div>"
