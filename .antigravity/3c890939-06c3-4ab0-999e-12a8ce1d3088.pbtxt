    end_line: 254
    content: "import React, { useState, useEffect } from \'react\';\nimport { Mail, Lock, LogIn, AlertCircle, ShieldCheck, Sparkles, User as UserIcon } from \'lucide-react\';\n\nimport { User } from \'../types.ts\';\n\ninterface LoginPageProps {\n  onNavigate: (path: string) => void;\n  onRefreshUser: () => Promise<User | null> | void;\n}\n\nexport const LoginPage: React.FC<LoginPageProps> = ({ onNavigate, onRefreshUser }) => {\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [cookieBlocked, setCookieBlocked] = useState(false);\n  const [submitting, setSubmitting] = useState(false);\n\n  // Read error parameter from URL if redirected by native form post\n  useEffect(() => {\n    const params = new URLSearchParams(window.location.search);\n    const err = params.get(\'error\');\n    if (err) {\n      setErrorMessage(decodeURIComponent(err));\n    }\n  }, []);\n\n  const handleFillDemo = (demoType: \'member\' | \'admin\') => {\n    if (demoType === \'member\') {\n      setEmail(\'demo@lpcs.pt\');\n      setPassword(\'demo1234\');\n    } else {\n      setEmail(\'admin@lpcs.pt\');\n      setPassword(\'Admin!2026\');\n    }\n  };\n\n  const handleFetchSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitting(true);\n    setErrorMessage(null);\n    setCookieBlocked(false);\n\n    try {\n      const res = await fetch(\'/api/auth/login\', {\n        method: \'POST\',\n        credentials: \'same-origin\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ email, password }),\n      });\n\n      const data = await res.json();\n\n      if (!res.ok) {\n        setErrorMessage(data.error || \'Credenciais inv\303\241lidas.\');\n        setSubmitting(false);\n        return;\n      }\n\n      const loggedUser = await onRefreshUser();\n      if (!loggedUser) {\n        setCookieBlocked(true);\n        setErrorMessage(\n          \'O seu browser bloqueou os cookies de sess\303\243o dentro da janela de pr\303\251-visualiza\303\247\303\243o. Abra o portal num novo separador para iniciar sess\303\243o.\'\n        );\n        setSubmitting(false);\n        return;\n      }\n\n      setSubmitting(false);\n      onNavigate(data.redirect || \'/dashboard\');\n    } catch (err) {\n      console.error(\'Login error:\', err);\n      // Fallback: submit native form if javascript fetch had any issue\n      const form = document.getElementById(\'native-login-form\') as HTMLFormElement;\n      form?.submit();\n    }\n  };\n\n  return (\n    <div className=\"max-w-md mx-auto px-4 py-16\">\n      \n      {/* Brand icon and title */}\n      <div className=\"text-center space-y-2 mb-8\">\n        <div className=\"w-14 h-14 rounded-2xl bg-red-600 flex items-center justify-center text-white mx-auto shadow-lg shadow-red-200\">\n          <svg className=\"w-8 h-8 fill-white\" viewBox=\"0 0 24 24\">\n            <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n          </svg>\n        </div>\n        <h1 className=\"text-2xl font-black text-slate-900 tracking-tight\">\n          Entrar no Portal LPCS\n        </h1>\n        <p className=\"text-xs text-slate-500\">\n          Aceda \303\240 sua \303\241rea pessoal de associado e aos descontos de parceiros\n        </p>\n      </div>\n\n      {/* Main card */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl space-y-6\">\n        \n        {errorMessage && (\n          <div className=\"p-4 bg-red-50 border border-red-200 rounded-2xl flex flex-col gap-2 text-xs sm:text-sm text-red-700\">\n            <div className=\"flex items-center gap-3\">\n              <AlertCircle className=\"w-5 h-5 text-red-600 shrink-0\" />\n              <span>{errorMessage}</span>\n            </div>\n            {cookieBlocked && (\n              <a\n                href={window.location.href}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"self-start ml-8 px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs font-bold hover:bg-red-700\"\n              >\n                Abrir Portal num Novo Separador\n              </a>\n            )}\n          </div>\n        )}\n\n        {/* Quick Demo Credentials Bar */}\n        <div className=\"bg-slate-50 p-3.5 rounded-2xl border border-slate-200 text-xs space-y-2\">\n          <div className=\"flex items-center gap-1.5 font-bold text-slate-700\">\n            <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n            <span>Acesso R\303\241pido de Demonstra\303\247\303\243o:</span>\n          </div>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleFillDemo(\'member\')}\n              className=\"py-1.5 px-2.5 rounded-lg bg-white border border-slate-200 hover:border-red-300 text-slate-700 font-semibold text-[11px] text-left transition-colors\"\n            >\n              <strong className=\"block text-slate-900\">S\303\263cio Demo</strong>\n              <span className=\"text-[10px] text-slate-500\">demo@lpcs.pt</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleFillDemo(\'admin\')}\n              className=\"py-1.5 px-2.5 rounded-lg bg-white border border-slate-200 hover:border-purple-300 text-slate-700 font-semibold text-[11px] text-left transition-colors\"\n            >\n              <strong className=\"block text-purple-900\">Administrador</strong>\n              <span className=\"text-[10px] text-slate-500\">admin@lpcs.pt</span>\n            </button>\n          </div>\n        </div>\n\n        {/* NATIVE HTML FORM (Guaranteed to work even before JS hydration) */}\n        <form\n          id=\"native-login-form\"\n          method=\"post\"\n          action=\"/api/auth/login\"\n          onSubmit={handleFetchSubmit}\n          className=\"space-y-4\"\n        >\n          <div>\n            <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n              Endere\303\247o de E-mail\n            </label>\n            <div className=\"relative\">\n              <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"email\"\n                name=\"email\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                placeholder=\"exemplo@lpcs.pt\"\n                required\n                className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n              Palavra-passe\n            </label>\n            <div className=\"relative\">\n              <Lock className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"password\"\n                name=\"password\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                required\n                className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n              />\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={submitting}\n            className=\"w-full py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm shadow-md shadow-red-200 transition-all flex items-center justify-center gap-2\"\n          >\n            {submitting ? (\n              <>\n                <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                <span>A entrar...</span>\n              </>\n            ) : (\n              <>\n                <LogIn className=\"w-4 h-4\" />\n                <span>Iniciar Sess\303\243o</span>\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Divider */}\n        <div className=\"relative my-4\">\n          <div className=\"absolute inset-0 flex items-center\">\n            <div className=\"w-full border-t border-slate-200\" />\n          </div>\n          <div className=\"relative flex justify-center text-xs uppercase\">\n            <span className=\"bg-white px-2 text-slate-400 font-semibold\">ou</span>\n          </div>\n        </div>\n\n        {/* Google OAuth Button (with graceful disabled state if not configured) */}\n        <div>\n          <button\n            type=\"button\"\n            disabled\n            title=\"A integra\303\247\303\243o com Google OAuth pode ser ativada configurando as credenciais no servidor.\"\n            className=\"w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-400 text-xs font-semibold flex items-center justify-center gap-2 cursor-not-allowed\"\n          >\n            <svg className=\"w-4 h-4 opacity-40\" viewBox=\"0 0 24 24\">\n              <path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"#FBBC05\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\"/>\n              <path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\"/>\n            </svg>\n            <span>Continuar com Google (Dispon\303\255vel com Chave OAuth)</span>\n          </button>\n          <p className=\"text-[10px] text-slate-400 text-center mt-1\">\n            Utilize o registo por e-mail ou as credenciais de demonstra\303\247\303\243o acima.\n          </p>\n        </div>\n\n        {/* Footer Link */}\n        <div className=\"pt-4 border-t border-slate-100 text-center text-xs text-slate-600\">\n          Ainda n\303\243o \303\251 associado da LPCS?{\' \'}\n          <button\n            onClick={() => onNavigate(\'/registar\')}\n            className=\"font-bold text-red-600 hover:text-red-700\"\n          >\n            Fazer-me S\303\263cio\n          </button>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    num_lines: 255
