            }
            lines {
              text: "  const today = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let age = today.getFullYear() - birth.getFullYear();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const m = today.getMonth() - birth.getMonth();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    age--;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
