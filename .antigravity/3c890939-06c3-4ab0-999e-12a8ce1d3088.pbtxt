      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Show open-in-new-tab link in LoginPage if browser blocked iframe cookies\", \"EndLine\":98, \"Instruction\":\"Render open in new tab link when cookieBlocked is true in LoginPage.tsx\", \"ReplacementContent\":\"        {errorMessage && (\\n          <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-2xl flex flex-col gap-2 text-xs sm:text-sm text-red-700\\\">\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <AlertCircle className=\\\"w-5 h-5 text-red-600 shrink-0\\\" />\\n              <span>{errorMessage}</span>\\n            </div>\\n            {cookieBlocked && (\\n              <a\\n                href={window.location.href}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"self-start ml-8 px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs font-bold hover:bg-red-700\\\"\\n              >\\n                Abrir Portal num Novo Separador\\n              </a>\\n            )}\\n          </div>\\n        )}\", \"StartLine\":80, \"TargetContent\":\"        {errorMessage && (\\n          <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3 text-xs sm:text-sm text-red-700\\\">\\n            <AlertCircle className=\\\"w-5 h-5 text-red-600 shrink-0\\\" />\\n            <span>{errorMessage}</span>\\n          </div>\\n        )}\", \"TargetFile\":\"/src/pages/LoginPage.tsx\", \"toolAction\":\"Updating LoginPage error banner\", \"toolSummary\":\"Add open-in-new-tab fallback in LoginPage.tsx\", \"waitForPreviousTools\":true}"
      original_name: "replace_file_content"
    }
