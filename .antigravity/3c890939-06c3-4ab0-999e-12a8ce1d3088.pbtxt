mber;\n    discount_highlight: string;\n    pays_quota: boolean;\n  }>;\n}\n\nexport interface AuditLog {\n  id: number;\n  user_id?: number;\n  user_name?: string;\n  member_number?: string;\n  action: string;\n  details: string;\n  ip_address?: string;\n  user_agent?: string;\n  created_at: string;\n}\n"
