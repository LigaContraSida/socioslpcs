value: \'1 m\303\252s de aulas gr\303\241tis\',\n        discount_highlight: \'1 m\303\252s de aulas de hidrogin\303\241stica/nata\303\247\303\243o gratuito\',\n        usage_limit: \'Voucher nominal \302\267 Uso \303\272nico por associado\',\n        estimated_annual_savings: 45.0,\n        secret_code: \'AQUAVIVA1M\',\n        terms: \'V\303\241lido para frequ\303\252ncia 2 vezes por semana em nata\303\247\303\243o livre ou aulas de hidrogin\303\241stica durante 30 dias consecutivos.\',\n        description: \'Complexo aqu\303\241tico com piscinas tratadas com sal, temperatura controlada e escola de nata\303\247\303\243o para todas as idades.\'\n      },\n      {\n        name: \'\303\223tica Novo Olhar\',\n        category: \'\303\223pticas & Arma\303\247\303\265es\',\n        area: \'Sa\303\272de e Bem-estar\',\n        district: \'Braga\',\n        city: \'Guimar\303\243es\',\n        benefit_type: \'codigo\',\n        benefit_value: \'28% em lentes\',\n        discount_highlight: \'28% de desconto em lentes graduadas\',\n        usage_limit: \'C\303\263digo de desconto \302\267 Utiliza\303\247\303\243o cont\303\255nua\',\n        estimated_annual_savings: 84.0,\n        secret_code: \'OLHAR28\',\n        terms: \'Aplic\303\241vel em lentes monofocais e progressivas digitais de alta gama com tratamento antirreflexo.\',\n        description: \'Centro \303\263tico tradicional em Guimar\303\243es com oficina pr\303\263pria de montagem r\303\241pida e tecnologia de centra\303\247\303\243o 3D.\'\n      },\n      {\n        name: \'Livraria & Caf\303\251 Semear\',\n        category: \'Livrarias & Lazer\',\n        area: \'Lazer e Cultura\',\n        district: \'Porto\',\n        city: \'V. N. Gaia\',\n        benefit_type: \'cupao\',\n        benefit_value: \'4\342\202\254 por compra (\303\22712)\',\n        discount_highlight: \'4\342\202\254 de desconto por compra mensal\',\n        usage_limit: \'Cup\303\243o de 4,00\342\202\254 \302\267 at\303\251 12 utiliza\303\247\303\265es por ano (1 por m\303\252s)\',\n        estimated_annual_savings: 48.0,\n        secret_code: \'SEMEAR4\',\n        terms: \'V\303\241lido em compras de livros e artigos culturais a partir de 20\342\202\254. N\303\243o acumul\303\241vel com saldos.\',\n        description: \'Espa\303\247o comunit\303\241rio acolhedor com esplanada, livros selecionados, workshops mensais e cafetaria biol\303\263gica.\'\n      },\n      {\n        name: \'Viagens Horizonte Aberto\',\n        category: \'Ag\303\252ncias de Viagens & Turismo\',\n        area: \'Lazer e Cultura\',\n        district: \'Nacional\',\n        city: \'Online\',\n        benefit_type: \'voucher\',\n        benefit_value: \'75\342\202\254 na pr\303\263xima viagem\',\n        discount_highlight: \'75\342\202\254 de desconto em pacotes de viagem\',\n        usage_limit: \'Voucher nominal \302\267 Uso \303\272nico por associado\',\n        estimated_annual_savings: 75.0,\n        secret_code: \'HORIZ75\',\n        terms: \'V\303\241lido em pacotes tur\303\255sticos de voo + hotel a partir de 500\342\202\254 em destinos nacionais e internacionais.\',\n        description: \'Ag\303\252ncia de viagens especializada em turismo sustent\303\241vel, escapadinhas na natureza e viagens \303\240 medida.\'\n      },\n      {\n        name: \'Cabeleireiro Studio Raiz\',\n        category: \'Est\303\251tica & Cabeleireiro\',\n        area: \'Sa\303\272de e Bem-estar\',\n        district: \'Set\303\272bal\',\n        city: \'Set\303\272bal\',\n        benefit_type: \'codigo\',\n        benefit_value: \'20% em servi\303\247os\',\n        discount_highlight: \'20% de desconto em corte e tratamentos\',\n        usage_limit: \'C\303\263digo de desconto \302\267 Utiliza\303\247\303\243o cont\303\255nua\',\n        estimated_annual_savings: 36.0,\n        secret_code: \'RAIZ20\',\n        terms: \'V\303\241lido em servi\303\247os de corte, colora\303\247\303\243o biol\303\263gica e tratamentos capilares de hidrata\303\247\303\243o profunda.\',\n        description: \'Sal\303\243o de beleza sustent\303\241vel que utiliza produtos vegan e cruelty-free num ambiente relaxante e profissional.\'\n      }\n    ];\n\n    const stmt = db.prepare(`\n      INSERT INTO partners (\n        name, category, area, district, city, benefit_type, benefit_value,\n        discount_highlight, usage_limit, estimated_annual_savings, secret_code,\n        terms, description\n      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `);\n\n    for (const p of initialPartners) {\n      stmt.run(\n        p.name,\n        p.category,\n        p.area,\n        p.district,\n        p.city,\n        p.benefit_type,\n        p.benefit_value,\n        p.discount_highlight,\n        p.usage_limit,\n        p.estimated_annual_savings,\n        p.secret_code,\n        p.terms,\n        p.description\n      );\n    }\n  }\n}\n"
