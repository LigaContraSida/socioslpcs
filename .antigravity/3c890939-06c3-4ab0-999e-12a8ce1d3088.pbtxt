    end_line: 318
    content: "import React, { useState } from \'react\';\nimport { User } from \'../types.ts\';\nimport { \n  User as UserIcon, \n  Mail, \n  MapPin, \n  Phone, \n  Calendar, \n  CheckCircle2, \n  AlertCircle, \n  ShieldCheck, \n  Save, \n  FileCheck\n} from \'lucide-react\';\n\ninterface ProfilePageProps {\n  user: User;\n  onRefreshUser: () => void;\n}\n\n// Client-side quick NIF module 11 check for instant UI feedback\nfunction checkNifClient(nif: string): boolean {\n  const clean = nif.trim();\n  if (!/^[0-9]{9}$/.test(clean)) return false;\n  if (![\'1\', \'2\', \'3\', \'5\', \'6\', \'8\', \'9\'].includes(clean[0])) return false;\n  let sum = 0;\n  for (let i = 0; i < 8; i++) {\n    sum += parseInt(clean[i], 10) * (9 - i);\n  }\n  const rem = sum % 11;\n  const check = rem < 2 ? 0 : 11 - rem;\n  return check === parseInt(clean[8], 10);\n}\n\nexport const ProfilePage: React.FC<ProfilePageProps> = ({ user, onRefreshUser }) => {\n  const [formData, setFormData] = useState({\n    name: user.name || \'\',\n    birth_date: user.birth_date || \'\',\n    address: user.address || \'\',\n    postal_code: user.postal_code || \'\',\n    city: user.city || \'\',\n    nif: user.nif || \'\',\n    phone: user.phone || \'\',\n  });\n\n  const [saving, setSaving] = useState(false);\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  const isNifValid = checkNifClient(formData.nif);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSaving(true);\n    setSuccessMessage(null);\n    setErrorMessage(null);\n\n    try {\n      const res = await fetch(\'/api/profile\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(formData),\n      });\n\n      const data = await res.json();\n\n      if (!res.ok) {\n        setErrorMessage(data.error || \'Erro ao atualizar dados do perfil.\');\n        setSaving(false);\n        return;\n      }\n\n      setSuccessMessage(\'Dados de associado atualizados com sucesso!\');\n      setSaving(false);\n      onRefreshUser();\n    } catch (err) {\n      console.error(\'Profile update error:\', err);\n      setErrorMessage(\'Falha ao comunicar com o servidor.\');\n      setSaving(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\">\n      \n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-6\">\n        <div>\n          <span className=\"text-xs font-bold uppercase tracking-wider text-red-600\">\303\201rea Pessoal de Associado</span>\n          <h1 className=\"text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">\n            Perfil do Associado\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            Mantenha os seus dados pessoais e de fatura\303\247\303\243o sempre atualizados para efeitos estat\303\255sticos e fiscais.\n          </p>\n        </div>\n\n        {/* Member ID chip */}\n        <div className=\"bg-slate-900 text-white px-4 py-2.5 rounded-2xl flex items-center gap-3 shrink-0\">\n          <ShieldCheck className=\"w-5 h-5 text-red-500\" />\n          <div>\n            <span className=\"text-[10px] text-slate-400 block uppercase font-bold\">N\302\272 de Associado</span>\n            <span className=\"font-mono font-bold text-sm text-white\">{user.member_number}</span>\n          </div>\n        </div>\n      </div>\n\n      {successMessage && (\n        <div className=\"p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-xs sm:text-sm text-emerald-800\">\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n          <span>{successMessage}</span>\n        </div>\n      )}\n\n      {errorMessage && (\n        <div className=\"p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3 text-xs sm:text-sm text-red-700\">\n          <AlertCircle className=\"w-5 h-5 text-red-600 shrink-0\" />\n          <span>{errorMessage}</span>\n        </div>\n      )}\n\n      {/* Profile Form */}\n      <div className=\"bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xs\">\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          \n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n            \n            {/* Full Name */}\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Nome Completo (m\303\255nimo dois termos) *\n              </label>\n              <div className=\"relative\">\n                <UserIcon className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  placeholder=\"Nome e Apelido\"\n                  className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n                  required\n                />\n              </div>\n            </div>\n\n            {/* Email (read-only for security) */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Endere\303\247o de E-mail\n              </label>\n              <div className=\"relative\">\n                <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"email\"\n                  value={user.email}\n                  disabled\n                  className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm cursor-not-allowed\"\n                />\n              </div>\n              <span className=\"text-[11px] text-slate-400 mt-1 block\">O e-mail \303\251 o identificador \303\272nico da sua conta.</span>\n            </div>\n\n            {/* Birth Date (age >= 16) */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Data de Nascimento (m\303\255nimo 16 anos) *\n              </label>\n              <div className=\"relative\">\n                <Calendar className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"date\"\n                  value={formData.birth_date}\n                  onChange={(e) => setFormData({ ...formData, birth_date: e.target.value })}\n                  className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500\"\n                  required\n                />\n              </div>\n            </div>\n\n            {/* NIF with modulo 11 live validator */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">\n                  NIF (N\303\272mero de Identifica\303\247\303\243o Fiscal) *\n                </label>\n                {formData.nif.length === 9 && (\n                  <span className={`text-[11px] font-bold flex items-center gap-1 ${isNifValid ? \'text-emerald-600\' : \'text-red-600\'}`}>\n                    {isNifValid ? (\n                      <>\n                        <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                        <span>V\303\241lido (M\303\263dulo 11)</span>\n                      </>\n                    ) : (\n                      <>\n                        <AlertCircle className=\"w-3.5 h-3.5\" />\n                        <span>D\303\255gito de controlo inv\303\241lido</span>\n                      </>\n                    )}\n                  </span>\n                )}\n              </div>\n              <input\n                type=\"text\"\n                maxLength={9}\n                value={formData.nif}\n                onChange={(e) => setFormData({ ...formData, nif: e.target.value.replace(/\\D/g, \'\') })}\n                placeholder=\"123456789\"\n                className={`w-full px-4 py-2.5 rounded-xl border font-mono text-sm focus:outline-hidden ${\n                  formData.nif.length === 9 && !isNifValid\n                    ? \'border-red-400 bg-red-50/30\'\n                    : \'border-slate-300 focus:border-red-500\'\n                }`}\n                required\n              />\n            </div>\n\n            {/* Phone (Portuguese 91/92/93/96) */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Telem\303\263vel (9 d\303\255gitos, 91/92/93/96) *\n              </label>\n              <div className=\"relative\">\n                <Phone className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  maxLength={9}\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value.replace(/\\D/g, \'\') })}\n                  placeholder=\"912345678\"\n                  className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 font-mono text-sm focus:outline-hidden focus:border-red-500\"\n                  required\n                />\n              </div>\n            </div>\n\n            {/* Address */}\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Morada Completa (Rua, N\303\272mero, Andar) *\n              </label>\n              <div className=\"relative\">\n                <MapPin className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  value={formData.address}\n                  onChange={(e) => setFormData({ ...formData, address: e.target.value })}\n                  placeholder=\"Avenida da Liberdade, 120, 3\302\272 Dto\"\n                  className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n                  required\n                />\n              </div>\n            </div>\n\n            {/* Postal Code (0000-000) */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                C\303\263digo Postal (formato 0000-000) *\n              </label>\n              <input\n                type=\"text\"\n                maxLength={8}\n                value={formData.postal_code}\n                onChange={(e) => {\n                  let val = e.target.value.replace(/[^\\d-]/g, \'\');\n                  if (val.length === 4 && !val.includes(\'-\')) {\n                    val = val + \'-\';\n                  }\n                  setFormData({ ...formData, postal_code: val });\n                }}\n                placeholder=\"1250-142\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 font-mono text-sm focus:outline-hidden focus:border-red-500\"\n                required\n              />\n            </div>\n\n            {/* City */}\n            <div>\n              <label className=\"block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5\">\n                Localidade *\n              </label>\n              <input\n                type=\"text\"\n                value={formData.city}\n                onChange={(e) => setFormData({ ...formData, city: e.target.value })}\n                placeholder=\"Lisboa\"\n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-hidden focus:border-red-500\"\n                required\n              />\n            </div>\n\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-100 flex items-center justify-end\">\n            <button\n              type=\"submit\"\n              disabled={saving}\n              className=\"px-8 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm shadow-md shadow-red-200 transition-all flex items-center gap-2\"\n            >\n              {saving ? (\n                <>\n                  <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                  <span>A guardar altera\303\247\303\265es...</span>\n                </>\n              ) : (\n                <>\n                  <Save className=\"w-4 h-4\" />\n                  <span>Guardar Altera\303\247\303\265es do Perfil</span>\n                </>\n              )}\n            </button>\n          </div>\n\n        </form>\n      </div>\n\n    </div>\n  );\n};\n"
    num_lines: 319
    num_bytes: 12653
    line_range_bytes: 12653
  }
}
